#!/usr/bin/env bash
set -euo pipefail

module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../tools/status-report" && pwd)"
args=("$@")
if [[ ${args[0]:-} == validate || ${args[0]:-} == render ]]; then
	for ((i = 1; i < ${#args[@]}; i++)); do
		if [[ ${args[i]} == --session-dir ]]; then
			((i += 1))
			if ((i < ${#args[@]})) && [[ ${args[i]} != /* ]]; then
				args[i]="$PWD/${args[i]}"
			fi
		elif [[ ${args[i]} != -* && ${args[i]} != /* ]]; then
			args[i]="$PWD/${args[i]}"
		fi
	done
fi
cd "$module_dir"
exec go run . "${args[@]}"
