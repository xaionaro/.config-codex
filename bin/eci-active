#!/usr/bin/env bash
# Manage the ECI active marker for the current Codex session.

set -euo pipefail

base_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$base_dir/hooks/lib/codex-proof-state.sh"

usage() {
  cat >&2 <<'EOF'
Usage:
  eci-active on "<task + scope>"
  eci-active off <disengage-report.md>
  eci-active wait <user-owned-wait-report.md>
  eci-active resume <new-state-fingerprint>
  eci-active ledger-append <one-line-log-entry>
  eci-active manifest-write ${TMPDIR:-/tmp}/<...>/eci-required-critics.json.source
  eci-active approve-commit <canonical-repo-root> "git commit ..."
  eci-active nested-enter <step> <iteration> [writer-session]
  eci-active nested-accept
  eci-active nested-exit
  eci-active status

Set CODEX_SESSION_ID, or CODEX_THREAD_ID when CODEX_SESSION_ID is
unset, to target a session. Without either, the newest real session
directory under the proof root is used. Cwd-scoped ECI state is never
created.
EOF
}

validate_proof_root() {
  local root="$1"
  local parent

  case "$root" in
    /*) ;;
    *) echo "ECI proof root must be an absolute path: $root" >&2; return 1 ;;
  esac
  [ "$root" = "$(codex_proof_root)" ] || {
    echo "ECI proof root does not match the configured root: $root" >&2
    return 1
  }
  parent="$(dirname -- "$root")"
  if [ -L "$root" ] || {
    { [ -e "$parent" ] || [ -L "$parent" ]; } && [ ! -d "$parent" ];
  }; then
    echo "ECI proof root or its parent is unsafe: $root" >&2
    return 1
  fi
  if [ -e "$root" ] && [ ! -d "$root" ]; then
    echo "ECI proof root is not a directory: $root" >&2
    return 1
  fi
  codex_proof_root_is_safe || {
    echo "ECI proof root is unsafe: $root" >&2
    return 1
  }
}

validate_session_dir() {
  local root="$1"
  local session_id="$2"
  local session_dir="$root/$session_id"

  validate_proof_root "$root" || return 1
  [ -d "$root" ] || return 0
  codex_session_dir_is_safe "$root" "$session_id" || {
    echo "ECI session directory is a symlink; refusing to use it: $session_dir" >&2
    return 1
  }
  [ ! -e "$session_dir" ] || [ -d "$session_dir" ] || {
    echo "ECI session directory is not a directory: $session_dir" >&2
    return 1
  }
}

acquire_eci_mutation_lock() {
  local root lock_path

  root="$(codex_proof_root)"
  codex_proof_root_is_safe || {
    echo "ECI proof root is unsafe; refusing state mutation." >&2
    return 1
  }
  [ -d "$root" ] || {
    echo "ECI proof root is unavailable; refusing state mutation." >&2
    return 1
  }
  lock_path="$(codex_eci_lock_path 2>/dev/null || true)"
  [ -n "$lock_path" ] || return 1
  if [ -L "$lock_path" ] || { [ -e "$lock_path" ] && [ ! -f "$lock_path" ]; }; then
    echo "ECI mutation lock is unsafe: $lock_path" >&2
    return 1
  fi
  if ! exec {eci_lock_fd}>>"$lock_path"; then
    echo "ECI mutation lock is unavailable: $lock_path" >&2
    return 1
  fi
  if ! flock -n "$eci_lock_fd" 2>/dev/null; then
    eval "exec ${eci_lock_fd}>&-" 2>/dev/null || true
    echo "ECI mutation lock is busy; refusing state mutation: $lock_path" >&2
    return 1
  fi
  trap 'flock -u "$eci_lock_fd" 2>/dev/null || true; eval "exec ${eci_lock_fd}>&-"' EXIT
}

run_eci_review_gate() {
  local phase="$1"
  local session_id="$2"
  local gate_status

  # Pass the actual lock FD, never a caller-controlled boolean receipt.  The
  # gate verifies that FD 9 resolves to the canonical lock and is held.
  if [ -n "${eci_lock_fd:-}" ]; then
    eval "exec 9>&$eci_lock_fd"
    if ECI_REVIEW_GATE_FD=9 ECI_REVIEW_CWD="$PWD" \
      "$base_dir/hooks/eci-review-gate.sh" "$phase" "$session_id"; then
      gate_status=0
    else
      gate_status=$?
    fi
    eval 'exec 9>&-'
    return "$gate_status"
  else
    if ECI_REVIEW_CWD="$PWD" "$base_dir/hooks/eci-review-gate.sh" "$phase" "$session_id"; then
      return 0
    else
      return $?
    fi
  fi
}

resolve_session_dir() {
  local root name newest="" newest_mtime=0 d mtime session_id session_var
  local reject_reserved="${1:-false}"
  root="$(codex_proof_root)"
  validate_proof_root "$root" || return 1

  if [ -n "${CODEX_SESSION_ID:-}" ]; then
    session_id="$CODEX_SESSION_ID"
    session_var="CODEX_SESSION_ID"
  elif [ -n "${CODEX_THREAD_ID:-}" ]; then
    session_id="$CODEX_THREAD_ID"
    session_var="CODEX_THREAD_ID"
  fi

  if [ -n "${session_id:-}" ]; then
    codex_valid_session_id "$session_id" || {
      echo "Invalid $session_var; use only letters, digits, '_' or '-'." >&2
      exit 1
    }
    if [ "$reject_reserved" = true ] && codex_reserved_proof_dir "$session_id"; then
      echo "Reserved $session_var cannot be activated: $session_id" >&2
      exit 1
    fi
    validate_session_dir "$root" "$session_id" || return 1
    printf '%s/%s\n' "$root" "$session_id"
    return
  fi

  [ -d "$root" ] || return 1
  shopt -s nullglob
  for d in "$root"/*/; do
    d="${d%/}"
    [ -L "$d" ] && continue
    [ -d "$d" ] || continue
    name="${d##*/}"
    codex_valid_session_id "$name" || continue
    codex_reserved_proof_dir "$name" && continue
    mtime=$(stat -c '%Y' "$d" 2>/dev/null) || continue
    if [ "$mtime" -gt "$newest_mtime" ]; then
      newest_mtime="$mtime"
      newest="$d"
    fi
  done
  shopt -u nullglob
  [ -n "$newest" ] || return 1
  printf '%s\n' "$newest"
}

validate_disengage_report() {
  local report="$1"
  local missing=""
  local marker_error=""
  local section

  for section in "Stop checklist walkthrough" "Incomplete compliance"; do
    if ! codex_markdown_section_has_body "$report" "$section"; then
      missing="$missing \"$section\""
    fi
  done

  if [ -n "$missing" ]; then
    echo "Disengage report missing non-empty ECI section(s):$missing" >&2
    return 1
  fi

  marker_error="$(codex_eci_terminal_verdict_error "Disengage report" "$report")"
  if [ -n "$marker_error" ]; then
    echo "$marker_error" >&2
    return 1
  fi

  if codex_markdown_section_has_body "$report" "ECI completion certificate"; then
    return 0
  fi

  local full_missing=""
  for section in \
    "Summary" \
    "Verification" \
    "Requirements" \
    "Root Cause" \
    "Claim Inventory" \
    "Pre-Mortem" \
    "Adversarial Critique" \
    "Rule-Compliance Self-Audit" \
    "Gaps"; do
    if ! codex_markdown_section_has_body "$report" "$section"; then
      full_missing="$full_missing \"$section\""
    fi
  done

  if [ -n "$full_missing" ]; then
    echo "Disengage report must include either a non-empty \"ECI completion certificate\" section or all full Codex stop-verification sections." >&2
    echo "Missing full stop-verification section(s):$full_missing" >&2
    return 1
  fi
}

# Explicit user closure is a separate terminal route.  It records an
# incomplete/unclean teardown and therefore does not claim critic acceptance,
# a clean tree, a commit, or a clean-pass receipt.
validate_user_closed_report() {
  local report="$1" session_id="$2" expected_cwd="$3"
  local root session_dir report_path report_bytes line key value
  local schema="" owner="" report_session="" report_cwd="" bound_path="" reason="" state="" user_closed_count=0
  local -a lines=()

  root="$(codex_proof_root)"
  codex_valid_session_id "$session_id" || return 1
  codex_proof_root_is_safe || return 1
  session_dir="$root/$session_id"
  codex_session_dir_is_safe "$root" "$session_id" || return 1
  report_path="$(realpath -m -- "$report" 2>/dev/null || true)"
  codex_eci_teardown_report_path_is_safe "$report_path" || return 1
  case "$report_path" in
    "$session_dir"/*) ;;
    *) return 1 ;;
  esac
  report_bytes="$(wc -c <"$report_path" 2>/dev/null || true)"
  case "$report_bytes" in ''|*[!0-9]*) return 1 ;; esac
  [ "$report_bytes" -le 8192 ] || return 1
  [ "$(tail -c 1 -- "$report_path" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')" = 0a ] || return 1
  LC_ALL=C grep -q $'\r' "$report_path" 2>/dev/null && return 1 || true
  mapfile -t lines <"$report_path" || return 1
  [ "${#lines[@]}" -eq 8 ] || return 1

  for line in "${lines[@]}"; do
    [[ "$line" != *[[:cntrl:]]* ]] || return 1
    case "$line" in
      'schema: '*) [ -z "$schema" ] || return 1; schema="${line#schema: }" ;;
      'owner: '*) [ -z "$owner" ] || return 1; owner="${line#owner: }" ;;
      'session_id: '*) [ -z "$report_session" ] || return 1; report_session="${line#session_id: }" ;;
      'cwd: '*) [ -z "$report_cwd" ] || return 1; report_cwd="${line#cwd: }" ;;
      'report_path: '*) [ -z "$bound_path" ] || return 1; bound_path="${line#report_path: }" ;;
      'reason: '*) [ -z "$reason" ] || return 1; reason="${line#reason: }" ;;
      'state: '*) [ -z "$state" ] || return 1; state="${line#state: }" ;;
      'user-closed: true') user_closed_count=$((user_closed_count + 1)) ;;
      *) return 1 ;;
    esac
  done
  [ "$schema" = 'eci-user-closed/v1' ] || return 1
  [ "$owner" = coordinator ] || return 1
  [ "$report_session" = "$session_id" ] || return 1
  [ "$report_cwd" = "$expected_cwd" ] || return 1
  [ "$report_cwd" = "$(codex_canonical_cwd "$report_cwd")" ] || return 1
  [ "$bound_path" = "$report_path" ] || return 1
  [ "$user_closed_count" -eq 1 ] || return 1
  [ "$state" = incomplete ] || [ "$state" = unclean ] || return 1
  [ -n "$reason" ] && [ "${#reason}" -le 1024 ] || return 1
  case "${reason,,}" in *incomplete*|*unclean*) ;; *) return 1 ;; esac
  return 0
}

write_user_closed_ledger() {
  local session_dir="$1" report="$2" expected_cwd="$3"
  local ledger ledger_tmp report_path report_sha

  report_path="$(realpath -m -- "$report" 2>/dev/null || true)"
  report_sha="$(sha256sum -- "$report_path" 2>/dev/null | awk '{print $1}')"
  [[ "$report_sha" =~ ^[0-9a-f]{64}$ ]] || return 1
  ledger="$session_dir/eci-user-closed.ledger"
  if [ -e "$ledger" ] || [ -L "$ledger" ]; then
    [ -f "$ledger" ] && [ ! -L "$ledger" ] || return 1
    grep -Fqx 'schema: eci-user-closed-ledger/v1' "$ledger" || return 1
    grep -Fqx "session_id: ${session_dir##*/}" "$ledger" || return 1
    grep -Fqx 'owner: coordinator' "$ledger" || return 1
    grep -Fqx "cwd: $expected_cwd" "$ledger" || return 1
    grep -Fqx "report_path: $report_path" "$ledger" || return 1
    grep -Fqx "report_sha256: $report_sha" "$ledger" || return 1
    grep -Fqx 'user-closed: true' "$ledger" || return 1
    grep -Fqx 'state: incomplete' "$ledger" || grep -Fqx 'state: unclean' "$ledger" || return 1
    return 0
  fi
  ledger_tmp="$ledger.tmp.$$"
  [ ! -e "$ledger_tmp" ] && [ ! -L "$ledger_tmp" ] || return 1
  if ! (set -C; {
    printf 'schema: eci-user-closed-ledger/v1\n'
    printf 'session_id: %s\n' "${session_dir##*/}"
    printf 'owner: coordinator\n'
    printf 'cwd: %s\n' "$expected_cwd"
    printf 'report_path: %s\n' "$report_path"
    printf 'report_sha256: %s\n' "$report_sha"
    printf 'user-closed: true\n'
    printf 'state: incomplete\n'
  } >"$ledger_tmp"); then
    rm -f -- "$ledger_tmp"
    return 1
  fi
  if ! (set -C; ln -- "$ledger_tmp" "$ledger") 2>/dev/null; then
    rm -f -- "$ledger_tmp"
    return 1
  fi
  rm -f -- "$ledger_tmp"
  [ -f "$ledger" ] && [ ! -L "$ledger" ] && [ "$(tail -c 1 -- "$ledger" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')" = 0a ]
}

write_teardown_receipt() {
  local session_dir="$1" report="$2"
  local manifest receipt report_path manifest_sha report_sha repo_binding receipt_tmp

  manifest="$session_dir/eci-required-critics.json"
  receipt="$session_dir/eci-teardown-complete"
  [ -f "$manifest" ] && [ ! -L "$manifest" ] || return 1
  report_path="$(realpath -m -- "$report" 2>/dev/null || true)"
  [ -n "$report_path" ] || return 1
  codex_eci_teardown_report_path_is_safe "$report_path" || return 1
  manifest_sha="$(sha256sum -- "$manifest" 2>/dev/null | awk '{print $1}')"
  report_sha="$(sha256sum -- "$report_path" 2>/dev/null | awk '{print $1}')"
  repo_binding="$(codex_eci_live_repo_binding_sha256 "$manifest" 2>/dev/null || true)"
  [[ "$manifest_sha" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$report_sha" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$repo_binding" =~ ^[0-9a-f]{64}$ ]] || return 1

  if [ -e "$receipt" ] || [ -L "$receipt" ]; then
    [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
    codex_eci_teardown_receipt_is_valid "$receipt" "${session_dir##*/}" "$manifest" \
      "$report_path" "$report_sha" "$repo_binding" || return 1
    return 0
  fi

  receipt_tmp="$receipt.tmp.$$"
  [ ! -e "$receipt_tmp" ] && [ ! -L "$receipt_tmp" ] || return 1
  if ! (set -C; {
    printf 'schema: eci-teardown-complete/v1\n'
    printf 'session_id: %s\n' "${session_dir##*/}"
    printf 'manifest_sha256: %s\n' "$manifest_sha"
    printf 'disengage_report_path: %s\n' "$report_path"
    printf 'disengage_report_sha256: %s\n' "$report_sha"
    printf 'repo_binding_sha256: %s\n' "$repo_binding"
    printf 'state: complete\n'
  } >"$receipt_tmp"); then
    rm -f -- "$receipt_tmp"
    return 1
  fi
  if ! (set -C; ln -- "$receipt_tmp" "$receipt") 2>/dev/null; then
    rm -f -- "$receipt_tmp"
    return 1
  fi
  rm -f -- "$receipt_tmp"
  codex_eci_teardown_receipt_is_valid "$receipt" "${session_dir##*/}" "$manifest" \
    "$report_path" "$report_sha" "$repo_binding"
}

remove_legacy_eci_markers_for_cwd() {
  local keep="${1:-}"
  local marker

  while IFS= read -r marker; do
    [ -n "$marker" ] || continue
    [ -n "$keep" ] && [ "$marker" = "$keep" ] && continue
    rm -f "$marker"
  done < <(codex_legacy_eci_markers_for_cwd "$PWD" 2>/dev/null || true)
}

scope_has_control_bytes() {
  local scope="$1"

  # grep is line-oriented, so check LF in the shell value first; do not use
  # command substitution here because it strips trailing newlines.  The
  # byte-class check covers the remaining C0 controls and DEL.
  case "$scope" in
    *$'\n'*) return 0 ;;
  esac
  LC_ALL=C printf '%s' "$scope" | LC_ALL=C grep -q '[[:cntrl:]]'
}

wait_text_is_safe() {
  local value="${1:-}"

  [ -n "$value" ] || return 1
  if LC_ALL=C printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    return 1
  fi
  return 0
}

ledger_log_name='high_level_log.md'
ledger_anchor_name='high_level_log.anchor'
ledger_max_bytes=1048576
ledger_entry_max_bytes=8192

ledger_sha256() {
  local path="$1"
  sha256sum -- "$path" 2>/dev/null | awk '{print $1}'
}

ledger_bytes() {
  wc -c <"$1" 2>/dev/null
}

ledger_path_is_safe() {
  local session_dir="$1" path="$session_dir/$ledger_log_name"
  [ -d "$session_dir" ] && [ ! -L "$session_dir" ] || return 1
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
  [ "$(realpath -m -- "$path" 2>/dev/null || true)" = "$path" ] || return 1
  return 0
}

ledger_write_anchor() {
  local session_dir="$1" log="$session_dir/$ledger_log_name"
  local replace="${2:-false}"
  local anchor="$session_dir/$ledger_anchor_name"
  local tmp="$anchor.tmp.$$"
  local bytes hash

  ledger_path_is_safe "$session_dir" || return 1
  if [ "$replace" = true ]; then
    [ -f "$anchor" ] && [ ! -L "$anchor" ] || return 1
  else
    [ ! -e "$anchor" ] && [ ! -L "$anchor" ] || return 1
  fi
  [ ! -e "$tmp" ] && [ ! -L "$tmp" ] || return 1
  bytes="$(ledger_bytes "$log")"
  hash="$(ledger_sha256 "$log")"
  [[ "$bytes" =~ ^[0-9]+$ ]] && [ "$bytes" -le "$ledger_max_bytes" ] || return 1
  [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || return 1
  if ! (set -C; {
    printf 'schema: eci-high-level-log-anchor/v1\n'
    printf 'session_id: %s\n' "${session_dir##*/}"
    printf 'log_path: %s\n' "$log"
    printf 'bytes: %s\n' "$bytes"
    printf 'sha256: %s\n' "$hash"
  } >"$tmp"); then
    rm -f -- "$tmp"
    return 1
  fi
  mv -- "$tmp" "$anchor" || { rm -f -- "$tmp"; return 1; }
  [ -f "$anchor" ] && [ ! -L "$anchor" ]
}

ledger_validate_anchor() {
  local session_dir="$1" log="$session_dir/$ledger_log_name"
  local anchor="$session_dir/$ledger_anchor_name"
  local bytes prefix_hash full_hash anchor_hash current_bytes
  local -a lines=()

  ledger_path_is_safe "$session_dir" || return 1
  [ -f "$anchor" ] && [ ! -L "$anchor" ] || return 1
  [ "$(realpath -m -- "$anchor" 2>/dev/null || true)" = "$anchor" ] || return 1
  [ "$(ledger_bytes "$anchor")" -le 4096 ] || return 1
  mapfile -t lines <"$anchor" || return 1
  [ "${#lines[@]}" -eq 5 ] || return 1
  [ "${lines[0]}" = 'schema: eci-high-level-log-anchor/v1' ] || return 1
  [ "${lines[1]}" = "session_id: ${session_dir##*/}" ] || return 1
  [ "${lines[2]}" = "log_path: $log" ] || return 1
  [[ "${lines[3]}" =~ ^bytes:\ [0-9]+$ ]] || return 1
  [[ "${lines[4]}" =~ ^sha256:\ [0-9a-f]{64}$ ]] || return 1
  bytes="${lines[3]#bytes: }"
  anchor_hash="${lines[4]#sha256: }"
  current_bytes="$(ledger_bytes "$log")"
  [[ "$current_bytes" =~ ^[0-9]+$ ]] && [ "$current_bytes" -le "$ledger_max_bytes" ] || return 1
  [ "$current_bytes" -ge "$bytes" ] || return 1
  if [ "$bytes" -eq 0 ]; then
    prefix_hash="$(printf '' | sha256sum | awk '{print $1}')"
  else
    prefix_hash="$(head -c "$bytes" -- "$log" | sha256sum | awk '{print $1}')"
  fi
  [ "$prefix_hash" = "$anchor_hash" ] || return 1
  if [ "$current_bytes" -gt "$bytes" ]; then
    # A crash after the append but before anchor publication is recoverable:
    # the old digest still proves the complete old prefix. Publish the new
    # full-file digest before accepting another append.
    ledger_write_anchor "$session_dir" true || return 1
  else
    full_hash="$(ledger_sha256 "$log")"
    [ "$full_hash" = "$anchor_hash" ] || return 1
  fi
}

validate_ledger_entry() {
  local entry="$1" bytes
  [ -n "$entry" ] || return 1
  case "$entry" in *$'\n'*|*$'\r'*) return 1 ;; esac
  if LC_ALL=C printf '%s' "$entry" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    return 1
  fi
  bytes="$(LC_ALL=C printf '%s' "$entry" | wc -c)"
  [[ "$bytes" =~ ^[0-9]+$ ]] && [ "$bytes" -le "$ledger_entry_max_bytes" ]
}

eci_wait_report_name='eci_user_owned_wait.md'
eci_wait_max_bytes=8192

wait_file_is_bounded() {
  local path="$1"
  local bytes

  bytes="$(wc -c <"$path" 2>/dev/null || true)"
  case "$bytes" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$bytes" -le "$eci_wait_max_bytes" ]
}

validate_active_marker() {
  local root="$1"
  local session_id="$2"
  local dir="$root/$session_id"
  local marker="$dir/eci_active"

  validate_session_dir "$root" "$session_id" || return 1
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  [ -f "$marker" ] && [ ! -L "$marker" ] || return 1
  codex_eci_marker_file_is_bounded "$marker" || return 1
  printf '%s\n' "$marker"
}

validate_eci_wait_report() {
  local report="$1"
  local last_byte
  local -a lines=()

  [ -n "$report" ] || return 1
  [ -f "$report" ] && [ ! -L "$report" ] || {
    echo "ECI user-owned wait report must be a regular, non-symlink file: $report" >&2
    return 1
  }
  wait_file_is_bounded "$report" || {
    echo "ECI user-owned wait report exceeds ${eci_wait_max_bytes} bytes: $report" >&2
    return 1
  }
  if ! last_byte="$(tail -c 1 -- "$report" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')"; then
    return 1
  fi
  [ "$last_byte" = "0a" ] || {
    echo "ECI user-owned wait report must end with one final LF: $report" >&2
    return 1
  }
  mapfile -t lines <"$report" || return 1
  [ "${#lines[@]}" -eq 9 ] || {
    echo "ECI user-owned wait report has a non-canonical line count: $report" >&2
    return 1
  }
  [ "${lines[0]}" = "# ECI User-Owned Wait" ] || return 1
  [ "${lines[1]}" = "state: user-owned-wait" ] || return 1

  wait_blocker_id="${lines[2]#blocker_id: }"
  wait_state_fingerprint="${lines[3]#state_fingerprint: }"
  wait_owner="${lines[4]#owner: }"
  wait_brp_result="${lines[5]#brp_result: }"
  wait_user_owned_input="${lines[6]#user_owned_input: }"
  wait_unblock_kind="${lines[7]#unblock_kind: }"
  wait_unblock="${lines[8]#unblock: }"
  [[ "${lines[2]}" == blocker_id:\ * ]] || return 1
  [[ "${lines[3]}" == state_fingerprint:\ * ]] || return 1
  [[ "${lines[4]}" == owner:\ * ]] || return 1
  [[ "${lines[5]}" == brp_result:\ * ]] || return 1
  [[ "${lines[6]}" == user_owned_input:\ * ]] || return 1
  [[ "${lines[7]}" == unblock_kind:\ * ]] || return 1
  [[ "${lines[8]}" == unblock:\ * ]] || return 1
  [[ "$wait_blocker_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  [[ "$wait_state_fingerprint" =~ ^[0-9a-f]{64}$ ]] || return 1
  [ "$wait_owner" = user ] || return 1
  [ "$wait_brp_result" = exhausted-no-feasible-internal-path ] || return 1
  [ "$wait_user_owned_input" = unobtainable ] || return 1
  case "$wait_unblock_kind" in
    input|resource|decision) ;;
    *) return 1 ;;
  esac
  wait_text_is_safe "$wait_unblock" || return 1
  command -v sha256sum >/dev/null 2>&1 || {
    echo "sha256sum is required to validate the ECI user-owned wait report." >&2
    return 1
  }
  wait_report_sha256="$(sha256sum -- "$report" | awk '{print $1}')" || return 1
  [[ "$wait_report_sha256" =~ ^[0-9a-f]{64}$ ]] || return 1
}

validate_eci_wait_state() {
  local state="$1"
  local last_byte
  local -a lines=()

  [ -f "$state" ] && [ ! -L "$state" ] || return 1
  wait_file_is_bounded "$state" || return 1
  if ! last_byte="$(tail -c 1 -- "$state" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')"; then
    return 1
  fi
  [ "$last_byte" = "0a" ] || return 1
  mapfile -t lines <"$state" || return 1
  [ "${#lines[@]}" -eq 9 ] || return 1
  [ "${lines[0]}" = "state: user-owned-wait" ] || return 1
  wait_blocker_id="${lines[1]#blocker_id: }"
  wait_state_fingerprint="${lines[2]#state_fingerprint: }"
  wait_owner="${lines[3]#owner: }"
  wait_brp_result="${lines[4]#brp_result: }"
  wait_user_owned_input="${lines[5]#user_owned_input: }"
  wait_unblock_kind="${lines[6]#unblock_kind: }"
  wait_unblock="${lines[7]#unblock: }"
  wait_report_sha256="${lines[8]#report_sha256: }"
  [[ "${lines[1]}" == blocker_id:\ * ]] || return 1
  [[ "${lines[2]}" == state_fingerprint:\ * ]] || return 1
  [[ "${lines[3]}" == owner:\ * ]] || return 1
  [[ "${lines[4]}" == brp_result:\ * ]] || return 1
  [[ "${lines[5]}" == user_owned_input:\ * ]] || return 1
  [[ "${lines[6]}" == unblock_kind:\ * ]] || return 1
  [[ "${lines[7]}" == unblock:\ * ]] || return 1
  [[ "${lines[8]}" == report_sha256:\ * ]] || return 1
  [[ "$wait_blocker_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  [[ "$wait_state_fingerprint" =~ ^[0-9a-f]{64}$ ]] || return 1
  [ "$wait_owner" = user ] || return 1
  [ "$wait_brp_result" = exhausted-no-feasible-internal-path ] || return 1
  [ "$wait_user_owned_input" = unobtainable ] || return 1
  case "$wait_unblock_kind" in
    input|resource|decision) ;;
    *) return 1 ;;
  esac
  wait_text_is_safe "$wait_unblock" || return 1
  [ -n "$wait_unblock" ] || return 1
  [[ "$wait_report_sha256" =~ ^[0-9a-f]{64}$ ]] || return 1
}

validate_eci_wait_state_report_binding() {
  local state="$1"
  local report="$2"
  local state_blocker_id state_fingerprint state_unblock_kind state_unblock state_report_sha256

  validate_eci_wait_state "$state" || return 1
  state_blocker_id="$wait_blocker_id"
  state_fingerprint="$wait_state_fingerprint"
  state_unblock_kind="$wait_unblock_kind"
  state_unblock="$wait_unblock"
  state_report_sha256="$wait_report_sha256"
  validate_eci_wait_report "$report" || return 1
  [ "$state_blocker_id" = "$wait_blocker_id" ] &&
    [ "$state_fingerprint" = "$wait_state_fingerprint" ] &&
    [ "$state_unblock_kind" = "$wait_unblock_kind" ] &&
    [ "$state_unblock" = "$wait_unblock" ] &&
    [ "$state_report_sha256" = "$wait_report_sha256" ] || return 1
  validated_wait_state_fingerprint="$state_fingerprint"
}

write_eci_wait_state() {
  local state="$1"
  local tmp="${state}.tmp.$$"

  if [ -e "$state" ] || [ -L "$state" ]; then
    echo "ECI user-owned wait state already exists or is unsafe: $state" >&2
    return 1
  fi
  [ ! -e "$tmp" ] && [ ! -L "$tmp" ] || {
    echo "ECI temporary wait state already exists or is unsafe: $tmp" >&2
    return 1
  }
  if ! (
    set -C
    {
      printf 'state: user-owned-wait\n'
      printf 'blocker_id: %s\n' "$wait_blocker_id"
      printf 'state_fingerprint: %s\n' "$wait_state_fingerprint"
      printf 'owner: user\n'
      printf 'brp_result: exhausted-no-feasible-internal-path\n'
      printf 'user_owned_input: unobtainable\n'
      printf 'unblock_kind: %s\n' "$wait_unblock_kind"
      printf 'unblock: %s\n' "$wait_unblock"
      printf 'report_sha256: %s\n' "$wait_report_sha256"
    } >"$tmp"
  ); then
    rm -f -- "$tmp"
    echo "ECI user-owned wait state could not be created: $state" >&2
    return 1
  fi
  if ! ln -- "$tmp" "$state" 2>/dev/null; then
    rm -f -- "$tmp"
    echo "ECI user-owned wait state could not be created: $state" >&2
    return 1
  fi
  rm -f -- "$tmp"
  [ -f "$state" ] && [ ! -L "$state" ] || return 1
}

write_nested_marker() {
  local marker="$1" outer_sid="$2" step="$3" iteration="$4" writer="$5" version="$6"
  local tmp="${marker}.tmp.$$"
  [ ! -e "$marker" ] && [ ! -L "$marker" ] || return 1
  [ ! -e "$tmp" ] && [ ! -L "$tmp" ] || return 1
  {
    printf 'outer_session_id: %s\n' "$outer_sid"
    printf 'outer_marker: %s/eci_active\n' "${marker%/*}"
    printf 'owner: ate\n'
    printf 'writer_session_id: %s\n' "$writer"
    printf 'acceptance_version: %s\n' "$version"
    printf 'step: %s\n' "$step"
    printf 'iteration: %s\n' "$iteration"
    printf 'state: active\n'
  } >"$tmp" || return 1
  codex_eci_marker_file_is_bounded "$tmp" || { rm -f -- "$tmp"; return 1; }
  (set -C; ln -- "$tmp" "$marker") 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  rm -f -- "$tmp"
  [ -f "$marker" ] && [ ! -L "$marker" ]
}

validate_nested_marker() {
  local marker="$1" root outer_sid writer outer_marker outer_marker_path version step iteration state
  local -a lines=()
  root="$(codex_proof_root)"
  [ -f "$marker" ] && [ ! -L "$marker" ] || return 1
  [ "$(wc -c <"$marker" 2>/dev/null || printf 0)" -le 4096 ] || return 1
  [ "$(tail -c 1 -- "$marker" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')" = 0a ] || return 1
  LC_ALL=C grep -q $'\r' "$marker" 2>/dev/null && return 1 || true
  mapfile -t lines <"$marker" || return 1
  [ "${#lines[@]}" -eq 8 ] || return 1
  [[ "${lines[0]}" == outer_session_id:\ * ]] || return 1
  [[ "${lines[1]}" == outer_marker:\ * ]] || return 1
  [[ "${lines[2]}" == owner:\ * ]] || return 1
  [[ "${lines[3]}" == writer_session_id:\ * ]] || return 1
  [[ "${lines[4]}" == acceptance_version:\ * ]] || return 1
  [[ "${lines[5]}" == step:\ * ]] || return 1
  [[ "${lines[6]}" == iteration:\ * ]] || return 1
  [[ "${lines[7]}" == state:\ * ]] || return 1
  outer_sid="${lines[0]#outer_session_id: }"
  outer_marker="${lines[1]#outer_marker: }"
  writer="${lines[3]#writer_session_id: }"
  version="${lines[4]#acceptance_version: }"
  step="${lines[5]#step: }"
  iteration="${lines[6]#iteration: }"
  state="${lines[7]#state: }"
  codex_valid_session_id "$outer_sid" || return 1
  codex_valid_session_id "$writer" || return 1
  [ "$outer_sid" = "${session_dir##*/}" ] || return 1
  [ "$outer_marker" = "$session_dir/eci_active" ] || return 1
  [ "$marker" = "$session_dir/ate_nested_eci_active" ] || return 1
  nested_number_is_bounded "$version" false || return 1
  nested_number_is_bounded "$step" true && nested_number_is_bounded "$iteration" true || return 1
  [ "$state" = active ] || return 1
  outer_marker_path="$(validate_active_marker "$root" "$outer_sid" 2>/dev/null || true)"
  [ "$outer_marker_path" = "$outer_marker" ] || return 1
  codex_eci_marker_path_owner_is_valid "$outer_marker_path" || return 1
  codex_eci_marker_is_valid_for_cwd "$outer_marker_path" "$(codex_canonical_cwd "$PWD")" || return 1
  validate_session_dir "$root" "$writer" || return 1
  [ -d "$root/$writer" ] && [ ! -L "$root/$writer" ] || return 1
}

validate_nested_completion() {
  local receipt="$1" marker="$2" marker_version marker_line outer_sid nested_marker version step iteration state
  local -a lines=()
  [ "$receipt" = "$session_dir/ate_nested_eci_completion" ] || return 1
  [ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
  [ "$(wc -c <"$receipt" 2>/dev/null || printf 0)" -le 2048 ] || return 1
  [ "$(tail -c 1 -- "$receipt" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')" = 0a ] || return 1
  LC_ALL=C grep -q $'\r' "$receipt" 2>/dev/null && return 1 || true
  mapfile -t lines <"$receipt" || return 1
  [ "${#lines[@]}" -eq 6 ] || return 1
  [[ "${lines[0]}" == outer_session_id:\ * ]] || return 1
  [[ "${lines[1]}" == nested_marker:\ * ]] || return 1
  [[ "${lines[2]}" == acceptance_version:\ * ]] || return 1
  [[ "${lines[3]}" == step:\ * ]] || return 1
  [[ "${lines[4]}" == iteration:\ * ]] || return 1
  [[ "${lines[5]}" == state:\ * ]] || return 1
  outer_sid="${lines[0]#outer_session_id: }"
  nested_marker="${lines[1]#nested_marker: }"
  version="${lines[2]#acceptance_version: }"
  step="${lines[3]#step: }"
  iteration="${lines[4]#iteration: }"
  state="${lines[5]#state: }"
  codex_valid_session_id "$outer_sid" || return 1
  [ "$outer_sid" = "${session_dir##*/}" ] || return 1
  [ "$nested_marker" = "$marker" ] || return 1
  nested_number_is_bounded "$version" false || return 1
  nested_number_is_bounded "$step" true && nested_number_is_bounded "$iteration" true || return 1
  [ "$state" = accepted ] || return 1
  marker_line="$(sed -n '5p' "$marker" 2>/dev/null || true)"
  marker_version="${marker_line#acceptance_version: }"
  [ "$version" = "$marker_version" ] || return 1
  [ "$(sed -n '6p' "$marker" 2>/dev/null || true)" = "step: $step" ] || return 1
  [ "$(sed -n '7p' "$marker" 2>/dev/null || true)" = "iteration: $iteration" ] || return 1
}

write_nested_completion() {
  local marker="$1" receipt="$2" outer_sid version step iteration tmp
  local -a lines=()

  validate_nested_marker "$marker" || return 1
  [ "$receipt" = "$session_dir/ate_nested_eci_completion" ] || return 1
  [ ! -e "$receipt" ] && [ ! -L "$receipt" ] || return 1
  tmp="${receipt}.tmp.$$"
  [ ! -e "$tmp" ] && [ ! -L "$tmp" ] || return 1
  codex_eci_marker_file_is_bounded "$marker" || return 1
  mapfile -t lines <"$marker" || return 1
  outer_sid="${lines[0]#outer_session_id: }"
  version="${lines[4]#acceptance_version: }"
  step="${lines[5]#step: }"
  iteration="${lines[6]#iteration: }"
  if ! (set -C; {
    printf 'outer_session_id: %s\n' "$outer_sid"
    printf 'nested_marker: %s\n' "$marker"
    printf 'acceptance_version: %s\n' "$version"
    printf 'step: %s\n' "$step"
    printf 'iteration: %s\n' "$iteration"
    printf 'state: accepted\n'
  } >"$tmp"); then
    rm -f -- "$tmp"
    return 1
  fi
  codex_eci_marker_file_is_bounded "$tmp" || { rm -f -- "$tmp"; return 1; }
  if ! (set -C; ln -- "$tmp" "$receipt") 2>/dev/null; then
    rm -f -- "$tmp"
    return 1
  fi
  rm -f -- "$tmp"
  validate_nested_completion "$receipt" "$marker"
}

require_main_lifecycle_owner() {
  # An unset role is the ordinary main CLI.  Explicit worker roles cannot
  # publish or clear the outer coordinator's nested acceptance state.
  case "${CODEX_ROLE:-}" in
    ""|main|orchestrator|lead|coordinator) ;;
    *) echo 'Only the main/orchestrator may publish or clear ECI lifecycle state.' >&2; exit 1 ;;
  esac
}

require_main_nested_owner() {
  require_main_lifecycle_owner
}

require_main_approval_owner() {
  case "${CODEX_ROLE:-}" in
    ""|main|orchestrator|lead|coordinator) ;;
    *)
      echo 'ECI_APPROVE_COMMIT_OWNER_DENIED: worker/subagent context cannot create a Git approval artifact; route approval through the main/orchestrator.' >&2
      exit 1
      ;;
  esac
  case "${CODEX_HOOK_IS_SUBAGENT:-false}" in
    true)
      echo 'ECI_APPROVE_COMMIT_OWNER_DENIED: worker/subagent context cannot create a Git approval artifact; route approval through the main/orchestrator.' >&2
      exit 1
      ;;
  esac
}

approval_git_safe() {
  codex_git_safe "$@"
}

approval_git_repo_context() {
  local requested="$1" actual git_dir_raw git_dir
  case "$requested" in
    /*) ;;
    *) echo "repo_root must be an absolute canonical path: $requested" >&2; return 1 ;;
  esac
  [ "$requested" = "$(realpath -m -- "$requested" 2>/dev/null || true)" ] || {
    echo "repo_root is not canonically spelled: $requested" >&2
    return 1
  }
  [ -d "$requested" ] && [ ! -L "$requested" ] || {
    echo "repo_root must be an existing non-symlink directory: $requested" >&2
    return 1
  }
  [ "$(realpath -e -- "$requested" 2>/dev/null || true)" = "$requested" ] || {
    echo "repo_root must resolve to itself without symlink aliases: $requested" >&2
    return 1
  }
  actual="$(approval_git_safe -C "$requested" rev-parse --show-toplevel 2>/dev/null || true)"
  actual="$(realpath -e -- "$actual" 2>/dev/null || true)"
  [ -n "$actual" ] && [ "$actual" = "$requested" ] || {
    echo "repo_root is not the canonical top-level of a Git worktree: $requested" >&2
    return 1
  }
  git_dir_raw="$(approval_git_safe -C "$requested" rev-parse --git-dir 2>/dev/null || true)"
  [ -n "$git_dir_raw" ] || { echo "Git did not return a worktree git directory: $requested" >&2; return 1; }
  case "$git_dir_raw" in
    /*) git_dir="$git_dir_raw" ;;
    *) git_dir="$requested/$git_dir_raw" ;;
  esac
  git_dir="$(realpath -e -- "$git_dir" 2>/dev/null || true)"
  [ -n "$git_dir" ] && [ "$git_dir" != / ] && [ ! -L "$git_dir" ] || {
    echo "Git directory is missing, noncanonical, or unsafe for repo_root=$requested" >&2
    return 1
  }
  APPROVAL_REPO_ROOT="$requested"
  APPROVAL_GIT_DIR="$git_dir"
}

validate_approval_commit_command() {
  python3 - "$1" <<'PY'
import re
import shlex
import sys

command = sys.argv[1]
if not command:
    print("command is empty")
    raise SystemExit(1)
if any(ord(char) < 32 or ord(char) == 127 for char in command):
    print("command contains control characters; tabs/newlines are not allowed")
    raise SystemExit(1)
quote = None
escaped = False
for index, char in enumerate(command):
    if escaped:
        escaped = False
        continue
    if char == "\\" and quote != "'":
        escaped = True
        continue
    if quote == "'":
        if char == "'":
            quote = None
        continue
    if quote == '"':
        if char == '"':
            quote = None
        elif char in ("$", "`"):
            print("shell substitution marker is not allowed inside double quotes")
            raise SystemExit(1)
        continue
    if char in ("'", '"'):
        quote = char
        continue
    if char in (";", "&", "|", "(", ")", "<", ">", "`", "$"):
        print("shell operator or substitution marker is not allowed")
        raise SystemExit(1)
if quote is not None or escaped:
    print("shell quoting is unbalanced")
    raise SystemExit(1)
if not re.match(r"^git\s+commit(?:\s|$)", command):
    print("expected a direct literal 'git commit' invocation; wrappers, assignments, and alternate Git paths are not allowed")
    raise SystemExit(1)
try:
    tokens = shlex.split(command, posix=True)
except ValueError as exc:
    print("shell quoting is invalid: " + str(exc))
    raise SystemExit(1)
if len(tokens) < 2 or tokens[0] != "git" or tokens[1] != "commit":
    print("expected command tokens ['git', 'commit']")
    raise SystemExit(1)
value_options = {
    "-m", "--message", "-F", "--file", "--author", "--date", "--cleanup",
    "--trailer", "--fixup", "--squash", "--reuse-message", "-C",
    "--reedit-message", "--template", "-S", "--gpg-sign",
}
flag_options = {
    "-a", "--all", "-p", "--patch", "--no-verify", "--verify", "--signoff",
    "--amend", "--allow-empty", "--allow-empty-message", "--edit", "--no-edit",
    "--reset-author", "--only", "--include", "--no-post-rewrite", "--quiet",
    "-q", "--verbose", "-v", "--status", "--no-status",
}
index = 2
while index < len(tokens):
    token = tokens[index]
    if token == "--":
        print("pathspec arguments are outside the bounded approval grammar")
        raise SystemExit(1)
    if token in value_options:
        if index + 1 >= len(tokens) or not tokens[index + 1] or any(ord(char) < 32 or ord(char) == 127 for char in tokens[index + 1]):
            print("option %s requires one bounded printable value" % token)
            raise SystemExit(1)
        index += 2
        continue
    if any(token.startswith(option + "=") for option in value_options if option.startswith("--")):
        if token.endswith("="):
            print("option %s requires a non-empty value" % token.split("=", 1)[0])
            raise SystemExit(1)
        index += 1
        continue
    if token in flag_options:
        index += 1
        continue
    print("unsupported or unbounded commit option: %s" % token)
    raise SystemExit(1)
print("ok")
PY
}

validate_approval_artifact() {
  local path="$1" expected_command="$2" repo_root="$3" git_dir="$4"
  local reason
  local -a lines=()
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
  [ "$(realpath -m -- "$path" 2>/dev/null || true)" = "$path" ] || return 1
  [ "$(wc -c <"$path" 2>/dev/null || printf 999999)" -le 4096 ] || return 1
  mapfile -t lines <"$path" || return 1
  [ "${#lines[@]}" -eq 9 ] || return 1
  [ "${lines[0]}" = 'schema: codex-user-git-approval/v1' ] || return 1
  [ "${lines[1]}" = 'authorized_by: user' ] || return 1
  [ "${lines[2]}" = 'operation: commit' ] || return 1
  [ "${lines[3]}" = "repo_root: $repo_root" ] || return 1
  [ "${lines[4]}" = "git_dir: $git_dir" ] || return 1
  [ "${lines[5]}" = "command: $expected_command" ] || return 1
  case "${lines[6]}" in
    reason:\ *)
      reason="${lines[6]#reason: }"
      [ -n "$reason" ] && [ "${#reason}" -le 512 ] || return 1
      ;;
    *) return 1 ;;
  esac
  [[ "${lines[7]}" =~ ^approved_at:\ [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || return 1
  [ "${lines[8]}" = 'one_time: true' ] || return 1
}

write_approval_artifact() {
  local command="$1" repo_root="$2" git_dir="$3" path reason approved_at
  path="$repo_root/.git-commit-approved-once"
  [ ! -e "$path" ] && [ ! -L "$path" ] || {
    echo "approval artifact already exists and will not be overwritten: $path" >&2
    return 1
  }
  if approval_git_safe -C "$repo_root" ls-files --error-unmatch -- .git-commit-approved-once >/dev/null 2>&1; then
    echo "approval artifact path is tracked or staged and cannot be used: $path" >&2
    return 1
  fi
  reason='coordinator requested one-time direct git commit admission'
  approved_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  if ! (umask 077; set -C; {
    printf 'schema: codex-user-git-approval/v1\n'
    printf 'authorized_by: user\n'
    printf 'operation: commit\n'
    printf 'repo_root: %s\n' "$repo_root"
    printf 'git_dir: %s\n' "$git_dir"
    printf 'command: %s\n' "$command"
    printf 'reason: %s\n' "$reason"
    printf 'approved_at: %s\n' "$approved_at"
    printf 'one_time: true\n'
  } >"$path"); then
    rm -f -- "$path"
    echo "could not atomically create approval artifact: $path" >&2
    return 1
  fi
  if ! validate_approval_artifact "$path" "$command" "$repo_root" "$git_dir"; then
    rm -f -- "$path"
    echo "created approval artifact failed schema validation and was removed: $path" >&2
    return 1
  fi
  printf 'ECI commit approval artifact created for exact command: %s\n' "$path"
}

nested_number_is_bounded() {
  local value="$1" allow_zero="$2"
  if [ "$allow_zero" = true ]; then
    [[ "$value" =~ ^(0|[1-9][0-9]{0,8})$ ]]
  else
    [[ "$value" =~ ^[1-9][0-9]{0,8}$ ]]
  fi
}

manifest_temp_root() {
  local configured="${TMPDIR:-/tmp}" canonical
  case "$configured" in
    /*) ;;
    *) return 1 ;;
  esac
  case "$configured" in
    *[![:print:]]*|*//*|*/./*|*/../*|*/..|*/.) return 1 ;;
  esac
  canonical="$(realpath -m -- "$configured" 2>/dev/null || true)"
  [ -n "$canonical" ] && [ "$canonical" = "$configured" ] || return 1
  [ "$canonical" != / ] || return 1
  [ -d "$canonical" ] && [ ! -L "$canonical" ] || return 1
  printf '%s\n' "$canonical"
}

manifest_temp_source_is_safe() {
  local path="$1" temp_root canonical parent name
  case "$path" in
    /*) ;;
    *) return 1 ;;
  esac
  case "$path" in
    *[![:print:]]*|*//*|*/./*|*/../*|*/..|*/.) return 1 ;;
  esac
  canonical="$(realpath -m -- "$path" 2>/dev/null || true)"
  [ -n "$canonical" ] && [ "$canonical" = "$path" ] || return 1
  temp_root="$(manifest_temp_root 2>/dev/null || true)"
  [ -n "$temp_root" ] || return 1
  case "$path" in
    "$temp_root"/*) ;;
    *) return 1 ;;
  esac
  name="${path##*/}"
  [ "$name" = 'eci-required-critics.json.source' ] || return 1
  parent="${path%/*}"
  [ -d "$parent" ] && [ ! -L "$parent" ] || return 1
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
}

validate_manifest_for_write() {
  local path="$1" bytes last top_keys row_keys target_keys
  bytes="$(wc -c <"$path" 2>/dev/null || true)"
  case "$bytes" in ''|*[!0-9]*) return 1 ;; esac
  [ "$bytes" -le 65536 ] || return 1
  last="$(tail -c 1 -- "$path" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')"
  [ "$last" = 0a ] || return 1
  [ "$(awk 'END { print NR + 0 }' "$path" 2>/dev/null || printf 0)" -eq 1 ] || return 1
  LC_ALL=C grep -q $'\r' "$path" 2>/dev/null && return 1 || true
  jq -e . "$path" >/dev/null 2>&1 || return 1
  jq -c . "$path" | cmp -s - "$path" || return 1
  top_keys='["schema","current_target_id","current_target_kind","current_diff_artifact","current_diff_sha256","current_target_path","repo_root","git_dir","git_common_dir","base_oid","head_oid","staged_diff_sha256","worktree_diff_sha256","status_sha256","target_file_hashes","acceptance_version","targets","rows"]'
  row_keys='["target_id","target_kind","diff_artifact","diff_sha256","critic_role","gate_phase","child_identity","critic_provider","critic_semantic_role","critic_provenance","spawn_request_artifact","spawn_request_sha256","report_artifact","report_sha256","adjudication_artifact","adjudication_sha256","verdict","e2e_required","e2e_artifact","e2e_sha256","repo_root","git_dir","git_common_dir","base_oid","head_oid","staged_diff_sha256","worktree_diff_sha256","status_sha256","target_path","target_version","intention_artifact","intention_sha256","acceptance_version"]'
  target_keys='["target_id","target_kind","diff_artifact","diff_sha256","e2e_required","target_path","target_version"]'
  jq -e --argjson expected "$top_keys" --argjson rows_expected "$row_keys" --argjson targets_expected "$target_keys" '
    (keys_unsorted == $expected) and (.schema == "eci-required-critics/v2") and
    (.current_target_id | type == "string") and (.current_target_kind | type == "string") and
    (.current_diff_artifact | type == "string") and (.current_diff_sha256 | test("^[0-9a-f]{64}$")) and
    (.current_target_path | type == "string") and (.repo_root | type == "string") and
    (.git_dir | type == "string") and (.git_common_dir | type == "string") and
    (.base_oid | test("^[0-9a-f]{40,64}$")) and (.head_oid | test("^[0-9a-f]{40,64}$")) and
    (.staged_diff_sha256 | test("^[0-9a-f]{64}$")) and (.worktree_diff_sha256 | test("^[0-9a-f]{64}$")) and
    (.status_sha256 | test("^[0-9a-f]{64}$")) and (.target_file_hashes | type == "object") and
    (.acceptance_version | test("^[1-9][0-9]*$")) and (.targets | type == "array" and length > 0) and
    (.rows | type == "array" and length > 0) and
    all(.targets[]; keys_unsorted == $targets_expected and (.target_id | type == "string") and
      (.target_kind | . == "root" or . == "subtask" or . == "candidate-fix") and
      (.diff_artifact | type == "string") and (.diff_sha256 | test("^[0-9a-f]{64}$")) and
      (.e2e_required | type == "boolean") and (.target_path | type == "string") and
      (.target_version | test("^[0-9a-f]{64}$"))) and
    all(.rows[]; keys_unsorted == $rows_expected and (.target_id | type == "string") and
      (.target_kind | . == "root" or . == "subtask" or . == "candidate-fix") and
      (.diff_artifact | type == "string") and (.diff_sha256 | test("^[0-9a-f]{64}$")) and
      (.critic_role | . == "A" or . == "B" or . == "C") and
      (.gate_phase | . == "prewrite" or . == "postwrite") and (.child_identity | type == "string" and length > 0) and
      (.critic_provider | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")) and
      (.critic_semantic_role == ("ECI Critic " + .critic_role)) and
      (.critic_provenance | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9_.:/=-]{0,255}$")) and
      (.spawn_request_artifact | type == "string") and (.spawn_request_sha256 | test("^[0-9a-f]{64}$")) and
      (.report_artifact | type == "string") and (.report_sha256 | test("^[0-9a-f]{64}$")) and
      (.adjudication_artifact | type == "string") and (.adjudication_sha256 | test("^[0-9a-f]{64}$")) and
      (.verdict == "PASS") and (.e2e_required | type == "boolean") and
      (((.e2e_required and (.e2e_artifact | type == "string") and (.e2e_sha256 | test("^[0-9a-f]{64}$"))) or
        ((.e2e_required | not) and .e2e_artifact == null and .e2e_sha256 == null))) and
      (.repo_root | type == "string") and (.git_dir | type == "string") and (.git_common_dir | type == "string") and
      (.base_oid | test("^[0-9a-f]{40,64}$")) and (.head_oid | test("^[0-9a-f]{40,64}$")) and
      (.staged_diff_sha256 | test("^[0-9a-f]{64}$")) and (.worktree_diff_sha256 | test("^[0-9a-f]{64}$")) and
      (.status_sha256 | test("^[0-9a-f]{64}$")) and (.target_path | type == "string") and
      (.target_version | test("^[0-9a-f]{64}$")) and (.intention_artifact == null or (.intention_artifact | type == "string")) and
      (.intention_sha256 == null or (.intention_sha256 | test("^[0-9a-f]{64}$"))) and (.acceptance_version | test("^[1-9][0-9]*$")))
  ' "$path" >/dev/null 2>&1
}

cmd="${1:-}"
case "$cmd" in
  on)
    require_main_lifecycle_owner
    shift
    scope="${*:-}"
    scope_bytes="$(LC_ALL=C printf '%s' "$scope" | wc -c)"
    [ -n "$scope" ] || { usage; exit 2; }
    case "$scope_bytes" in
      ''|*[!0-9]*) echo 'ECI scope length could not be measured safely.' >&2; exit 1 ;;
    esac
    [ "$scope_bytes" -le "$codex_eci_marker_max_bytes" ] || {
      echo "ECI scope exceeds the ${codex_eci_marker_max_bytes}-byte marker limit." >&2
      exit 1
    }
    if scope_has_control_bytes "$scope"; then
      echo "ECI scope contains control characters; refusing to create a malformed marker." >&2
      exit 1
    fi
    session_dir="$(resolve_session_dir true)" || {
      echo "eci-active: no session directory found under $(codex_proof_root)" >&2
      exit 1
    }
    acquire_eci_mutation_lock || exit 1
    validate_session_dir "$(codex_proof_root)" "${session_dir##*/}" || exit 1
    marker="$session_dir/eci_active"
    if [ -L "$session_dir" ] || { [ -e "$session_dir" ] && [ ! -d "$session_dir" ]; }; then
      echo "ECI session directory is not a directory: $session_dir" >&2
      exit 1
    fi
    mkdir -p "$session_dir"
    [ -d "$session_dir" ] && [ ! -L "$session_dir" ] || {
      echo "ECI session directory is not a canonical directory: $session_dir" >&2
      exit 1
    }
    # Freeze the current high-level log bytes when a new ECI marker is
    # activated.  Later coordinator writes must prove this prefix and append
    # only at EOF; an unsafe pre-existing anchor fails closed.
    if [ -e "$session_dir/$ledger_anchor_name" ] || [ -L "$session_dir/$ledger_anchor_name" ]; then
      ledger_validate_anchor "$session_dir" || {
        echo "ECI high-level log anchor is unsafe or drifted: $session_dir/$ledger_anchor_name" >&2
        exit 1
      }
    elif [ -f "$session_dir/$ledger_log_name" ] && [ ! -L "$session_dir/$ledger_log_name" ]; then
      ledger_write_anchor "$session_dir" || {
        echo "ECI high-level log anchor could not be published: $session_dir/$ledger_anchor_name" >&2
        exit 1
      }
    fi
    if [ -e "$marker" ] || [ -L "$marker" ]; then
      echo "ECI marker already exists or is unsafe: $marker" >&2
      exit 1
    fi
    if [ -e "$session_dir/eci_wait" ] || [ -L "$session_dir/eci_wait" ]; then
      echo "ECI user-owned wait state already exists or is unsafe: $session_dir/eci_wait" >&2
      exit 1
    fi
    marker_tmp="$marker.tmp.$$"
    if [ -e "$marker_tmp" ] || [ -L "$marker_tmp" ]; then
      echo "ECI marker temporary path is already present or unsafe: $marker_tmp" >&2
      exit 1
    fi
    if ! (
      set -C
      {
        printf 'scope: %s\n' "$scope"
        printf 'cwd: %s\n' "$(codex_canonical_cwd "$PWD")"
        printf 'session_id: %s\n' "${session_dir##*/}"
        date -u '+created_utc: %Y-%m-%dT%H:%M:%SZ'
      } >"$marker_tmp"
    ); then
      rm -f -- "$marker_tmp"
      echo "ECI marker could not be prepared atomically: $marker" >&2
      exit 1
    fi
    if ! codex_eci_marker_file_is_bounded "$marker_tmp"; then
      rm -f -- "$marker_tmp"
      echo "ECI marker exceeds the ${codex_eci_marker_max_bytes}-byte limit: $marker" >&2
      exit 1
    fi
    if ! (set -C; ln -- "$marker_tmp" "$marker") 2>/dev/null; then
      rm -f -- "$marker_tmp"
      echo "ECI marker already exists or is unsafe: $marker" >&2
      exit 1
    fi
    rm -f -- "$marker_tmp"
    remove_legacy_eci_markers_for_cwd "$marker"
    printf 'ECI active: %s\n' "$marker"
    ;;
  wait)
    require_main_lifecycle_owner
    shift
    report="${1:-}"
    [ "$#" -eq 1 ] || { usage; exit 2; }
    session_dir="$(resolve_session_dir)" || {
      echo "eci-active: no session directory found under $(codex_proof_root)" >&2
      exit 1
    }
    acquire_eci_mutation_lock || exit 1
    marker="$(validate_active_marker "$(codex_proof_root)" "${session_dir##*/}")" || {
      echo "ECI marker is not active or is unsafe: $session_dir/eci_active" >&2
      exit 1
    }
    codex_eci_marker_path_owner_is_valid "$marker" || {
      echo "ECI wait rejected malformed marker ownership: $marker" >&2
      exit 1
    }
    codex_eci_marker_is_valid_for_cwd "$marker" "$(codex_canonical_cwd "$PWD")" || {
      echo "ECI wait rejected a marker bound to another cwd: $marker" >&2
      exit 1
    }
    expected_report="$session_dir/$eci_wait_report_name"
    [ "$report" = "$expected_report" ] || {
      echo "ECI user-owned wait report must use the current session path: $expected_report" >&2
      exit 1
    }
    validate_eci_wait_report "$report" || {
      echo "ECI user-owned wait report validation failed: $report" >&2
      exit 1
    }
    write_eci_wait_state "$session_dir/eci_wait" || exit 1
    printf 'ECI user-owned wait state armed: %s\n' "$session_dir/eci_wait"
    ;;
  resume)
    require_main_lifecycle_owner
    shift
    new_fingerprint="${1:-}"
    [ "$#" -eq 1 ] || { usage; exit 2; }
    [[ "$new_fingerprint" =~ ^[0-9a-f]{64}$ ]] || {
      echo "ECI resume fingerprint must be 64 lowercase hexadecimal characters." >&2
      exit 1
    }
    session_dir="$(resolve_session_dir)" || {
      echo "eci-active: no session directory found under $(codex_proof_root)" >&2
      exit 1
    }
    acquire_eci_mutation_lock || exit 1
    marker="$(validate_active_marker "$(codex_proof_root)" "${session_dir##*/}")" || {
      echo "ECI marker is not active or is unsafe: $session_dir/eci_active" >&2
      exit 1
    }
    codex_eci_marker_path_owner_is_valid "$marker" || {
      echo "ECI resume rejected malformed marker ownership: $marker" >&2
      exit 1
    }
    codex_eci_marker_is_valid_for_cwd "$marker" "$(codex_canonical_cwd "$PWD")" || {
      echo "ECI resume rejected a marker bound to another cwd: $marker" >&2
      exit 1
    }
    wait_state="$session_dir/eci_wait"
    [ ! -L "$wait_state" ] || {
      echo "ECI user-owned wait state is a symlink; refusing to use it: $wait_state" >&2
      exit 1
    }
    expected_report="$session_dir/$eci_wait_report_name"
    validate_eci_wait_state_report_binding "$wait_state" "$expected_report" || {
      if ! [ -f "$expected_report" ] || [ -L "$expected_report" ]; then
        echo "ECI user-owned wait report is missing or invalid: $expected_report" >&2
      else
        echo "ECI user-owned wait report does not match its state: $wait_state" >&2
      fi
      exit 1
    }
    [ "$new_fingerprint" != "$validated_wait_state_fingerprint" ] || {
      echo "ECI resume fingerprint is unchanged; provide materially changed normalized content." >&2
      exit 1
    }
    rm -f "$wait_state"
    [ ! -e "$wait_state" ] && [ ! -L "$wait_state" ] || {
      echo "ECI user-owned wait state could not be cleared: $wait_state" >&2
      exit 1
    }
    printf 'ECI user-owned wait state cleared for supplied changed fingerprint: %s\n' "$marker"
    ;;
  ledger-append)
    require_main_lifecycle_owner
    [ "$#" -eq 2 ] || { usage; exit 2; }
    entry="$2"
    validate_ledger_entry "$entry" || {
      echo 'ECI high-level log entry must be one bounded, printable line.' >&2
      exit 1
    }
    session_dir="$(resolve_session_dir)" || {
      echo 'eci-active: no current session directory found under the proof root.' >&2
      exit 1
    }
    acquire_eci_mutation_lock || exit 1
    marker="$(validate_active_marker "$(codex_proof_root)" "${session_dir##*/}")" || {
      echo 'ECI high-level log append requires an active canonical marker.' >&2
      exit 1
    }
    codex_eci_marker_path_owner_is_valid "$marker" || {
      echo 'ECI high-level log append rejected malformed marker ownership.' >&2
      exit 1
    }
    codex_eci_marker_is_valid_for_cwd "$marker" "$(codex_canonical_cwd "$PWD")" || {
      echo 'ECI high-level log append rejected a marker bound to another cwd.' >&2
      exit 1
    }
    if [ -e "$session_dir/$ledger_anchor_name" ] || [ -L "$session_dir/$ledger_anchor_name" ]; then
      ledger_validate_anchor "$session_dir" || {
        echo 'ECI high-level log append found a missing, replaced, or drifted immutable prefix.' >&2
        exit 1
      }
    else
      # Sessions activated before the anchor route existed are bootstrapped
      # once, under the same mutation lock, from their current bytes.  The
      # bytes become the immutable prefix before the requested append.
      ledger_write_anchor "$session_dir" || {
        echo 'ECI high-level log append could not establish its immutable prefix.' >&2
        exit 1
      }
    fi
    log_path="$session_dir/$ledger_log_name"
    ledger_timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ledger_timestamp_epoch="$(date -u '+%s')"
    last_log_line="$(tail -n 1 -- "$log_path" 2>/dev/null || true)"
    if [[ "$last_log_line" =~ ^##[[:space:]]([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)[[:space:]]-[[:space:]] ]]; then
      last_timestamp="${BASH_REMATCH[1]}"
      if [[ "$ledger_timestamp" < "$last_timestamp" || "$ledger_timestamp" = "$last_timestamp" ]]; then
        last_timestamp_epoch="$(date -u -d "$last_timestamp" '+%s' 2>/dev/null || true)"
        [[ "$last_timestamp_epoch" =~ ^[0-9]+$ ]] || {
          echo "ECI high-level log append could not parse its prior UTC timestamp: $last_timestamp" >&2
          exit 1
        }
        ledger_timestamp_epoch=$((last_timestamp_epoch + 1))
        ledger_timestamp="$(date -u -d "@$ledger_timestamp_epoch" '+%Y-%m-%dT%H:%M:%SZ')"
      fi
    fi
    [[ "$ledger_timestamp" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || {
      echo "ECI high-level log append produced an invalid UTC timestamp: $ledger_timestamp" >&2
      exit 1
    }
    formatted_entry="## $ledger_timestamp - $entry"
    log_bytes_before="$(ledger_bytes "$log_path")"
    append_bytes="$(LC_ALL=C printf '%s\n' "$formatted_entry" | wc -c)"
    case "$log_bytes_before:$append_bytes" in
      ''|*[!0-9:]*)
        echo 'ECI high-level log append could not measure the existing prefix and entry safely.' >&2
        exit 1
        ;;
    esac
    [ "$log_bytes_before" -le "$ledger_max_bytes" ] || {
      echo 'ECI high-level log is already above its bounded size limit; refusing append.' >&2
      exit 1
    }
    [ "$append_bytes" -le "$ledger_entry_max_bytes" ] || {
      echo 'ECI high-level log formatted entry exceeds its bounded size limit.' >&2
      exit 1
    }
    [ $((log_bytes_before + append_bytes)) -le "$ledger_max_bytes" ] || {
      echo 'ECI high-level log append would exceed its bounded size limit; refusing before write.' >&2
      exit 1
    }
    if [ "$(ledger_bytes "$log_path")" -gt 0 ] &&
      [ "$(tail -c 1 -- "$log_path" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')" != 0a ]; then
      echo 'ECI high-level log append requires the existing prefix to end at EOF/LF.' >&2
      exit 1
    fi
    printf '%s\n' "$formatted_entry" >>"$log_path"
    [ -f "$log_path" ] && [ ! -L "$log_path" ] || {
      echo 'ECI high-level log changed to an unsafe file during append.' >&2
      exit 1
    }
    ledger_write_anchor "$session_dir" true || {
      echo 'ECI high-level log anchor could not be advanced after append; retry is recoverable.' >&2
      exit 1
    }
    printf 'ECI high-level log appended at EOF: %s\n' "$log_path"
    ;;
  manifest-write)
    [ "$#" -eq 2 ] || { usage; exit 2; }
    require_main_nested_owner
    current_session="${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}"
    codex_valid_session_id "$current_session" || {
      echo 'manifest-write requires an explicit current CODEX_SESSION_ID or CODEX_THREAD_ID.' >&2
      exit 1
    }
    session_dir="$(resolve_session_dir)" || {
      echo 'eci-active: no current session directory found under the proof root.' >&2
      exit 1
    }
    [ "${session_dir##*/}" = "$current_session" ] || {
      echo 'manifest-write resolved a different session than the current identity.' >&2
      exit 1
    }
    acquire_eci_mutation_lock || exit 1
    marker="$(validate_active_marker "$(codex_proof_root)" "$current_session")" || {
      echo 'manifest-write requires an active canonical ECI marker.' >&2
      exit 1
    }
    codex_eci_marker_path_owner_is_valid "$marker" || {
      echo 'manifest-write rejected malformed marker ownership.' >&2
      exit 1
    }
    codex_eci_marker_is_valid_for_cwd "$marker" "$(codex_canonical_cwd "$PWD")" || {
      echo 'manifest-write rejected a marker bound to another cwd.' >&2
      exit 1
    }
    manifest_source="$2"
    manifest_destination="$session_dir/eci-required-critics.json"
    if ! manifest_temp_source_is_safe "$manifest_source"; then
      echo "manifest-write rejected source path '$manifest_source': expected a canonical regular eci-required-critics.json.source under \${TMPDIR:-/tmp}; proof-root and control-file sources are not accepted." >&2
      exit 1
    fi
    if [ -L "$manifest_destination" ] || { [ -e "$manifest_destination" ] && [ ! -f "$manifest_destination" ]; }; then
      echo 'manifest-write destination is unsafe.' >&2
      exit 1
    fi
    validate_manifest_for_write "$manifest_source" || {
      echo 'manifest-write rejected malformed, noncanonical, or non-v2 manifest bytes.' >&2
      exit 1
    }
    manifest_tmp="$manifest_destination.tmp.$$"
    [ ! -e "$manifest_tmp" ] && [ ! -L "$manifest_tmp" ] || {
      echo 'manifest-write transaction path is unsafe.' >&2
      exit 1
    }
    if ! (set -C; cat -- "$manifest_source" >"$manifest_tmp"); then
      rm -f -- "$manifest_tmp"
      echo 'manifest-write could not stage the canonical manifest.' >&2
      exit 1
    fi
    [ -L "$manifest_destination" ] || { [ ! -e "$manifest_destination" ] || [ -f "$manifest_destination" ]; } || {
      rm -f -- "$manifest_tmp"
      echo 'manifest-write destination changed to an unsafe type.' >&2
      exit 1
    }
    mv -- "$manifest_tmp" "$manifest_destination" || {
      rm -f -- "$manifest_tmp"
      echo 'manifest-write could not atomically publish the canonical manifest.' >&2
      exit 1
    }
    printf 'ECI required-critic manifest published: %s\n' "$manifest_destination"
    ;;
  approve-commit)
    [ "$#" -eq 3 ] || {
      echo 'ECI_APPROVE_COMMIT_USAGE: expected approve-commit <canonical-repo-root> "git commit ...".' >&2
      exit 2
    }
    require_main_approval_owner
    approval_repo_arg="$2"
    approval_command_arg="$3"
    if ! approval_git_repo_context "$approval_repo_arg"; then
      echo "ECI_APPROVE_COMMIT_REPO_DENIED: repo_root=$approval_repo_arg" >&2
      exit 1
    fi
    if ! approval_command_error="$(validate_approval_commit_command "$approval_command_arg" 2>&1)"; then
      echo "ECI_APPROVE_COMMIT_COMMAND_DENIED: $approval_command_error" >&2
      exit 1
    fi
    if ! write_approval_artifact "$approval_command_arg" "$APPROVAL_REPO_ROOT" "$APPROVAL_GIT_DIR"; then
      echo "ECI_APPROVE_COMMIT_WRITE_DENIED: could not publish a validated one-time approval for repo_root=$APPROVAL_REPO_ROOT command=$approval_command_arg" >&2
      exit 1
    fi
    ;;
  nested-enter)
    require_main_nested_owner
    shift
    step="${1:-}"; iteration="${2:-}"; writer="${3:-${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}}"
    version="${ECI_ACCEPTANCE_VERSION:-1}"
    [[ "$#" -ge 2 && "$#" -le 3 ]] || { usage; exit 2; }
    nested_number_is_bounded "$step" true && nested_number_is_bounded "$iteration" true || {
      echo 'nested-enter requires bounded numeric step and iteration.' >&2; exit 1;
    }
    nested_number_is_bounded "$version" false || {
      echo 'nested-enter requires a bounded positive canonical ECI_ACCEPTANCE_VERSION.' >&2; exit 1;
    }
    codex_valid_session_id "$writer" || { echo 'nested-enter requires a valid writer session.' >&2; exit 1; }
    session_dir="$(resolve_session_dir)" || { echo 'eci-active: no outer session directory found' >&2; exit 1; }
    acquire_eci_mutation_lock || exit 1
    marker="$(validate_active_marker "$(codex_proof_root)" "${session_dir##*/}")" || { echo 'nested-enter requires an active outer marker.' >&2; exit 1; }
    codex_eci_marker_path_owner_is_valid "$marker" || {
      echo 'nested-enter requires a canonical active marker owner.' >&2
      exit 1
    }
    codex_eci_marker_is_valid_for_cwd "$marker" "$(codex_canonical_cwd "$PWD")" || {
      echo 'nested-enter requires an active marker bound to the current cwd.' >&2
      exit 1
    }
    validate_session_dir "$(codex_proof_root)" "$writer" || { echo 'nested-enter writer session is not a safe canonical session.' >&2; exit 1; }
    [ -d "$(codex_proof_root)/$writer" ] && [ ! -L "$(codex_proof_root)/$writer" ] || { echo 'nested-enter writer session directory is unavailable.' >&2; exit 1; }
    nested_marker="$session_dir/ate_nested_eci_active"
    nested_completion="$session_dir/ate_nested_eci_completion"
    if [ -L "$nested_marker" ] || [ -e "$nested_marker" ]; then
      echo 'nested-enter found an already active nested ECI marker; refusing to replace its receipt or ownership.' >&2
      exit 1
    fi
    if [ -L "$nested_completion" ] || { [ -e "$nested_completion" ] && [ ! -f "$nested_completion" ]; }; then
      echo 'nested-enter found an unsafe completion receipt.' >&2; exit 1
    fi
    acceptance_anchor="$session_dir/eci-acceptance-anchor"
    acceptance_manifest="$session_dir/eci-required-critics.json"
    if [ -L "$acceptance_anchor" ] || { [ -e "$acceptance_anchor" ] && [ ! -f "$acceptance_anchor" ]; }; then
      echo 'nested-enter found an unsafe acceptance anchor.' >&2
      exit 1
    fi
    if [ -f "$acceptance_anchor" ]; then
      grep -Eq "^admission:[^:]+:$version:" "$acceptance_anchor" || {
        echo 'nested-enter acceptance version is not present in the authoritative session anchor.' >&2
        exit 1
      }
    fi
    if [ -L "$acceptance_manifest" ] || { [ -e "$acceptance_manifest" ] && [ ! -f "$acceptance_manifest" ]; }; then
      echo 'nested-enter found an unsafe acceptance manifest.' >&2
      exit 1
    fi
    if [ -f "$acceptance_manifest" ]; then
      manifest_version="$(jq -r 'if (.acceptance_version | type) == "string" then .acceptance_version else empty end' "$acceptance_manifest" 2>/dev/null || true)"
      [ "$manifest_version" = "$version" ] || {
        echo 'nested-enter acceptance version does not match the authoritative manifest.' >&2
        exit 1
      }
    fi
    [ ! -e "$nested_completion" ] || rm -f -- "$nested_completion" || { echo 'nested-enter could not clear the prior completion receipt.' >&2; exit 1; }
    write_nested_marker "$nested_marker" "${session_dir##*/}" "$step" "$iteration" "$writer" "$version" || {
      echo 'nested-enter could not atomically create the nested ECI marker.' >&2; exit 1;
    }
    printf 'Nested ECI active under outer marker: %s\n' "$marker"
    ;;
  nested-accept)
    [ "$#" -eq 1 ] || { usage; exit 2; }
    require_main_nested_owner
    session_dir="$(resolve_session_dir)" || { echo 'eci-active: no outer session directory found' >&2; exit 1; }
    acquire_eci_mutation_lock || exit 1
    nested_marker="$session_dir/ate_nested_eci_active"
    nested_completion="$session_dir/ate_nested_eci_completion"
    write_nested_completion "$nested_marker" "$nested_completion" || {
      echo 'nested ECI acceptance receipt could not be published for the owned active marker.' >&2
      exit 1
    }
    printf 'Nested ECI acceptance receipt published: %s\n' "$nested_completion"
    ;;
  nested-exit)
    [ "$#" -eq 1 ] || { usage; exit 2; }
    require_main_nested_owner
    session_dir="$(resolve_session_dir)" || { echo 'eci-active: no outer session directory found' >&2; exit 1; }
    acquire_eci_mutation_lock || exit 1
    nested_marker="$session_dir/ate_nested_eci_active"
    nested_completion="$session_dir/ate_nested_eci_completion"
    validate_nested_marker "$nested_marker" || { echo 'nested ECI marker is invalid, stale, or not owned by the active outer session.' >&2; exit 1; }
    validate_nested_completion "$nested_completion" "$nested_marker" || { echo 'nested ECI completion receipt is missing, stale, or not bound to the owned marker.' >&2; exit 1; }
    rm -f -- "$nested_marker"
    [ ! -e "$nested_marker" ] && [ ! -L "$nested_marker" ] || { echo 'nested ECI marker could not be cleared.' >&2; exit 1; }
    printf 'Nested ECI inactive; outer marker retained.\n'
    ;;
  off)
    require_main_lifecycle_owner
    report="${2:-}"
    markers=()
    [ -n "$report" ] || { usage; exit 2; }
    [ -f "$report" ] || { echo "Disengage report not found: $report" >&2; exit 1; }
    # When the caller supplies a report inside a proof session, that path is
    # an identity claim, not a hint.  Bind it before resolving the active
    # marker so a stale report cannot fall through to the newest session and
    # produce a misleading generic "inactive" error.  Reports outside the
    # proof root remain supported for the existing user-owned flow.
    report_path="$(realpath -m -- "$report" 2>/dev/null || true)"
    report_root="$(codex_proof_root)"
    report_session=""
    case "$report_path" in
      "$report_root"/*/*)
        report_rest="${report_path#"$report_root"/}"
        report_session="${report_rest%%/*}"
        report_tail="${report_rest#*/}"
        if codex_valid_session_id "$report_session" && [ "$report_tail" != "$report_rest" ]; then
          requested_session="${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}"
          if [ -n "$requested_session" ] && [ "$requested_session" != "$report_session" ]; then
            echo "ECI off session identity mismatch: supplied report $report_path belongs to session $report_session, but the requested active session is $requested_session; refusing teardown." >&2
            exit 1
          fi
          [ -n "$requested_session" ] || export CODEX_SESSION_ID="$report_session"
        fi
        ;;
    esac
    requested_session="${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}"
    if [ -n "$requested_session" ] && [ ! -e "$report_root/$requested_session" ]; then
      conflicting_marker=""
      conflicting_count=0
      while IFS= read -r candidate_marker; do
        case "$candidate_marker" in
          "$codex_eci_marker_scan_overflow_token"|"$codex_eci_marker_scan_unsafe_token"|'')
            continue
            ;;
        esac
        if [ -f "$candidate_marker" ] && [ ! -L "$candidate_marker" ]; then
          conflicting_marker="$candidate_marker"
          conflicting_count=$((conflicting_count + 1))
        fi
      done < <(codex_eci_markers_for_cwd "$PWD" strict "" 2>/dev/null || true)
      if [ "$conflicting_count" -eq 1 ]; then
        conflicting_owner="${conflicting_marker%/*}"
        conflicting_owner="${conflicting_owner##*/}"
        if [ "$conflicting_owner" != "$requested_session" ]; then
          conflicting_dir="${conflicting_marker%/*}"
          echo "ECI off session identity mismatch: requested session $requested_session has no session directory under $report_root, but the active marker belongs to $conflicting_owner; refusing teardown. Expected an active-session report under $conflicting_dir (for example $conflicting_dir/disengage.md); marker retained: $conflicting_marker" >&2
          exit 1
        fi
      fi
    fi
    session_dir="$(resolve_session_dir)" || {
      echo "eci-active: no session directory found under $(codex_proof_root)" >&2
      exit 1
    }
    acquire_eci_mutation_lock || exit 1
    marker="$session_dir/eci_active"
    if [ -L "$marker" ]; then
      echo "ECI marker is a symlink; refusing to use it: $marker" >&2
      exit 1
    fi
    if [ ! -f "$marker" ]; then
      conflicting_marker=""
      while IFS= read -r candidate_marker; do
        case "$candidate_marker" in
          "$codex_eci_marker_scan_overflow_token"|"$codex_eci_marker_scan_unsafe_token"|'')
            continue
            ;;
        esac
        if [ -f "$candidate_marker" ] && [ ! -L "$candidate_marker" ]; then
          conflicting_marker="$candidate_marker"
          break
        fi
      done < <(codex_eci_markers_for_cwd "$PWD" strict "${session_dir##*/}" 2>/dev/null || true)
      if [ -n "$conflicting_marker" ]; then
        conflicting_owner="${conflicting_marker%/*}"
        conflicting_owner="${conflicting_owner##*/}"
        conflicting_dir="${conflicting_marker%/*}"
        echo "ECI off session identity mismatch: supplied report $report targets requested session ${session_dir##*/}, but the active marker belongs to $conflicting_owner; refusing teardown. Expected an active-session report under $conflicting_dir (for example $conflicting_dir/disengage.md); marker retained: $conflicting_marker" >&2
      else
        echo "ECI marker is not active for requested session ${session_dir##*/}; refusing teardown: $marker" >&2
      fi
      exit 1
    fi
    if [ -f "$marker" ]; then
      codex_eci_marker_path_owner_is_valid "$marker" || {
        echo "ECI marker path/owner binding is malformed; refusing teardown: $marker" >&2
        exit 1
      }
      codex_eci_marker_is_valid_for_cwd "$marker" "$(codex_canonical_cwd "$PWD")" || {
        echo "ECI marker cwd binding is malformed or belongs to another cwd; refusing teardown: $marker" >&2
        exit 1
      }
    fi
    [ -f "$marker" ] && markers+=("$marker")
    while IFS= read -r legacy_marker; do
      [ -n "$legacy_marker" ] || continue
      [ "$legacy_marker" = "$marker" ] && continue
      markers+=("$legacy_marker")
    done < <(codex_legacy_eci_markers_for_cwd "$PWD" 2>/dev/null || true)
    [ "${#markers[@]}" -gt 0 ] || { echo "ECI marker is not active: $marker" >&2; exit 1; }
    user_closed_report=false
    if grep -Fqx 'schema: eci-user-closed/v1' "$report_path" 2>/dev/null; then
      validate_user_closed_report "$report_path" "${session_dir##*/}" "$(codex_canonical_cwd "$PWD")" || {
        echo "ECI user-closed report is malformed, unclean/incomplete state is missing, or is not bound to the active owner/session/cwd/path; marker retained: $report_path" >&2
        exit 1
      }
      user_closed_report=true
    fi
    wait_state="$session_dir/eci_wait"
    [ ! -L "$wait_state" ] || {
      echo "ECI user-owned wait state is a symlink; refusing to remove it: $wait_state" >&2
      exit 1
    }
    if [ -e "$wait_state" ] && [ ! -f "$wait_state" ]; then
      echo "ECI user-owned wait state is not a regular file: $wait_state" >&2
      exit 1
    fi
    if [ "$user_closed_report" != true ] && [ -f "$wait_state" ]; then
      expected_wait_report="$session_dir/$eci_wait_report_name"
      validate_eci_wait_state_report_binding "$wait_state" "$expected_wait_report" || {
        echo "ECI user-owned wait state/report is invalid or unbound: $wait_state" >&2
        exit 1
      }
    fi
    if [ "$user_closed_report" = true ]; then
      write_user_closed_ledger "$session_dir" "$report_path" "$(codex_canonical_cwd "$PWD")" || {
        echo "ECI user-closed audit ledger could not be published or validated; marker retained." >&2
        exit 1
      }
    else
      validate_disengage_report "$report"
      run_eci_review_gate off "${session_dir##*/}" || {
        echo "ECI required-critic review gate rejected teardown; marker retained." >&2
        exit 1
      }
      write_teardown_receipt "$session_dir" "$report" || {
        echo "ECI teardown receipt could not be published or validated; marker retained." >&2
        exit 1
      }
    fi
    for prewrite_sentinel in "$session_dir"/eci-prewrite-admitted.*; do
      [ -e "$prewrite_sentinel" ] || [ -L "$prewrite_sentinel" ] || continue
      [ -f "$prewrite_sentinel" ] && [ ! -L "$prewrite_sentinel" ] || {
        echo "ECI prewrite admission sentinel is unsafe: $prewrite_sentinel" >&2
        exit 1
      }
      rm -f -- "$prewrite_sentinel"
    done
    [ -f "$wait_state" ] && rm -f "$wait_state"
    rm -f "${markers[@]}"
    if [ "$user_closed_report" = true ]; then
      printf 'ECI inactive. User-closed incomplete teardown recorded: %s\n' "$report_path"
    else
      printf 'ECI inactive. Disengage report validated: %s\n' "$report"
    fi
    ;;
  status)
    session_dir="$(resolve_session_dir)" || {
      echo "eci-active: no session directory found under $(codex_proof_root)" >&2
      exit 1
    }
    marker="$session_dir/eci_active"
    if [ -L "$marker" ]; then
      echo "ECI marker is a symlink; refusing to read it: $marker" >&2
      exit 1
    fi
    if [ -n "${marker:-}" ] && [ -f "$marker" ] && [ ! -L "$marker" ]; then
      codex_eci_marker_file_is_bounded "$marker" || {
        echo "ECI marker is oversized or unsafe; refusing to read it: $marker" >&2
        exit 1
      }
      cat "$marker"
    elif legacy_marker="$(codex_legacy_eci_markers_for_cwd "$PWD" 2>/dev/null | head -n1)" &&
      [ -n "$legacy_marker" ] && codex_eci_marker_file_is_bounded "$legacy_marker"; then
      cat "$legacy_marker"
    else
      echo "ECI inactive"
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac
