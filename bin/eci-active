#!/usr/bin/env bash
# Manage the ECI active marker for the current Codex session.

set -euo pipefail

base_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$base_dir/hooks/lib/codex-proof-state.sh"

usage() {
  cat >&2 <<'EOF'
Usage:
  eci-active on "<task + scope>"
  eci-active off <disengage-report.md>
  eci-active status

Set CODEX_SESSION_ID, or CODEX_THREAD_ID when CODEX_SESSION_ID is
unset, to target a session. Without either, the newest real session
directory under the proof root is used. Cwd-scoped ECI state is never
created.
EOF
}

root_path=""
root_dev=""
root_ino=""
root_input_path=""
root_parent_path=""
root_parent_dev=""
root_parent_ino=""

capture_root_identity() {
  local root_identity parent_identity configured_root_parent

  root_input_path="$(codex_proof_root)"
  root_path="$(canonical_path "$root_input_path" || true)"
  [ -n "$root_path" ] && [ -d "$root_path" ] && [ ! -L "$root_path" ] || return 1
  root_identity="$(stat -Lc '%d:%i' -- "$root_path" 2>/dev/null || true)"
  [[ "$root_identity" == *:* ]] || return 1
  root_dev="${root_identity%%:*}"
  root_ino="${root_identity#*:}"
  configured_root_parent="$(canonical_path "$(dirname -- "$root_input_path")" || true)"
  [ -n "$configured_root_parent" ] || return 1
  parent_identity="$(stat -Lc '%d:%i' -- "$configured_root_parent" 2>/dev/null || true)"
  [[ "$root_dev" =~ ^[0-9]+$ ]] && [[ "$root_ino" =~ ^[0-9]+$ ]] || return 1
  [[ "$parent_identity" == *:* ]] || return 1
  root_parent_path="$configured_root_parent"
  root_parent_dev="${parent_identity%%:*}"
  root_parent_ino="${parent_identity#*:}"
  [[ "$root_parent_dev" =~ ^[0-9]+$ ]] && [[ "$root_parent_ino" =~ ^[0-9]+$ ]]
}

root_is_stable() {
  local root_identity parent_identity current_root current_parent

  [ -d "$root_path" ] && [ ! -L "$root_path" ] || return 1
  root_identity="$(stat -Lc '%d:%i' -- "$root_path" 2>/dev/null || true)"
  [ "$root_identity" = "$root_dev:$root_ino" ] || return 1
  [ -d "$root_parent_path" ] && [ ! -L "$root_parent_path" ] || return 1
  parent_identity="$(stat -Lc '%d:%i' -- "$root_parent_path" 2>/dev/null || true)"
  [ "$parent_identity" = "$root_parent_dev:$root_parent_ino" ] || return 1
  current_root="$(canonical_path "$root_input_path" || true)"
  [ "$current_root" = "$root_path" ] || return 1
  current_parent="$(canonical_path "$(dirname -- "$root_input_path")" || true)"
  [ "$current_parent" = "$root_parent_path" ]
}

cat_marker_from_root_safe() {
  local marker="$1"
  local marker_dir marker_name session_name

  marker_dir="${marker%/*}"
  marker_name="${marker##*/}"
  [ "$marker_name" = eci_active ] || return 2
  session_name="${marker_dir##*/}"
  [ "$marker_dir" = "$root_path/$session_name" ] || return 2
  python3 - "$root_path" "$session_name" "$root_dev" "$root_ino" <<'PY'
import os
import stat
import sys

root, session_name, expected_dev, expected_ino = sys.argv[1:]
flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
try:
    root_fd = os.open(root, flags)
except FileNotFoundError:
    raise SystemExit(1)
except OSError:
    raise SystemExit(2)
try:
    root_info = os.fstat(root_fd)
    if (str(root_info.st_dev), str(root_info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(2)
    try:
        path_info = os.stat(root, follow_symlinks=False)
    except OSError:
        raise SystemExit(2)
    if (not stat.S_ISDIR(path_info.st_mode) or
            (str(path_info.st_dev), str(path_info.st_ino)) != (expected_dev, expected_ino)):
        raise SystemExit(2)
    try:
        session_fd = os.open(session_name, flags, dir_fd=root_fd)
    except FileNotFoundError:
        raise SystemExit(1)
    except OSError:
        raise SystemExit(2)
    try:
        session_info = os.fstat(session_fd)
        if not stat.S_ISDIR(session_info.st_mode):
            raise SystemExit(2)
        try:
            marker_fd = os.open(
                "eci_active",
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=session_fd,
            )
        except FileNotFoundError:
            raise SystemExit(1)
        except OSError:
            raise SystemExit(2)
        try:
            marker_info = os.fstat(marker_fd)
            if (not stat.S_ISREG(marker_info.st_mode) or marker_info.st_nlink != 1 or
                    marker_info.st_size > 1048576):
                raise SystemExit(2)
            data = bytearray()
            while True:
                chunk = os.read(marker_fd, 65536)
                if not chunk:
                    break
                data.extend(chunk)
                if len(data) > 1048576:
                    raise SystemExit(2)
            sys.stdout.buffer.write(data)
        finally:
            os.close(marker_fd)
    finally:
        os.close(session_fd)
finally:
    os.close(root_fd)
PY
}

ensure_session_directory() {
  local session_name="$1"

  python3 - "$root_path" "$session_name" "$root_dev" "$root_ino" <<'PY'
import os
import stat
import sys

root, session_name, expected_dev, expected_ino = sys.argv[1:]
root_fd = os.open(
    root,
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    info = os.fstat(root_fd)
    if (str(info.st_dev), str(info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(1)
    try:
        session_fd = os.open(
            session_name,
            os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
            dir_fd=root_fd,
        )
    except FileNotFoundError:
        os.mkdir(session_name, mode=0o700, dir_fd=root_fd)
    else:
        os.close(session_fd)
    os.fsync(root_fd)
finally:
    os.close(root_fd)
PY
}

remove_stale_marker_temps() {
  local directory="$1"
  local expected_dev="$2"
  local expected_ino="$3"

  python3 - "$directory" "$expected_dev" "$expected_ino" <<'PY'
import os
import stat
import sys

directory, expected_dev, expected_ino = sys.argv[1:]
flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
directory_fd = os.open(directory, flags)
try:
    info = os.fstat(directory_fd)
    if (not stat.S_ISDIR(info.st_mode) or
            (str(info.st_dev), str(info.st_ino)) != (expected_dev, expected_ino)):
        raise SystemExit(1)
    names = sorted(name for name in os.listdir(directory_fd) if name.startswith(".eci_active."))
    if len(names) > 64:
        raise SystemExit(1)
    # A closed private temp is recoverable activation residue; an open inode
    # belongs to a live activation and is left for its owner to finish.
    def is_open_elsewhere(entry):
        for pid_name in os.listdir("/proc"):
            if not pid_name.isdigit():
                continue
            fd_dir = os.path.join("/proc", pid_name, "fd")
            try:
                fd_names = os.listdir(fd_dir)
            except OSError:
                continue
            for fd_name in fd_names:
                fd_path = os.path.join(fd_dir, fd_name)
                try:
                    opened = os.stat(fd_path)
                except OSError:
                    continue
                if ((opened.st_dev, opened.st_ino) == (entry.st_dev, entry.st_ino) and
                        stat.S_ISREG(opened.st_mode)):
                    return True
        return False

    for name in names:
        entry = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if stat.S_ISLNK(entry.st_mode):
            raise SystemExit(1)
        if not stat.S_ISREG(entry.st_mode) or entry.st_nlink != 1:
            raise SystemExit(1)
        if is_open_elsewhere(entry):
            continue
        current = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        if ((current.st_dev, current.st_ino) != (entry.st_dev, entry.st_ino) or
                not stat.S_ISREG(current.st_mode) or current.st_nlink != 1):
            raise SystemExit(1)
        os.unlink(name, dir_fd=directory_fd)
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
PY
}

resolve_session_dir() {
  local root name newest="" newest_mtime=0 d mtime session_id session_var
  local reject_reserved="${1:-false}"
  root="$(canonical_path "$(codex_proof_root)" || true)"
  [ -n "$root" ] || return 1

  if [ -n "${CODEX_SESSION_ID:-}" ]; then
    session_id="$CODEX_SESSION_ID"
    session_var="CODEX_SESSION_ID"
  elif [ -n "${CODEX_THREAD_ID:-}" ]; then
    session_id="$CODEX_THREAD_ID"
    session_var="CODEX_THREAD_ID"
  fi

  if [ -n "${session_id:-}" ]; then
    codex_valid_session_id "$session_id" || {
      echo "Invalid $session_var; use only letters, digits, '_' or '-'." >&2
      exit 1
    }
    if [ "$reject_reserved" = true ] && codex_reserved_proof_dir "$session_id"; then
      echo "Reserved $session_var cannot be activated: $session_id" >&2
      exit 1
    fi
    printf '%s/%s\n' "$root" "$session_id"
    return
  fi

  [ -d "$root" ] || return 1
  shopt -s nullglob
  for d in "$root"/*/; do
    d="${d%/}"
    name="${d##*/}"
    codex_valid_session_id "$name" || continue
    codex_reserved_proof_dir "$name" && continue
    mtime=$(stat -c '%Y' "$d" 2>/dev/null) || continue
    if [ "$mtime" -gt "$newest_mtime" ]; then
      newest_mtime="$mtime"
      newest="$d"
    fi
  done
  shopt -u nullglob
  [ -n "$newest" ] || return 1
  printf '%s\n' "$newest"
}

canonical_path() {
  local path="$1"
  local canonical

  canonical="$(realpath -m -- "$path" 2>/dev/null || true)"
  case "$canonical" in
    /*) printf '%s\n' "$canonical" ;;
    *) return 1 ;;
  esac
}

legacy_eci_markers_for_cwd_safe() {
  local canonical_cwd

  [ -n "$root_path" ] && [ -n "$root_dev" ] && [ -n "$root_ino" ] || return 1
  canonical_cwd="$(codex_canonical_cwd "$PWD")" || return 1
  python3 - "$root_path" "$root_dev" "$root_ino" "$canonical_cwd" <<'PY'
import os
import stat
import sys

root, expected_dev, expected_ino, wanted_cwd = sys.argv[1:]
reserved = {
    "activity", "audit", "eci", "history", "pre-reviewer", "reviewer",
    "reviewer-dumps", "side-stop", "skip-stop", "skills",
}

def is_reserved(name):
    return name in reserved or name.startswith("security-warnings-")

def safe_read_marker(fd, expected_owner):
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        return None
    data = bytearray()
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        data.extend(chunk)
        if len(data) > 1048576:
            return None
    if (not data.endswith(b"\n") or b"\x00" in data or
            any(byte < 0x20 and byte != 0x0a for byte in data) or 0x7f in data):
        return None
    try:
        lines = bytes(data).decode("utf-8").splitlines()
    except UnicodeDecodeError:
        return None
    if (len(lines) not in (3, 4) or
            not lines[0].startswith("scope: ") or
            not lines[1].startswith("cwd: ") or
            not lines[2].startswith("session_id: ")):
        return None
    scope = lines[0][len("scope: "):]
    marker_cwd = lines[1][len("cwd: "):]
    marker_owner = lines[2][len("session_id: "):]
    if not scope or not marker_cwd or marker_owner != expected_owner or not is_reserved(marker_owner):
        return None
    if not marker_cwd.startswith("/") or os.path.realpath(marker_cwd) != wanted_cwd:
        return None
    if len(lines) == 4:
        if not lines[3].startswith("created_utc: "):
            return None
        created = lines[3][len("created_utc: "):]
        try:
            parsed = __import__("datetime").datetime.strptime(created, "%Y-%m-%dT%H:%M:%SZ")
        except ValueError:
            return None
        if parsed.strftime("%Y-%m-%dT%H:%M:%SZ") != created:
            return None
    return True

flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
root_fd = os.open(root, flags)
invalid = False
try:
    root_info = os.fstat(root_fd)
    if (str(root_info.st_dev), str(root_info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(1)
    try:
        path_info = os.stat(root, follow_symlinks=False)
    except OSError:
        raise SystemExit(1)
    if (not stat.S_ISDIR(path_info.st_mode) or
            (str(path_info.st_dev), str(path_info.st_ino)) != (expected_dev, expected_ino)):
        raise SystemExit(1)
    for name in sorted(os.listdir(root_fd)):
        if not is_reserved(name):
            continue
        try:
            session_info = os.stat(name, dir_fd=root_fd, follow_symlinks=False)
        except FileNotFoundError:
            continue
        if not stat.S_ISDIR(session_info.st_mode):
            continue
        try:
            session_fd = os.open(name, flags, dir_fd=root_fd)
        except OSError:
            continue
        try:
            opened_session = os.fstat(session_fd)
            if (opened_session.st_dev, opened_session.st_ino) != (session_info.st_dev, session_info.st_ino):
                continue
            try:
                marker_info = os.stat("eci_active", dir_fd=session_fd, follow_symlinks=False)
            except FileNotFoundError:
                continue
            if stat.S_ISLNK(marker_info.st_mode):
                continue
            if not stat.S_ISREG(marker_info.st_mode) or marker_info.st_nlink != 1:
                invalid = True
                continue
            try:
                marker_fd = os.open("eci_active", os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=session_fd)
            except OSError:
                invalid = True
                continue
            try:
                opened_marker = os.fstat(marker_fd)
                if (opened_marker.st_dev, opened_marker.st_ino) != (marker_info.st_dev, marker_info.st_ino):
                    invalid = True
                    continue
                if safe_read_marker(marker_fd, name):
                    print(os.path.join(root, name, "eci_active"))
                else:
                    invalid = True
            finally:
                os.close(marker_fd)
        finally:
            os.close(session_fd)
finally:
    os.close(root_fd)
if invalid:
    raise SystemExit(2)
PY
}

hash_file() {
  local file="$1"

  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -- "$file" | awk '{print $1}'
  elif command -v python3 >/dev/null 2>&1; then
    python3 - "$file" <<'PY'
import hashlib
import pathlib
import sys

print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())
PY
  else
    return 1
  fi
}

marker_has_no_control() {
  local value="$1"

  if printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'; then
    return 1
  fi
  return 0
}

marker_bytes_are_safe() {
  local marker="$1"

  python3 - "$marker" <<'PY'
import os
import stat
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise SystemExit(1)
    data = b""
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        data += chunk
        if len(data) > 1048576:
            raise SystemExit(1)
finally:
    os.close(fd)

if b"\x00" in data or any(byte < 0x20 and byte != 0x0a for byte in data) or 0x7f in data:
    raise SystemExit(1)
if not data.endswith(b"\n"):
    raise SystemExit(1)
PY
}

flush_directory() {
  local directory="$1"

  python3 - "$directory" <<'PY'
import os
import sys

fd = os.open(
    sys.argv[1],
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PY
}

write_existing_temp() {
  local file="$1"
  local mode="${2:-}"

  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  python3 -c '
import os
import stat
import sys

fd = os.open(sys.argv[1], os.O_WRONLY | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0))
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise RuntimeError("temporary state is not a private regular file")
    while True:
        chunk = sys.stdin.buffer.read(65536)
        if not chunk:
            break
        view = memoryview(chunk)
        while view:
            written = os.write(fd, view)
            view = view[written:]
    if sys.argv[2]:
        os.fchmod(fd, int(sys.argv[2], 8))
    os.fsync(fd)
finally:
    os.close(fd)
' "$file" "$mode"
}

create_temp_in_directory() {
  local directory="$1"
  local expected_dev="$2"
  local expected_ino="$3"
  local prefix="$4"

  python3 - "$directory" "$expected_dev" "$expected_ino" "$prefix" <<'PY'
import os
import secrets
import stat
import sys

directory, expected_dev, expected_ino, prefix = sys.argv[1:]
directory_fd = os.open(
    directory,
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    info = os.fstat(directory_fd)
    if (str(info.st_dev), str(info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(1)
    for _ in range(32):
        name = prefix + secrets.token_hex(6)
        try:
            fd = os.open(
                name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
                dir_fd=directory_fd,
            )
        except FileExistsError:
            continue
        try:
            created = os.fstat(fd)
            if not stat.S_ISREG(created.st_mode) or created.st_nlink != 1:
                os.unlink(name, dir_fd=directory_fd)
                raise SystemExit(1)
            token = secrets.token_hex(16)
            os.write(fd, (token + "\n").encode("ascii"))
            os.fsync(fd)
        finally:
            os.close(fd)
        os.fsync(directory_fd)
        print(f"{os.path.join(directory, name)}|{created.st_dev}:{created.st_ino}|{token}")
        raise SystemExit(0)
    raise SystemExit(1)
finally:
    os.close(directory_fd)
PY
}

write_existing_temp_in_directory() {
  local file="$1"
  local mode="$2"
  local directory="$3"
  local expected_dev="$4"
  local expected_ino="$5"
  local expected_file_dev="${6:-}"
  local expected_file_ino="${7:-}"
  local expected_token="${8:-}"

  python3 -c '
import os
import stat
import sys

file_name, mode, directory, expected_dev, expected_ino, expected_file_dev, expected_file_ino, expected_token = sys.argv[1:]
if os.path.normpath(os.path.dirname(file_name)) != os.path.normpath(directory):
    raise SystemExit(1)
directory_fd = os.open(
    directory,
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    info = os.fstat(directory_fd)
    if (str(info.st_dev), str(info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(1)
    fd = os.open(
        os.path.basename(file_name),
        os.O_RDWR | getattr(os, "O_NOFOLLOW", 0),
        dir_fd=directory_fd,
    )
    try:
        current = os.fstat(fd)
        if not stat.S_ISREG(current.st_mode) or current.st_nlink != 1:
            raise SystemExit(1)
        if expected_file_dev and (str(current.st_dev), str(current.st_ino)) != (expected_file_dev, expected_file_ino):
            raise SystemExit(1)
        if expected_token:
            os.lseek(fd, 0, os.SEEK_SET)
            if os.read(fd, len(expected_token) + 1) != (expected_token + "\n").encode("ascii"):
                raise SystemExit(1)
            os.ftruncate(fd, 0)
            os.lseek(fd, 0, os.SEEK_SET)
        while True:
            chunk = sys.stdin.buffer.read(65536)
            if not chunk:
                break
            view = memoryview(chunk)
            while view:
                written = os.write(fd, view)
                view = view[written:]
        if mode:
            os.fchmod(fd, int(mode, 8))
        os.fsync(fd)
    finally:
        os.close(fd)
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
' "$file" "$mode" "$directory" "$expected_dev" "$expected_ino" \
    "$expected_file_dev" "$expected_file_ino" "$expected_token"
}

mkdir_in_directory() {
  local directory="$1"
  local name="$2"
  local expected_dev="$3"
  local expected_ino="$4"

  python3 - "$directory" "$name" "$expected_dev" "$expected_ino" <<'PY'
import os
import sys

directory, name, expected_dev, expected_ino = sys.argv[1:]
directory_fd = os.open(
    directory,
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    info = os.fstat(directory_fd)
    if (str(info.st_dev), str(info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(3)
    try:
        os.mkdir(name, mode=0o700, dir_fd=directory_fd)
    except FileExistsError:
        raise SystemExit(1)
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
PY
}

remove_regular_in_directory() {
  local path="$1"
  local directory="$2"
  local expected_dev="$3"
  local expected_ino="$4"
  local max_links="${5:-1}"
  local expected_file_dev="${6:-}"
  local expected_file_ino="${7:-}"
  local expected_token="${8:-}"
  local expected_hash="${9:-}"

  python3 - "$path" "$directory" "$expected_dev" "$expected_ino" "$max_links" \
    "$expected_file_dev" "$expected_file_ino" "$expected_token" "$expected_hash" <<'PY'
import hashlib
import os
import stat
import sys

path, directory, expected_dev, expected_ino, max_links, expected_file_dev, expected_file_ino, expected_token, expected_hash = sys.argv[1:]
if os.path.normpath(os.path.dirname(path)) != os.path.normpath(directory):
    raise SystemExit(1)
directory_fd = os.open(
    directory,
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    info = os.fstat(directory_fd)
    if (str(info.st_dev), str(info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(1)
    name = os.path.basename(path)
    try:
        entry = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        raise SystemExit(0)
    if not stat.S_ISREG(entry.st_mode) or entry.st_nlink > int(max_links):
        raise SystemExit(1)
    if expected_file_dev and (str(entry.st_dev), str(entry.st_ino)) != (expected_file_dev, expected_file_ino):
        raise SystemExit(0)
    if expected_token:
        fd = os.open(name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=directory_fd)
        try:
            if os.read(fd, len(expected_token) + 1) != (expected_token + "\n").encode("ascii"):
                raise SystemExit(0)
        finally:
            os.close(fd)
    if expected_hash:
        fd = os.open(name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=directory_fd)
        try:
            digest = hashlib.sha256()
            while True:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                digest.update(chunk)
        finally:
            os.close(fd)
        if digest.hexdigest() != expected_hash:
            raise SystemExit(0)
    os.unlink(name, dir_fd=directory_fd)
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
PY
}

link_temp_in_directory() {
  local file="$1"
  local target="$2"
  local directory="$3"
  local expected_dev="$4"
  local expected_ino="$5"
  local expected_file_dev="${6:-}"
  local expected_file_ino="${7:-}"
  local expected_hash="${8:-}"

  python3 - "$file" "$target" "$directory" "$expected_dev" "$expected_ino" \
    "$expected_file_dev" "$expected_file_ino" "$expected_hash" <<'PY'
import ctypes
import hashlib
import os
import stat
import sys

file_name, target_name, directory, expected_dev, expected_ino, expected_file_dev, expected_file_ino, expected_hash = sys.argv[1:]
if (os.path.normpath(os.path.dirname(file_name)) != os.path.normpath(directory) or
        os.path.normpath(os.path.dirname(target_name)) != os.path.normpath(directory)):
    raise SystemExit(1)
directory_fd = os.open(
    directory,
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    info = os.fstat(directory_fd)
    if (str(info.st_dev), str(info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(1)
    source_name = os.path.basename(file_name)
    source_fd = os.open(source_name, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=directory_fd)
    try:
        source = os.fstat(source_fd)
        if not stat.S_ISREG(source.st_mode) or source.st_nlink != 1:
            raise SystemExit(1)
        if expected_file_dev and (str(source.st_dev), str(source.st_ino)) != (expected_file_dev, expected_file_ino):
            raise SystemExit(1)
        if expected_hash:
            digest = hashlib.sha256()
            while True:
                chunk = os.read(source_fd, 65536)
                if not chunk:
                    break
                digest.update(chunk)
            if digest.hexdigest() != expected_hash:
                raise SystemExit(1)
        try:
            target = os.stat(os.path.basename(target_name), dir_fd=directory_fd, follow_symlinks=False)
        except FileNotFoundError:
            target = None
        if target is not None:
            raise SystemExit(1)
        libc = ctypes.CDLL(None, use_errno=True)
        libc.linkat.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
        libc.linkat.restype = ctypes.c_int
        if libc.linkat(-100, f"/proc/self/fd/{source_fd}".encode(), directory_fd,
                      os.path.basename(target_name).encode(), 0x400) != 0:
            raise OSError(ctypes.get_errno(), "descriptor-anchored install failed")
        try:
            current = os.stat(source_name, dir_fd=directory_fd, follow_symlinks=False)
        except FileNotFoundError:
            current = None
        if current is not None and (current.st_dev, current.st_ino) == (source.st_dev, source.st_ino):
            os.unlink(source_name, dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        os.close(source_fd)
finally:
    os.close(directory_fd)
PY
}

remove_lock_directory_in_directory() {
  local directory="$1"
  local lock_name="$2"
  local expected_dev="$3"
  local expected_ino="$4"
  local expected_lock_dev="${5:-}"
  local expected_lock_ino="${6:-}"
  local expected_token="${7:-}"

  python3 - "$directory" "$lock_name" "$expected_dev" "$expected_ino" \
    "$expected_lock_dev" "$expected_lock_ino" "$expected_token" <<'PY'
import os
import stat
import sys

directory, lock_name, expected_dev, expected_ino, expected_lock_dev, expected_lock_ino, expected_token = sys.argv[1:]
parent_fd = os.open(
    directory,
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    parent_info = os.fstat(parent_fd)
    if (str(parent_info.st_dev), str(parent_info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(1)
    try:
        entry = os.stat(lock_name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        raise SystemExit(0)
    if not stat.S_ISDIR(entry.st_mode):
        raise SystemExit(1)
    if expected_lock_dev and (str(entry.st_dev), str(entry.st_ino)) != (expected_lock_dev, expected_lock_ino):
        raise SystemExit(1)
    lock_fd = os.open(
        lock_name,
        os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
        dir_fd=parent_fd,
    )
    try:
        lock_info = os.fstat(lock_fd)
        if expected_lock_dev and (str(lock_info.st_dev), str(lock_info.st_ino)) != (expected_lock_dev, expected_lock_ino):
            raise SystemExit(1)
        if expected_token:
            try:
                owner_fd = os.open("owner", os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=lock_fd)
            except OSError:
                raise SystemExit(1)
            try:
                owner_info = os.fstat(owner_fd)
                if not stat.S_ISREG(owner_info.st_mode) or owner_info.st_nlink != 1 or owner_info.st_size > 4096:
                    raise SystemExit(1)
                owner_bytes = os.read(owner_fd, 4097)
            finally:
                os.close(owner_fd)
            if len(owner_bytes) > 4096 or not owner_bytes.endswith(b"\n"):
                raise SystemExit(1)
            try:
                owner_lines = owner_bytes.decode("ascii").splitlines()
            except UnicodeDecodeError:
                raise SystemExit(1)
            if len(owner_lines) != 4 or owner_lines[3] != "token: " + expected_token:
                raise SystemExit(1)
        for name in os.listdir(lock_fd):
            if name != "owner" and not name.startswith(".owner."):
                raise SystemExit(1)
            child = os.stat(name, dir_fd=lock_fd, follow_symlinks=False)
            if not stat.S_ISREG(child.st_mode) or child.st_nlink > 2:
                raise SystemExit(1)
            os.unlink(name, dir_fd=lock_fd)
        os.fsync(lock_fd)
    finally:
        os.close(lock_fd)
    os.rmdir(lock_name, dir_fd=parent_fd)
    os.fsync(parent_fd)
finally:
    os.close(parent_fd)
PY
}

install_marker_no_overwrite() {
  local temporary="$1"
  local directory="$2"
  local expected_dev="${3:-}"
  local expected_ino="${4:-}"
  local expected_file_dev="${5:-}"
  local expected_file_ino="${6:-}"
  local expected_hash="${7:-}"

  python3 - "$temporary" "$directory" "$expected_dev" "$expected_ino" \
    "$expected_file_dev" "$expected_file_ino" "$expected_hash" <<'PY'
import ctypes
import hashlib
import os
import stat
import sys

temporary, directory, expected_dev, expected_ino, expected_file_dev, expected_file_ino, expected_hash = sys.argv[1:]
directory_fd = os.open(
    directory,
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    directory_info = os.fstat(directory_fd)
    if expected_dev and (str(directory_info.st_dev), str(directory_info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(1)
    temporary_name = os.path.basename(temporary)
    source_fd = os.open(
        temporary_name,
        os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
        dir_fd=directory_fd,
    )
    try:
        info = os.fstat(source_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise SystemExit(1)
        if expected_file_dev and (str(info.st_dev), str(info.st_ino)) != (expected_file_dev, expected_file_ino):
            raise SystemExit(1)
        if expected_hash:
            digest = hashlib.sha256()
            while True:
                chunk = os.read(source_fd, 65536)
                if not chunk:
                    break
                digest.update(chunk)
            os.lseek(source_fd, 0, os.SEEK_SET)
            if digest.hexdigest() != expected_hash:
                raise SystemExit(1)
        libc = ctypes.CDLL(None, use_errno=True)
        libc.linkat.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_int]
        libc.linkat.restype = ctypes.c_int
        if libc.linkat(-100, f"/proc/self/fd/{source_fd}".encode(), directory_fd,
                      b"eci_active", 0x400) != 0:
            raise OSError(ctypes.get_errno(), "descriptor-anchored marker install failed")
        try:
            marker_fd = os.open(
                "eci_active",
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
                dir_fd=directory_fd,
            )
        except OSError:
            os.unlink("eci_active", dir_fd=directory_fd)
            raise SystemExit(1)
        try:
            installed = os.fstat(marker_fd)
            if (
                not stat.S_ISREG(installed.st_mode)
                or installed.st_nlink != 2
                or installed.st_dev != info.st_dev
                or installed.st_ino != info.st_ino
            ):
                os.unlink("eci_active", dir_fd=directory_fd)
                raise SystemExit(1)
        finally:
            os.close(marker_fd)
        try:
            current = os.stat(temporary_name, dir_fd=directory_fd, follow_symlinks=False)
        except FileNotFoundError:
            current = None
        if current is not None and (current.st_dev, current.st_ino) == (info.st_dev, info.st_ino):
            os.unlink(temporary_name, dir_fd=directory_fd)
    finally:
        os.close(source_fd)
finally:
    os.close(directory_fd)
PY
}

marker_scope=""
marker_cwd=""
marker_owner=""
marker_created=""
marker_canonical_path=""
marker_owner_dir=""
marker_generation=""
marker_owner_dev=""
marker_owner_ino=""
recovery_artifact=""
recovery_count=""
recovery_lock=""
recovery_lock_owner=""
recovery_lock_token=""
recovery_lock_lease_seconds=60
recovery_lock_pid=""
recovery_lock_start=""
recovery_lock_lease_until=""
recovery_lock_token_on_disk=""
recovery_lock_dev=""
recovery_lock_ino=""
observed_lock_dev=""
observed_lock_ino=""
recovery_lock_removable_token=""
heartbeat_pid=""
marker_is_legacy=false

validate_eci_marker_identity() {
  local marker="$1"
  local last_byte cwd_canonical current_cwd_canonical root marker_canonical owner_dir owner_identity
  local -a lines=()

  [ -f "$marker" ] && [ ! -L "$marker" ] || return 1
  marker_bytes_are_safe "$marker" || return 1
  last_byte="$(tail -c 1 -- "$marker" 2>/dev/null | od -An -t x1 | tr -d ' \n' || true)"
  [ "$last_byte" = 0a ] || return 1
  mapfile -t lines <"$marker" || return 1
  [ "${#lines[@]}" -eq 4 ] || return 1
  [[ "${lines[0]}" == "scope: "* ]] || return 1
  [[ "${lines[1]}" == "cwd: "* ]] || return 1
  [[ "${lines[2]}" == "session_id: "* ]] || return 1
  [[ "${lines[3]}" == "created_utc: "* ]] || return 1

  marker_scope="${lines[0]#scope: }"
  marker_cwd="${lines[1]#cwd: }"
  marker_owner="${lines[2]#session_id: }"
  marker_created="${lines[3]#created_utc: }"
  [ -n "$marker_scope" ] && [ -n "$marker_cwd" ] || return 1
  marker_has_no_control "$marker_scope" || return 1
  marker_has_no_control "$marker_cwd" || return 1
  marker_has_no_control "$marker_owner" || return 1
  marker_has_no_control "$marker_created" || return 1
  [[ "$marker_cwd" = /* ]] || return 1
  cwd_canonical="$(canonical_path "$marker_cwd" || true)"
  [ -n "$cwd_canonical" ] || return 1
  current_cwd_canonical="$(canonical_path "$PWD" || true)"
  [ -n "$current_cwd_canonical" ] && [ "$cwd_canonical" = "$current_cwd_canonical" ] || return 1
  codex_valid_session_id "$marker_owner" || return 1
  codex_reserved_proof_dir "$marker_owner" && return 1
  [[ "$marker_created" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || return 1
  [ "$(date -u -d "$marker_created" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || true)" = "$marker_created" ] || return 1

  root="$(canonical_path "$(codex_proof_root)" || true)"
  marker_canonical="$(canonical_path "$marker" || true)"
  [ -n "$root" ] && [ -n "$marker_canonical" ] || return 1
  root_is_stable || return 1
  owner_dir="$root/$marker_owner"
  [ "$marker_canonical" = "$owner_dir/eci_active" ] || return 1
  [ -d "$owner_dir" ] && [ ! -L "$owner_dir" ] || return 1
  [ -f "$marker_canonical" ] && [ ! -L "$marker_canonical" ] || return 1
  owner_identity="$(stat -Lc '%d:%i' -- "$owner_dir" 2>/dev/null || true)"
  [ -n "$owner_identity" ] || return 1
  marker_owner_dev="${owner_identity%%:*}"
  marker_owner_ino="${owner_identity#*:}"
  [[ "$marker_owner_dev" =~ ^[0-9]+$ ]] &&
    [[ "$marker_owner_ino" =~ ^[0-9]+$ ]] || return 1

  marker_canonical_path="$marker_canonical"
  marker_owner_dir="$owner_dir"
  marker_generation="$(hash_file "$marker_canonical" || true)"
  [[ "$marker_generation" =~ ^[0-9a-f]{64}$ ]] || return 1
  recovery_artifact="$owner_dir/eci-stop-loop-recovery.$marker_generation.json"
  recovery_count="$owner_dir/eci-stop-loop-recovery.$marker_generation.timestamps"
  recovery_lock="$owner_dir/eci-stop-loop-recovery.$marker_generation.lock"
  recovery_lock_owner="$recovery_lock/owner"
  marker_is_legacy=false
  return 0
}

validate_legacy_eci_marker_identity() {
  local marker="$1"
  local last_byte cwd_canonical current_cwd_canonical root marker_canonical owner_dir owner_identity
  local -a lines=()

  [ -f "$marker" ] && [ ! -L "$marker" ] || return 1
  marker_bytes_are_safe "$marker" || return 1
  last_byte="$(tail -c 1 -- "$marker" 2>/dev/null | od -An -t x1 | tr -d ' \n' || true)"
  [ "$last_byte" = 0a ] || return 1
  mapfile -t lines <"$marker" || return 1
  [ "${#lines[@]}" -eq 3 ] || [ "${#lines[@]}" -eq 4 ] || return 1
  [[ "${lines[0]}" == "scope: "* ]] || return 1
  [[ "${lines[1]}" == "cwd: "* ]] || return 1
  [[ "${lines[2]}" == "session_id: "* ]] || return 1

  marker_scope="${lines[0]#scope: }"
  marker_cwd="${lines[1]#cwd: }"
  marker_owner="${lines[2]#session_id: }"
  [ -n "$marker_scope" ] && [ -n "$marker_cwd" ] || return 1
  marker_has_no_control "$marker_scope" || return 1
  marker_has_no_control "$marker_cwd" || return 1
  marker_has_no_control "$marker_owner" || return 1
  [[ "$marker_cwd" = /* ]] || return 1
  cwd_canonical="$(canonical_path "$marker_cwd" || true)"
  [ -n "$cwd_canonical" ] || return 1
  current_cwd_canonical="$(canonical_path "$PWD" || true)"
  [ -n "$current_cwd_canonical" ] && [ "$cwd_canonical" = "$current_cwd_canonical" ] || return 1
  codex_valid_session_id "$marker_owner" || return 1
  codex_reserved_proof_dir "$marker_owner" || return 1
  if [ "${#lines[@]}" -eq 4 ]; then
    [[ "${lines[3]}" == "created_utc: "* ]] || return 1
    marker_created="${lines[3]#created_utc: }"
    marker_has_no_control "$marker_created" || return 1
    [[ "$marker_created" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || return 1
    [ "$(date -u -d "$marker_created" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || true)" = "$marker_created" ] || return 1
  fi

  root="$(canonical_path "$(codex_proof_root)" || true)"
  marker_canonical="$(canonical_path "$marker" || true)"
  [ -n "$root" ] && [ -n "$marker_canonical" ] || return 1
  root_is_stable || return 1
  owner_dir="$root/$marker_owner"
  [ "$marker_canonical" = "$owner_dir/eci_active" ] || return 1
  [ -d "$owner_dir" ] && [ ! -L "$owner_dir" ] || return 1
  [ -f "$marker_canonical" ] && [ ! -L "$marker_canonical" ] || return 1
  owner_identity="$(stat -Lc '%d:%i' -- "$owner_dir" 2>/dev/null || true)"
  [ -n "$owner_identity" ] || return 1
  marker_owner_dev="${owner_identity%%:*}"
  marker_owner_ino="${owner_identity#*:}"
  [[ "$marker_owner_dev" =~ ^[0-9]+$ ]] &&
    [[ "$marker_owner_ino" =~ ^[0-9]+$ ]] || return 1

  marker_canonical_path="$marker_canonical"
  marker_owner_dir="$owner_dir"
  marker_generation="$(hash_file "$marker_canonical" || true)"
  [[ "$marker_generation" =~ ^[0-9a-f]{64}$ ]] || return 1
  recovery_artifact="$owner_dir/eci-stop-loop-recovery.$marker_generation.json"
  recovery_count="$owner_dir/eci-stop-loop-recovery.$marker_generation.timestamps"
  recovery_lock="$owner_dir/eci-stop-loop-recovery.$marker_generation.lock"
recovery_lock_owner="$recovery_lock/owner"
  marker_is_legacy=true
  return 0
}

owner_dir_is_stable() {
  local identity

  root_is_stable || return 1
  [ -d "$marker_owner_dir" ] && [ ! -L "$marker_owner_dir" ] || return 1
  identity="$(stat -Lc '%d:%i' -- "$marker_owner_dir" 2>/dev/null || true)"
  [ "$identity" = "$marker_owner_dev:$marker_owner_ino" ]
}

recovery_paths_are_safe() {
  root_is_stable || return 1
  owner_dir_is_stable || return 1
  [ ! -L "$recovery_artifact" ] || return 1
  [ ! -L "$recovery_count" ] || return 1
  [ ! -L "$recovery_lock" ] || return 1
  if [ -e "$recovery_artifact" ] && [ ! -f "$recovery_artifact" ]; then
    return 1
  fi
  if [ -e "$recovery_count" ] && [ ! -f "$recovery_count" ]; then
    return 1
  fi
  if [ -e "$recovery_lock" ] && [ ! -d "$recovery_lock" ] && [ ! -f "$recovery_lock" ]; then
    return 1
  fi
  if [ -e "$recovery_lock_owner" ] && { [ ! -f "$recovery_lock_owner" ] || [ -L "$recovery_lock_owner" ]; }; then
    return 1
  fi
  for state_path in "$recovery_artifact" "$recovery_count" "$recovery_lock_owner"; do
    if [ -e "$state_path" ] && [ "$(stat -c '%h' -- "$state_path" 2>/dev/null || printf '0')" -ne 1 ]; then
      return 1
    fi
  done
  if [ -f "$recovery_lock" ] &&
    [ "$(stat -c '%h' -- "$recovery_lock" 2>/dev/null || printf '0')" -ne 1 ]; then
    return 1
  fi
  return 0
}

remove_generation_temps() {
  local path

  for path in \
    "$marker_owner_dir/.eci-stop-loop-recovery-count.$marker_generation."* \
    "$marker_owner_dir/.eci-stop-loop-recovery-artifact.$marker_generation."*; do
    if [ -L "$path" ]; then
      return 1
    fi
    [ -e "$path" ] || continue
    [ -f "$path" ] && [ "$(stat -c '%h' -- "$path" 2>/dev/null || printf '0')" -eq 1 ] || return 1
    remove_regular_in_directory "$path" "$marker_owner_dir" \
      "$marker_owner_dev" "$marker_owner_ino" || return 1
  done
  return 0
}

recovery_lock_directory_is_removable() {
  local lock_dir="$1"
  local owner_file="$lock_dir/owner"
  local snapshot pid start lease token now current_start owner_mtime
  local -a fields=()

  recovery_lock_removable_token=""
  [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] || return 1
  if [ ! -e "$owner_file" ]; then
    return 0
  fi
  [ -f "$owner_file" ] && [ ! -L "$owner_file" ] || return 1
  [ "$(stat -c '%h' -- "$owner_file" 2>/dev/null || printf '0')" -eq 1 ] || return 1
  snapshot="$(python3 - "$owner_file" <<'PY'
import os
import stat
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > 4096:
        raise SystemExit(1)
    data = os.read(fd, 4097)
finally:
    os.close(fd)
if len(data) > 4096 or not data.endswith(b"\n"):
    raise SystemExit(1)
if any(byte < 0x20 and byte != 0x0a for byte in data) or 0x7f in data:
    raise SystemExit(1)
lines = data.decode("ascii").splitlines()
if len(lines) != 4 or [line.split(":", 1)[0] for line in lines] != ["pid", "start_time", "lease_until", "token"]:
    raise SystemExit(1)
values = [line.split(": ", 1)[1] for line in lines]
if not values[0].isdigit() or not values[1].isdigit() or not values[2].isdigit() or len(values[3]) != 64:
    raise SystemExit(1)
if any(char not in "0123456789abcdef" for char in values[3]):
    raise SystemExit(1)
print("\n".join(values))
PY
)" || return 1
  mapfile -t fields <<<"$snapshot" || return 1
  [ "${#fields[@]}" -eq 4 ] || return 1
  pid="${fields[0]}"
  start="${fields[1]}"
  lease="${fields[2]}"
  token="${fields[3]}"
  now="$(date +%s)"
  [ "$lease" -lt "$now" ] || return 1
  current_start="$(process_start_time "$pid" 2>/dev/null || true)"
  owner_mtime="$(stat -c '%Y' -- "$owner_file" 2>/dev/null || printf '0')"
  if [ "$current_start" = "$start" ] && kill -0 "$pid" 2>/dev/null &&
    [ "$now" -lt $((owner_mtime + recovery_lock_lease_seconds * 2)) ]; then
    return 1
  fi
  recovery_lock_removable_token="$token"
  return 0
}

remove_all_recovery_generations() {
  local skip_current_lock="${1:-false}"
  local path base identity path_dev path_ino lock_identity lock_dev lock_ino
  local -a paths=()

  shopt -s nullglob
  paths=(
    "$marker_owner_dir"/eci-stop-loop-recovery.*
    "$marker_owner_dir"/.eci-stop-loop-recovery-count.*
    "$marker_owner_dir"/.eci-stop-loop-recovery-artifact.*
  )
  shopt -u nullglob
  for path in "${paths[@]}"; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    [ ! -L "$path" ] || return 1
    base="${path##*/}"
    case "$base" in
      *.lock)
        if [ "$skip_current_lock" = true ] && [ "$path" = "$recovery_lock" ]; then
          continue
        fi
        if [ -d "$path" ]; then
          recovery_lock_directory_is_removable "$path" || return 1
          lock_identity="$(stat -Lc '%d:%i' -- "$path" 2>/dev/null || true)"
          [[ "$lock_identity" == *:* ]] || return 1
          lock_dev="${lock_identity%%:*}"
          lock_ino="${lock_identity#*:}"
          remove_lock_directory_in_directory "$marker_owner_dir" "$base" \
            "$marker_owner_dev" "$marker_owner_ino" "$lock_dev" "$lock_ino" \
            "$recovery_lock_removable_token" || return 1
        elif [ -f "$path" ]; then
          [ "$(stat -c '%h' -- "$path" 2>/dev/null || printf '0')" -eq 1 ] || return 1
          identity="$(stat -Lc '%d:%i' -- "$path" 2>/dev/null || true)"
          path_dev="${identity%%:*}"
          path_ino="${identity#*:}"
          remove_regular_in_directory "$path" "$marker_owner_dir" \
            "$marker_owner_dev" "$marker_owner_ino" 1 "$path_dev" "$path_ino" || return 1
        else
          return 1
        fi
        ;;
      eci-stop-loop-recovery.*|.eci-stop-loop-recovery-count.*|.eci-stop-loop-recovery-artifact.*)
        [ -f "$path" ] && [ "$(stat -c '%h' -- "$path" 2>/dev/null || printf '0')" -eq 1 ] || return 1
        identity="$(stat -Lc '%d:%i' -- "$path" 2>/dev/null || true)"
        [[ "$identity" == *:* ]] || return 1
        path_dev="${identity%%:*}"
        path_ino="${identity#*:}"
        remove_regular_in_directory "$path" "$marker_owner_dir" \
          "$marker_owner_dev" "$marker_owner_ino" 1 "$path_dev" "$path_ino" || return 1
        ;;
      *)
        return 1
        ;;
    esac
  done
  return 0
}

process_start_time() {
  local pid="$1"

  python3 - "$pid" <<'PY'
import pathlib
import sys

record = pathlib.Path("/proc") / sys.argv[1] / "stat"
data = record.read_bytes()
tail = data.rsplit(b")", 1)[-1].split()
print(tail[19].decode("ascii"))
PY
}

read_lock_metadata_snapshot() {
  python3 - "$recovery_lock_owner" <<'PY'
import os
import stat
import sys

fd = os.open(sys.argv[1], os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > 4096:
        raise SystemExit(1)
    data = os.read(fd, 4097)
finally:
    os.close(fd)
if len(data) > 4096 or not data.endswith(b"\n"):
    raise SystemExit(1)
if any(byte < 0x20 and byte != 0x0a for byte in data) or 0x7f in data:
    raise SystemExit(1)
lines = data.decode("ascii").splitlines()
if len(lines) != 4:
    raise SystemExit(1)
if not all(line.startswith(prefix) for line, prefix in zip(
    lines, ("pid: ", "start_time: ", "lease_until: ", "token: ")
)):
    raise SystemExit(1)
print("\n".join(lines))
PY
}

lock_metadata_valid() {
  local now snapshot
  local -a fields=()

  [ -f "$recovery_lock_owner" ] && [ ! -L "$recovery_lock_owner" ] || return 1
  snapshot="$(read_lock_metadata_snapshot 2>/dev/null)" || return 1
  mapfile -t fields <<<"$snapshot" || return 1
  [ "${#fields[@]}" -eq 4 ] || return 1
  [[ "${fields[0]}" == "pid: "* ]] || return 1
  [[ "${fields[1]}" == "start_time: "* ]] || return 1
  [[ "${fields[2]}" == "lease_until: "* ]] || return 1
  [[ "${fields[3]}" == "token: "* ]] || return 1
  recovery_lock_pid="${fields[0]#pid: }"
  recovery_lock_start="${fields[1]#start_time: }"
  recovery_lock_lease_until="${fields[2]#lease_until: }"
  recovery_lock_token_on_disk="${fields[3]#token: }"
  [[ "$recovery_lock_pid" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$recovery_lock_start" =~ ^[0-9]+$ ]] || return 1
  [[ "$recovery_lock_lease_until" =~ ^[0-9]+$ ]] || return 1
  [[ "$recovery_lock_token_on_disk" =~ ^[0-9a-f]{64}$ ]] || return 1
  now="$(date +%s)"
  [ "$recovery_lock_lease_until" -le $((now + recovery_lock_lease_seconds * 2)) ] || return 1
  return 0
}

lock_is_stale() {
  local now lock_mtime age current_start lock_identity owner_mtime stale_token=""

  [ -d "$recovery_lock" ] && [ ! -L "$recovery_lock" ] || return 1
  lock_identity="$(stat -Lc '%d:%i' -- "$recovery_lock" 2>/dev/null || true)"
  [[ "$lock_identity" == *:* ]] || return 1
  observed_lock_dev="${lock_identity%%:*}"
  observed_lock_ino="${lock_identity#*:}"
  recovery_lock_token_on_disk=""
  now="$(date +%s)"
  if lock_metadata_valid; then
    stale_token="$recovery_lock_token_on_disk"
    [ "$recovery_lock_lease_until" -lt "$now" ] || return 1
    current_start="$(process_start_time "$recovery_lock_pid" 2>/dev/null || true)"
    owner_mtime="$(stat -c '%Y' -- "$recovery_lock_owner" 2>/dev/null || printf '0')"
    if [ "$current_start" = "$recovery_lock_start" ] && kill -0 "$recovery_lock_pid" 2>/dev/null &&
      [ "$now" -lt $((owner_mtime + recovery_lock_lease_seconds * 2)) ]; then
      return 1
    fi
    recovery_lock_token_on_disk="$stale_token"
    return 0
  fi
  lock_mtime="$(stat -c '%Y' -- "$recovery_lock" 2>/dev/null || printf '0')"
  age=$((now - lock_mtime))
  [ "$age" -ge $((recovery_lock_lease_seconds * 2)) ] ||
    [ "$age" -le $((-recovery_lock_lease_seconds * 2)) ]
}

reclaim_stale_lock() {
  local current_identity observed_token

  lock_is_stale || return 1
  observed_token="${recovery_lock_token_on_disk:-}"
  [ -d "$recovery_lock" ] && [ ! -L "$recovery_lock" ] || return 1
  current_identity="$(stat -Lc '%d:%i' -- "$recovery_lock" 2>/dev/null || true)"
  [ "$current_identity" = "$observed_lock_dev:$observed_lock_ino" ] || return 1
  if [ -n "$observed_token" ]; then
    lock_metadata_valid || return 1
    [ "$recovery_lock_token_on_disk" = "$observed_token" ] || return 1
  fi
  remove_lock_directory_in_directory "$marker_owner_dir" \
    "$(basename "$recovery_lock")" "$marker_owner_dev" \
    "$marker_owner_ino" "$observed_lock_dev" "$observed_lock_ino" "$observed_token" 2>/dev/null
}

write_lock_owner() {
  local now start owner_tmp owner_tmp_record owner_tmp_identity owner_tmp_dev owner_tmp_ino owner_tmp_token owner_tmp_hash lock_identity

  start="$(process_start_time "$$" 2>/dev/null || true)"
  [ -n "$start" ] || return 1
  lock_identity="$(stat -Lc '%d:%i' -- "$recovery_lock" 2>/dev/null || true)"
  [ -n "$lock_identity" ] || return 1
  recovery_lock_dev="${lock_identity%%:*}"
  recovery_lock_ino="${lock_identity#*:}"
  now="$(date +%s)"
  recovery_lock_token="$(printf '%s:%s:%s:%s' "$marker_owner" "$$" "$start" "$now" | sha256sum | awk '{print $1}')"
  owner_tmp_record="$(create_temp_in_directory "$recovery_lock" "$recovery_lock_dev" \
    "$recovery_lock_ino" '.owner.' 2>/dev/null || true)"
  owner_tmp="${owner_tmp_record%%|*}"
  owner_tmp_identity="${owner_tmp_record#*|}"
  owner_tmp_dev="${owner_tmp_identity%%:*}"
  owner_tmp_ino="${owner_tmp_identity#*:}"
  owner_tmp_ino="${owner_tmp_ino%%|*}"
  owner_tmp_token="${owner_tmp_record##*|}"
  [ -n "$owner_tmp" ] && [[ "$owner_tmp_record" == *'|'*'|'* ]] || return 1
  [ -n "$owner_tmp" ] || return 1
  if ! {
    printf 'pid: %s\n' "$$"
    printf 'start_time: %s\n' "$start"
    printf 'lease_until: %s\n' "$((now + recovery_lock_lease_seconds))"
    printf 'token: %s\n' "$recovery_lock_token"
  } | write_existing_temp_in_directory "$owner_tmp" 600 "$recovery_lock" \
    "$recovery_lock_dev" "$recovery_lock_ino" "$owner_tmp_dev" "$owner_tmp_ino" "$owner_tmp_token"; then
    remove_regular_in_directory "$owner_tmp" "$recovery_lock" \
      "$recovery_lock_dev" "$recovery_lock_ino" 1 "$owner_tmp_dev" "$owner_tmp_ino"  "$owner_tmp_token" || true
    return 1
  fi
  owner_tmp_hash="$(hash_file "$owner_tmp" || true)"
  [[ "$owner_tmp_hash" =~ ^[0-9a-f]{64}$ ]] || return 1
  if ! link_temp_in_directory "$owner_tmp" "$recovery_lock_owner" "$recovery_lock" \
    "$recovery_lock_dev" "$recovery_lock_ino" "$owner_tmp_dev" "$owner_tmp_ino" "$owner_tmp_hash" 2>/dev/null; then
    remove_regular_in_directory "$owner_tmp" "$recovery_lock" \
      "$recovery_lock_dev" "$recovery_lock_ino" 1 "$owner_tmp_dev" "$owner_tmp_ino" "" "$owner_tmp_hash" || true
    return 1
  fi
  remove_regular_in_directory "$owner_tmp" "$recovery_lock" \
    "$recovery_lock_dev" "$recovery_lock_ino" 2 "$owner_tmp_dev" "$owner_tmp_ino" "" "$owner_tmp_hash" || return 1
  flush_directory "$recovery_lock" || true
  return 0
}

touch_lock_owner() {
  python3 - "$recovery_lock" "$recovery_lock_dev" "$recovery_lock_ino" <<'PY'
import os
import stat
import sys

lock_path, expected_dev, expected_ino = sys.argv[1:]
lock_fd = os.open(
    lock_path,
    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
)
try:
    info = os.fstat(lock_fd)
    if (str(info.st_dev), str(info.st_ino)) != (expected_dev, expected_ino):
        raise SystemExit(1)
    owner = os.stat("owner", dir_fd=lock_fd, follow_symlinks=False)
    if not stat.S_ISREG(owner.st_mode) or owner.st_nlink != 1:
        raise SystemExit(1)
    os.utime("owner", None, dir_fd=lock_fd, follow_symlinks=False)
    os.fsync(lock_fd)
finally:
    os.close(lock_fd)
PY
}

start_lock_heartbeat() {
  local parent_pid="$$"
  local parent_start

  parent_start="$(process_start_time "$parent_pid" 2>/dev/null || true)"
  [ -n "$parent_start" ] || return 1
  (
    while [ "$(process_start_time "$parent_pid" 2>/dev/null || true)" = "$parent_start" ] &&
      kill -0 "$parent_pid" 2>/dev/null; do
      sleep 1
      touch_lock_owner 2>/dev/null || exit 0
    done
  ) &
  heartbeat_pid="$!"
}

stop_lock_heartbeat() {
  if [ -n "${heartbeat_pid:-}" ]; then
    kill "$heartbeat_pid" 2>/dev/null || true
    wait "$heartbeat_pid" 2>/dev/null || true
    heartbeat_pid=""
  fi
}

acquire_recovery_lock() {
  local attempt

  for ((attempt = 1; attempt <= 40; attempt++)); do
    recovery_paths_are_safe || return 1
    if mkdir_in_directory "$marker_owner_dir" "$(basename "$recovery_lock")" \
      "$marker_owner_dev" "$marker_owner_ino" 2>/dev/null; then
      if write_lock_owner; then
        start_lock_heartbeat || {
          remove_lock_directory_in_directory "$marker_owner_dir" \
            "$(basename "$recovery_lock")" "$marker_owner_dev" \
            "$marker_owner_ino" "$recovery_lock_dev" "$recovery_lock_ino" \
            2>/dev/null || true
          return 1
        }
        return 0
      fi
      owner_dir_is_stable || return 1
      remove_lock_directory_in_directory "$marker_owner_dir" \
        "$(basename "$recovery_lock")" "$marker_owner_dev" \
        "$marker_owner_ino" "$recovery_lock_dev" "$recovery_lock_ino" \
        2>/dev/null || true
      return 1
    fi
    owner_dir_is_stable || return 1
    [ ! -L "$recovery_lock" ] && [ -d "$recovery_lock" ] || return 1
    if reclaim_stale_lock; then
      continue
    fi
    sleep 0.01
  done
  return 1
}

release_recovery_lock() {
  stop_lock_heartbeat
  if [ ! -d "$recovery_lock" ] || [ -L "$recovery_lock" ]; then
    return 0
  fi
  if lock_metadata_valid && [ "${recovery_lock_token_on_disk:-}" = "${recovery_lock_token:-}" ] &&
    [ "${recovery_lock_pid:-}" = "$$" ]; then
    remove_lock_directory_in_directory "$marker_owner_dir" \
      "$(basename "$recovery_lock")" "$marker_owner_dev" \
      "$marker_owner_ino" "$recovery_lock_dev" "$recovery_lock_ino" \
      "$recovery_lock_token" 2>/dev/null || true
  fi
}

validate_disengage_report() {
  local report="$1"
  local missing=""
  local marker_error=""
  local section

  for section in "Stop checklist walkthrough" "Incomplete compliance"; do
    if ! codex_markdown_section_has_body "$report" "$section"; then
      missing="$missing \"$section\""
    fi
  done

  if [ -n "$missing" ]; then
    echo "Disengage report missing non-empty ECI section(s):$missing" >&2
    return 1
  fi

  marker_error="$(codex_eci_terminal_verdict_error "Disengage report" "$report")"
  if [ -n "$marker_error" ]; then
    echo "$marker_error" >&2
    return 1
  fi

  if codex_markdown_section_has_body "$report" "ECI completion certificate"; then
    return 0
  fi

  local full_missing=""
  for section in \
    "Summary" \
    "Verification" \
    "Requirements" \
    "Root Cause" \
    "Claim Inventory" \
    "Pre-Mortem" \
    "Adversarial Critique" \
    "Rule-Compliance Self-Audit" \
    "Gaps"; do
    if ! codex_markdown_section_has_body "$report" "$section"; then
      full_missing="$full_missing \"$section\""
    fi
  done

  if [ -n "$full_missing" ]; then
    echo "Disengage report must include either a non-empty \"ECI completion certificate\" section or all full Codex stop-verification sections." >&2
    echo "Missing full stop-verification section(s):$full_missing" >&2
    return 1
  fi
}

remove_legacy_eci_markers_for_cwd() {
  local keep="${1:-}"
  local canonical_cwd keep_canonical

  [ -n "$root_path" ] && [ -n "$root_dev" ] && [ -n "$root_ino" ] || return 1
  canonical_cwd="$(codex_canonical_cwd "$PWD")" || return 1
  keep_canonical="$(canonical_path "$keep" 2>/dev/null || true)"
  python3 - "$root_path" "$root_dev" "$root_ino" "$canonical_cwd" "$keep_canonical" <<'PY'
import os
import stat
import sys

root, expected_dev, expected_ino, wanted_cwd, keep = sys.argv[1:]
reserved = {
    "activity", "audit", "eci", "history", "pre-reviewer", "reviewer",
    "reviewer-dumps", "side-stop", "skip-stop", "skills",
}

def is_reserved(name):
    return name in reserved or name.startswith("security-warnings-")

def root_is_current():
    try:
        info = os.stat(root, follow_symlinks=False)
    except OSError:
        return False
    return (stat.S_ISDIR(info.st_mode) and
            (str(info.st_dev), str(info.st_ino)) == (expected_dev, expected_ino))

def marker_matches(fd, expected_owner):
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        return False
    data = bytearray()
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        data.extend(chunk)
        if len(data) > 1048576:
            return False
    if (not data.endswith(b"\n") or b"\x00" in data or
            any(byte < 0x20 and byte != 0x0a for byte in data) or 0x7f in data):
        return False
    try:
        lines = bytes(data).decode("utf-8").splitlines()
    except UnicodeDecodeError:
        return False
    if len(lines) not in (3, 4) or not lines[0].startswith("scope: ") or \
            not lines[1].startswith("cwd: ") or not lines[2].startswith("session_id: "):
        return False
    scope = lines[0][len("scope: "):]
    marker_cwd = lines[1][len("cwd: "):]
    marker_owner = lines[2][len("session_id: "):]
    if not scope or not marker_cwd or marker_owner != expected_owner or not is_reserved(marker_owner):
        return False
    if not marker_cwd.startswith("/") or os.path.realpath(marker_cwd) != wanted_cwd:
        return False
    if len(lines) == 4:
        if not lines[3].startswith("created_utc: "):
            return False
        created = lines[3][len("created_utc: "):]
        try:
            parsed = __import__("datetime").datetime.strptime(created, "%Y-%m-%dT%H:%M:%SZ")
        except ValueError:
            return False
        if parsed.strftime("%Y-%m-%dT%H:%M:%SZ") != created:
            return False
    return True

flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
root_fd = os.open(root, flags)
changed = False
invalid = False
try:
    root_info = os.fstat(root_fd)
    if ((str(root_info.st_dev), str(root_info.st_ino)) != (expected_dev, expected_ino) or
            not root_is_current()):
        raise SystemExit(1)
    for name in sorted(os.listdir(root_fd)):
        if not is_reserved(name):
            continue
        try:
            session_info = os.stat(name, dir_fd=root_fd, follow_symlinks=False)
        except FileNotFoundError:
            continue
        if not stat.S_ISDIR(session_info.st_mode):
            continue
        try:
            session_fd = os.open(name, flags, dir_fd=root_fd)
        except OSError:
            continue
        try:
            opened_session = os.fstat(session_fd)
            if (opened_session.st_dev, opened_session.st_ino) != (session_info.st_dev, session_info.st_ino):
                continue
            try:
                marker_info = os.stat("eci_active", dir_fd=session_fd, follow_symlinks=False)
            except FileNotFoundError:
                continue
            if stat.S_ISLNK(marker_info.st_mode):
                continue
            if not stat.S_ISREG(marker_info.st_mode) or marker_info.st_nlink != 1:
                invalid = True
                continue
            marker_path = os.path.join(root, name, "eci_active")
            if os.path.normpath(marker_path) == os.path.normpath(keep):
                continue
            marker_fd = os.open("eci_active", os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0), dir_fd=session_fd)
            try:
                opened_marker = os.fstat(marker_fd)
                if ((opened_marker.st_dev, opened_marker.st_ino) != (marker_info.st_dev, marker_info.st_ino) or
                        not marker_matches(marker_fd, name)):
                    invalid = True
                    continue
            finally:
                os.close(marker_fd)
            if not root_is_current():
                raise SystemExit(1)
            current_session = os.stat(name, dir_fd=root_fd, follow_symlinks=False)
            if (not stat.S_ISDIR(current_session.st_mode) or
                    (current_session.st_dev, current_session.st_ino) != (session_info.st_dev, session_info.st_ino)):
                raise SystemExit(1)
            current_marker = os.stat("eci_active", dir_fd=session_fd, follow_symlinks=False)
            if ((not stat.S_ISREG(current_marker.st_mode) or current_marker.st_nlink != 1) or
                    (current_marker.st_dev, current_marker.st_ino) != (marker_info.st_dev, marker_info.st_ino)):
                raise SystemExit(1)
            os.unlink("eci_active", dir_fd=session_fd)
            os.fsync(session_fd)
            changed = True
        finally:
            os.close(session_fd)
    if changed:
        if not root_is_current():
            raise SystemExit(1)
        os.fsync(root_fd)
finally:
    os.close(root_fd)
if invalid:
    raise SystemExit(2)
PY
}

cmd="${1:-}"
case "$cmd" in
  on)
    shift
    scope="${*:-}"
    [ -n "$scope" ] || { usage; exit 2; }
    marker_has_no_control "$scope" || {
      echo "ECI scope contains control characters; refusing to create a malformed marker." >&2
      exit 1
    }
    capture_root_identity || {
      echo "ECI proof root is not a stable canonical directory." >&2
      exit 1
    }
    session_dir="$(resolve_session_dir true)" || {
      echo "eci-active: no session directory found under $(codex_proof_root)" >&2
      exit 1
    }
    root_is_stable || exit 1
    ensure_session_directory "${session_dir##*/}" || {
      echo "Unable to create or validate the ECI session directory safely." >&2
      exit 1
    }
    marker="$session_dir/eci_active"
    if [ -L "$session_dir" ] || { [ -e "$session_dir" ] && [ ! -d "$session_dir" ]; }; then
      echo "ECI session directory is an unsafe symlink or non-directory: $session_dir" >&2
      exit 1
    fi
    root_is_stable || {
      echo "ECI proof root changed during activation." >&2
      exit 1
    }
    if [ -L "$marker" ]; then
      echo "ECI marker is a symlink; refusing to replace it: $marker" >&2
      exit 1
    fi
    if [ -e "$marker" ]; then
      echo "ECI marker already exists; refusing a non-atomic generation replacement: $marker" >&2
      exit 1
    fi
    [ -d "$session_dir" ] && [ ! -L "$session_dir" ] || {
      echo "ECI session directory is not a canonical directory: $session_dir" >&2
      exit 1
    }
    owner_identity="$(stat -Lc '%d:%i' -- "$session_dir" 2>/dev/null || true)"
    [ -n "$owner_identity" ] || {
      echo "Unable to identify the ECI session directory safely." >&2
      exit 1
    }
    marker_owner_dev="${owner_identity%%:*}"
    marker_owner_ino="${owner_identity#*:}"
    [[ "$marker_owner_dev" =~ ^[0-9]+$ ]] &&
      [[ "$marker_owner_ino" =~ ^[0-9]+$ ]] || {
        echo "Unable to identify the ECI session directory safely." >&2
        exit 1
      }
    remove_stale_marker_temps "$session_dir" "$marker_owner_dev" "$marker_owner_ino" || {
      echo "Unable to safely clean stale ECI marker temporaries." >&2
      exit 1
    }
    canonical_cwd="$(codex_canonical_cwd "$PWD")"
    marker_tmp_record="$(create_temp_in_directory "$session_dir" "$marker_owner_dev" \
      "$marker_owner_ino" '.eci_active.' 2>/dev/null || true)"
    marker_tmp="${marker_tmp_record%%|*}"
    marker_tmp_identity="${marker_tmp_record#*|}"
    marker_tmp_dev="${marker_tmp_identity%%:*}"
    marker_tmp_ino="${marker_tmp_identity#*:}"
    marker_tmp_ino="${marker_tmp_ino%%|*}"
    marker_tmp_token="${marker_tmp_record##*|}"
    [ -n "$marker_tmp" ] && [[ "$marker_tmp_record" == *'|'*'|'* ]] || {
      echo "Unable to allocate a private ECI marker temporary file." >&2
      exit 1
    }
    root_is_stable || {
      remove_regular_in_directory "$marker_tmp" "$session_dir" \
        "$marker_owner_dev" "$marker_owner_ino" 1 "$marker_tmp_dev" "$marker_tmp_ino" || true
      echo "ECI proof root alias or parent changed before marker installation." >&2
      exit 1
    }
    if ! {
      printf 'scope: %s\n' "$scope"
      printf 'cwd: %s\n' "$canonical_cwd"
      printf 'session_id: %s\n' "${session_dir##*/}"
      date -u '+created_utc: %Y-%m-%dT%H:%M:%SZ'
    } | write_existing_temp_in_directory "$marker_tmp" 600 "$session_dir" \
      "$marker_owner_dev" "$marker_owner_ino" "$marker_tmp_dev" "$marker_tmp_ino" "$marker_tmp_token"; then
      remove_regular_in_directory "$marker_tmp" "$session_dir" \
        "$marker_owner_dev" "$marker_owner_ino" 1 "$marker_tmp_dev" "$marker_tmp_ino" "$marker_tmp_token" || true
      echo "Unable to write the ECI marker safely." >&2
      exit 1
    fi
    marker_tmp_hash="$(hash_file "$marker_tmp" || true)"
    [[ "$marker_tmp_hash" =~ ^[0-9a-f]{64}$ ]] || {
      remove_regular_in_directory "$marker_tmp" "$session_dir" \
        "$marker_owner_dev" "$marker_owner_ino" 1 "$marker_tmp_dev" "$marker_tmp_ino" "" "$marker_tmp_token" || true
      echo "Unable to hash the ECI marker safely." >&2
      exit 1
    }
    if ! install_marker_no_overwrite "$marker_tmp" "$session_dir" \
      "$marker_owner_dev" "$marker_owner_ino" "$marker_tmp_dev" "$marker_tmp_ino" "$marker_tmp_hash" 2>/dev/null; then
      remove_regular_in_directory "$marker_tmp" "$session_dir" \
        "$marker_owner_dev" "$marker_owner_ino" 1 "$marker_tmp_dev" "$marker_tmp_ino" "" "$marker_tmp_hash" || true
      echo "ECI marker installation raced or already exists: $marker" >&2
      exit 1
    fi
    remove_regular_in_directory "$marker_tmp" "$session_dir" \
      "$marker_owner_dev" "$marker_owner_ino" 2 "$marker_tmp_dev" "$marker_tmp_ino" "" "$marker_tmp_hash" || {
        echo "Unable to remove the private ECI marker temporary safely." >&2
        exit 1
      }
    flush_directory "$session_dir" || {
      echo "Unable to flush the installed ECI marker directory." >&2
      exit 1
    }
    if ! root_is_stable; then
      remove_regular_in_directory "$marker" "$session_dir" \
        "$marker_owner_dev" "$marker_owner_ino" 1 || true
      flush_directory "$session_dir" || true
      echo "ECI proof-root alias or parent changed during activation; marker was not retained." >&2
      exit 1
    fi
    remove_legacy_eci_markers_for_cwd "$marker" || {
      legacy_cleanup_status="$?"
      [ "$legacy_cleanup_status" -eq 2 ] || {
        echo "Unable to safely inventory legacy ECI markers during activation." >&2
        exit 1
      }
    }
    root_is_stable || {
      echo "ECI proof-root alias or parent changed during activation cleanup." >&2
      exit 1
    }
    printf 'ECI active: %s\n' "$marker"
    ;;
  off)
    report="${2:-}"
    markers=()
    [ -n "$report" ] || { usage; exit 2; }
    [ -f "$report" ] || { echo "Disengage report not found: $report" >&2; exit 1; }
    capture_root_identity || {
      echo "ECI proof root is not a stable canonical directory." >&2
      exit 1
    }
    session_dir="$(resolve_session_dir)" || {
      echo "eci-active: no session directory found under $(codex_proof_root)" >&2
      exit 1
    }
    root_is_stable || {
      echo "ECI proof root changed while resolving the ECI session." >&2
      exit 1
    }
    marker="$session_dir/eci_active"
    [ -f "$marker" ] && markers+=("$marker")
    legacy_marker_output="$(legacy_eci_markers_for_cwd_safe 2>/dev/null)" || {
      echo "ECI legacy marker inventory is malformed or unsafe; refusing cleanup." >&2
      exit 1
    }
    while IFS= read -r legacy_marker; do
      [ -n "$legacy_marker" ] || continue
      [ "$legacy_marker" = "$marker" ] && continue
      markers+=("$legacy_marker")
    done <<<"$legacy_marker_output"
    [ "${#markers[@]}" -gt 0 ] || { echo "ECI marker is not active: $marker" >&2; exit 1; }
    validate_disengage_report "$report"
    marker_records=()
    declare -A seen_markers=()
    for marker in "${markers[@]}"; do
      marker_mode="current"
      if ! validate_eci_marker_identity "$marker"; then
        validate_legacy_eci_marker_identity "$marker" || {
          echo "ECI marker is malformed, legacy, or not owned by its canonical session path: $marker" >&2
          exit 1
        }
        marker_mode="legacy"
      fi
      recovery_paths_are_safe || {
        echo "ECI recovery state has an unsafe symlink or conflicting path for: $marker" >&2
        exit 1
      }
      if [ -n "${seen_markers[$marker_canonical_path]+x}" ]; then
        continue
      fi
      seen_markers["$marker_canonical_path"]=1
      marker_records+=("$marker_canonical_path|$marker_mode|$marker_generation")
    done
    for record in "${marker_records[@]}"; do
      IFS='|' read -r record_marker record_mode record_generation <<<"$record"
      if [ "$record_mode" = current ]; then
        validate_eci_marker_identity "$record_marker" || {
          echo "ECI marker changed or became invalid before cleanup: $record_marker" >&2
          exit 1
        }
      else
        validate_legacy_eci_marker_identity "$record_marker" || {
          echo "Legacy ECI marker changed or became invalid before cleanup: $record_marker" >&2
          exit 1
        }
      fi
      [ "$marker_canonical_path" = "$record_marker" ] &&
        [ "$marker_generation" = "$record_generation" ] || {
          echo "ECI marker generation changed before cleanup: $record_marker" >&2
          exit 1
        }
      recovery_paths_are_safe || {
        echo "ECI recovery state became unsafe before cleanup: $record_marker" >&2
        exit 1
      }

      lock_held=false
      if [ "$record_mode" = current ] &&
        { [ ! -e "$recovery_lock" ] || [ -d "$recovery_lock" ]; }; then
        acquire_recovery_lock || {
          echo "ECI recovery lock is busy or cannot be safely reclaimed: $recovery_lock" >&2
          exit 1
        }
        lock_held=true
        if [ "$record_mode" = current ]; then
          validate_eci_marker_identity "$record_marker" || {
            release_recovery_lock
            echo "ECI marker changed while waiting for cleanup lock: $record_marker" >&2
            exit 1
          }
        else
          validate_legacy_eci_marker_identity "$record_marker" || {
            release_recovery_lock
            echo "Legacy ECI marker changed while waiting for cleanup lock: $record_marker" >&2
            exit 1
          }
        fi
        [ "$marker_canonical_path" = "$record_marker" ] &&
          [ "$marker_generation" = "$record_generation" ] || {
            release_recovery_lock
            echo "ECI marker generation changed while waiting for cleanup lock: $record_marker" >&2
            exit 1
          }
        recovery_paths_are_safe || {
          release_recovery_lock
          echo "ECI recovery state became unsafe while holding cleanup lock: $record_marker" >&2
          exit 1
        }
      elif [ "$record_mode" = legacy ] && [ -d "$recovery_lock" ]; then
        acquire_recovery_lock || {
          echo "Legacy ECI recovery lock is busy or cannot be safely reclaimed: $recovery_lock" >&2
          exit 1
        }
        lock_held=true
        validate_legacy_eci_marker_identity "$record_marker" || {
          release_recovery_lock
          echo "Legacy ECI marker changed while waiting for cleanup lock: $record_marker" >&2
          exit 1
        }
        [ "$marker_canonical_path" = "$record_marker" ] &&
          [ "$marker_generation" = "$record_generation" ] || {
            release_recovery_lock
            echo "Legacy ECI marker generation changed while waiting for cleanup lock: $record_marker" >&2
            exit 1
          }
        recovery_paths_are_safe || {
          release_recovery_lock
          echo "Legacy ECI recovery state became unsafe while holding cleanup lock: $record_marker" >&2
          exit 1
        }
      fi

      remove_generation_temps || {
        [ "$lock_held" = true ] && release_recovery_lock
        echo "Refusing to remove unsafe ECI recovery temporary state: $marker_owner_dir" >&2
        exit 1
      }
      remove_all_recovery_generations "$lock_held" || {
        [ "$lock_held" = true ] && release_recovery_lock
        echo "Refusing to remove unsafe ECI recovery generation state: $marker_owner_dir" >&2
        exit 1
      }

      for path in "$recovery_artifact" "$recovery_count"; do
        [ -e "$path" ] || continue
        [ -f "$path" ] && [ ! -L "$path" ] &&
          [ "$(stat -c '%h' -- "$path" 2>/dev/null || printf '0')" -eq 1 ] || {
            [ "$lock_held" = true ] && release_recovery_lock
            echo "Refusing to remove unsafe ECI recovery state: $path" >&2
            exit 1
          }
        remove_regular_in_directory "$path" "$marker_owner_dir" \
          "$marker_owner_dev" "$marker_owner_ino" || {
          [ "$lock_held" = true ] && release_recovery_lock
          exit 1
        }
      done
      if [ -e "$recovery_lock" ] && [ ! -d "$recovery_lock" ]; then
        [ -f "$recovery_lock" ] && [ ! -L "$recovery_lock" ] &&
          [ "$(stat -c '%h' -- "$recovery_lock" 2>/dev/null || printf '0')" -eq 1 ] || {
            [ "$lock_held" = true ] && release_recovery_lock
            echo "Refusing to remove unsafe ECI recovery lock state: $recovery_lock" >&2
            exit 1
          }
        remove_regular_in_directory "$recovery_lock" "$marker_owner_dir" \
          "$marker_owner_dev" "$marker_owner_ino" || {
          [ "$lock_held" = true ] && release_recovery_lock
          exit 1
        }
      fi
      [ -f "$record_marker" ] && [ ! -L "$record_marker" ] || {
        [ "$lock_held" = true ] && release_recovery_lock
        echo "Refusing to remove an unsafe ECI marker: $record_marker" >&2
        exit 1
      }
      [ "$(stat -c '%h' -- "$record_marker" 2>/dev/null || printf '0')" -eq 1 ] || {
        [ "$lock_held" = true ] && release_recovery_lock
        echo "Refusing to remove a multiply-linked ECI marker: $record_marker" >&2
        exit 1
      }
      remove_regular_in_directory "$record_marker" "$marker_owner_dir" \
        "$marker_owner_dev" "$marker_owner_ino" || {
        [ "$lock_held" = true ] && release_recovery_lock
        exit 1
      }
      [ "$lock_held" = true ] && release_recovery_lock
      flush_directory "$marker_owner_dir" || {
        echo "Unable to durably flush ECI cleanup directory: $marker_owner_dir" >&2
        exit 1
      }
    done
    printf 'ECI inactive. Disengage report validated: %s\n' "$report"
    ;;
  status)
    capture_root_identity || {
      echo "ECI proof root is not a stable canonical directory." >&2
      exit 1
    }
    session_dir="$(resolve_session_dir)" || {
      echo "eci-active: no session directory found under $(codex_proof_root)" >&2
      exit 1
    }
    root_is_stable || {
      echo "ECI proof root changed while reading status." >&2
      exit 1
    }
    marker="$session_dir/eci_active"
    if [ -e "$marker" ] || [ -L "$marker" ]; then
      validate_eci_marker_identity "$marker" || {
        echo "ECI current marker is malformed, unowned, or changed while reading status: $marker" >&2
        exit 1
      }
      root_is_stable || {
        echo "ECI proof root changed while validating status." >&2
        exit 1
      }
      cat_marker_from_root_safe "$marker" || {
        echo "ECI current marker is unsafe or changed while reading status: $marker" >&2
        exit 1
      }
      exit 0
    fi
    legacy_marker_output="$(legacy_eci_markers_for_cwd_safe 2>/dev/null)" || {
      echo "ECI legacy marker inventory is malformed or unsafe; refusing status." >&2
      exit 1
    }
    legacy_marker="$(printf '%s\n' "$legacy_marker_output" | head -n1)"
    if [ -n "$legacy_marker" ]; then
      cat_marker_from_root_safe "$legacy_marker" || {
        echo "ECI legacy marker is unsafe or changed while reading status: $legacy_marker" >&2
        exit 1
      }
    else
      echo "ECI inactive"
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac
