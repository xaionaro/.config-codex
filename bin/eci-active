#!/usr/bin/env bash
# Session-owned ECI coordination commands. Lifecycle belongs to the Supervisor.
# TODO: Restore deferred coordination mutators only after their owning hook
# validators stop depending on legacy markers. Reject before publishing state.

set -euo pipefail

cmd="${1:-}"
script_path="$(realpath -e -- "${BASH_SOURCE[0]}" 2>/dev/null || true)"
[ -n "$script_path" ] || script_path="${BASH_SOURCE[0]}"
base_dir="$(cd "$(dirname "$script_path")/.." && pwd -P)"
runtime_state_library="$(realpath -e -- "$base_dir/hooks/lib/codex-proof-state.sh" 2>/dev/null || true)"
if [ -n "$runtime_state_library" ] && [ -f "$runtime_state_library" ]; then
  # Share concrete session and filesystem ownership checks.
  . "$runtime_state_library"
fi
case "${base_dir##*/}" in
  .codex) lifecycle_usage_command='"$HOME/.codex/bin/eci-active"' ;;
  .kimi-code) lifecycle_usage_command='"${KIMI_CODE_HOME:-$HOME/.kimi-code}/bin/eci-active"' ;;
  *) lifecycle_usage_command="$(printf '%q' "${BASH_SOURCE[0]}")" ;;
esac

usage() {
  cat >&2 <<EOF
Usage:
  $lifecycle_usage_command ledger-append --json <event-object>
  $lifecycle_usage_command manifest-write \${TMPDIR:-\$HOME/tmp}/<...>/eci-required-critics.json.source
  $lifecycle_usage_command aggregate-review <prewrite|final> <repo-id>
  $lifecycle_usage_command coordinator-edit-status
  $lifecycle_usage_command repository-allow-status
  $lifecycle_usage_command permissive-on global <gate> <operation> <request> <ttl-seconds>
  $lifecycle_usage_command permissive-off <session|global> <gate> <operation> <request>
  $lifecycle_usage_command permissive-status <session|global> <gate> <operation> <request>
  $lifecycle_usage_command maintain-planner
  $lifecycle_usage_command accidental-override-cleanup --authorized-by-user <canonical-proof-root-claim>
  $lifecycle_usage_command sync-runtime
  $lifecycle_usage_command status

Set CODEX_SESSION_ID, or CODEX_THREAD_ID when CODEX_SESSION_ID is
unset, to target a session. Lifecycle commands are retired; the native goal owns continuation and the
Supervisor owns ECI lifecycle. Coordination uses explicit session identity
and the current working directory.
Marker-dependent coordination mutators are deferred until their hooks migrate.
EOF
}

read_only_status() {
  printf '%s\n' 'ECI lifecycle is managed by the Supervisor; native goals own continuation.'
}

# R11: ECI is an accidental-deviation aid, not adversarial path provenance.
# Read-only discovery resolves and reports the executable/state it can read;
# mutation paths below validate their real current-session targets instead.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
case "$cmd" in
coordinator-edit-on|repository-allow-on|repository-allow-off|aggregate-migrate|aggregate-stage|aggregate-manifest-write|aggregate-commit)
  printf '%s\n' '[ECI_COORDINATION_DEFERRED] This mutator depends on legacy hook marker validation; no state was changed.' >&2
  exit 2
  ;;
permissive-on)
  if [ "${2:-}" = session ]; then
    printf '%s\n' '[ECI_COORDINATION_DEFERRED] Session permissive validation depends on the legacy hook marker; no state was changed.' >&2
    exit 2
  fi
  ;;
status)
  read_only_status
  exit 0
  ;;
on|off|wait|wait-repair|resume|nested-enter|nested-accept|nested-exit|aggregate-off)
  printf '%s\n' '[ECI_LIFECYCLE_RETIRED] Native goals own continuation; the Supervisor owns ECI lifecycle.' >&2
  exit 2
  ;;
--help|-h)
  usage 2>&1
  exit 0
  ;;
esac
fi

[ -n "$runtime_state_library" ] && [ -f "$runtime_state_library" ] || {
  printf '[ECI_ACTIVE_RUNTIME_UNAVAILABLE] coordination requires the resolved local runtime helper: %s/hooks/lib/codex-proof-state.sh\n' "$base_dir" >&2
  exit 2
}
. "$runtime_state_library"

validate_proof_root() {
  local root="$1"
  local parent

  case "$root" in
  /*) ;;
  *)
    echo "ECI proof root must be an absolute path: $root" >&2
    return 1
    ;;
  esac
  [ "$root" = "$(codex_proof_root)" ] || {
    echo "ECI proof root does not match the configured root: $root" >&2
    return 1
  }
  parent="$(dirname -- "$root")"
  if [ -L "$root" ] || {
    { [ -e "$parent" ] || [ -L "$parent" ]; } && [ ! -d "$parent" ]
  }; then
    echo "ECI proof root or its parent is unsafe: $root" >&2
    return 1
  fi
  if [ -e "$root" ] && [ ! -d "$root" ]; then
    echo "ECI proof root is not a directory: $root" >&2
    return 1
  fi
  codex_proof_root_is_safe || {
    echo "ECI proof root is unsafe: $root" >&2
    return 1
  }
}

validate_session_dir() {
  local root="$1"
  local session_id="$2"
  local session_dir="$root/$session_id"

  validate_proof_root "$root" || return 1
  [ -d "$root" ] || return 0
  codex_session_dir_is_safe "$root" "$session_id" || {
    echo "ECI session directory is a symlink; refusing to use it: $session_dir" >&2
    return 1
  }
  [ ! -e "$session_dir" ] || [ -d "$session_dir" ] || {
    echo "ECI session directory is not a directory: $session_dir" >&2
    return 1
  }
}

acquire_eci_mutation_lock() {
  local root lock_path

  root="$(codex_proof_root)"
  codex_proof_root_is_safe || {
    echo "ECI proof root is unsafe; refusing state mutation." >&2
    return 1
  }
  [ -d "$root" ] || {
    echo "ECI proof root is unavailable; refusing state mutation." >&2
    return 1
  }
  lock_path="$(codex_eci_lock_path 2>/dev/null || true)"
  [ -n "$lock_path" ] || return 1
  if [ -L "$lock_path" ] || { [ -e "$lock_path" ] && [ ! -f "$lock_path" ]; }; then
    echo "ECI mutation lock is unsafe: $lock_path" >&2
    return 1
  fi
  if ! exec {eci_lock_fd}>>"$lock_path"; then
    echo "ECI mutation lock is unavailable: $lock_path" >&2
    return 1
  fi
  if ! flock -n "$eci_lock_fd" 2>/dev/null; then
    eval "exec ${eci_lock_fd}>&-" 2>/dev/null || true
    echo "ECI mutation lock is busy; refusing state mutation: $lock_path" >&2
    return 1
  fi
  trap 'flock -u "$eci_lock_fd" 2>/dev/null || true; eval "exec ${eci_lock_fd}>&-"' EXIT
}

run_eci_review_gate() {
  local phase="$1"
  local session_id="$2"
  local gate_status

  # Pass the actual lock FD, never a caller-controlled boolean receipt.  The
  # gate verifies that FD 9 resolves to the canonical lock and is held.
  if [ -n "${eci_lock_fd:-}" ]; then
    eval "exec 9>&$eci_lock_fd"
    if ECI_REVIEW_GATE_FD=9 ECI_REVIEW_CWD="$PWD" \
      "$base_dir/hooks/eci-review-gate.sh" "$phase" "$session_id"; then
      gate_status=0
    else
      gate_status=$?
    fi
    eval 'exec 9>&-'
    return "$gate_status"
  else
    if ECI_REVIEW_CWD="$PWD" "$base_dir/hooks/eci-review-gate.sh" "$phase" "$session_id"; then
      return 0
    else
      return $?
    fi
  fi
}

run_aggregate_review_gate() {
  local phase="$1" session_id="$2" repo_id="$3" aggregate_outer_cwd="$4" gate_status

  [ "$aggregate_outer_cwd" = "$(codex_canonical_cwd "$aggregate_outer_cwd")" ] || return 1
  if [ -n "${eci_lock_fd:-}" ]; then
    eval "exec 9>&$eci_lock_fd"
    if (
      cd -- "$aggregate_outer_cwd" &&
        ECI_REVIEW_GATE_FD=9 ECI_AGGREGATE_REPO_ID="$repo_id" \
          ECI_AGGREGATE_PARENT_CWD="$aggregate_outer_cwd" ECI_REVIEW_CWD="$aggregate_outer_cwd" \
          "$base_dir/hooks/eci-review-gate.sh" "$phase" "$session_id"
    ); then
      gate_status=0
    else
      gate_status=$?
    fi
    eval 'exec 9>&-'
    return "$gate_status"
  fi
  (
    cd -- "$aggregate_outer_cwd" &&
      ECI_AGGREGATE_REPO_ID="$repo_id" ECI_AGGREGATE_PARENT_CWD="$aggregate_outer_cwd" \
        ECI_REVIEW_CWD="$aggregate_outer_cwd" "$base_dir/hooks/eci-review-gate.sh" "$phase" "$session_id"
  )
}

resolve_session_dir() {
  local root name newest="" newest_mtime=0 d mtime session_id session_var
  local reject_reserved="${1:-false}"
  root="$(codex_proof_root)"
  validate_proof_root "$root" || return 1

  if [ -n "${CODEX_SESSION_ID:-}" ]; then
    session_id="$CODEX_SESSION_ID"
    session_var="CODEX_SESSION_ID"
  elif [ -n "${CODEX_THREAD_ID:-}" ]; then
    session_id="$CODEX_THREAD_ID"
    session_var="CODEX_THREAD_ID"
  fi

  if [ -n "${session_id:-}" ]; then
    codex_valid_session_id "$session_id" || {
      echo "Invalid $session_var; use only letters, digits, '_' or '-'." >&2
      exit 1
    }
    if [ "$reject_reserved" = true ] && codex_reserved_proof_dir "$session_id"; then
      echo "Reserved $session_var cannot be activated: $session_id" >&2
      exit 1
    fi
    validate_session_dir "$root" "$session_id" || return 1
    printf '%s/%s\n' "$root" "$session_id"
    return
  fi

  echo 'ECI coordination requires an explicit CODEX_SESSION_ID or CODEX_THREAD_ID.' >&2
  return 1
}

ledger_log_name='high_level_log.jsonl'
ledger_anchor_name='high_level_log.anchor'
ledger_max_bytes=1048576

ledger_sha256() {
  local path="$1"
  sha256sum -- "$path" 2>/dev/null | awk '{print $1}'
}

ledger_bytes() {
  wc -c <"$1" 2>/dev/null
}

ledger_path_is_safe() {
  local session_dir="$1" path="$session_dir/$ledger_log_name"
  [ -d "$session_dir" ] && [ ! -L "$session_dir" ] || return 1
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
  [ "$(realpath -m -- "$path" 2>/dev/null || true)" = "$path" ] || return 1
  return 0
}

ledger_link_count() {
  local path="$1" links

  links="$(stat -c '%h' -- "$path" 2>/dev/null || true)"
  [[ "$links" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' "$links"
}

ledger_path_is_mutable() {
  local session_dir="$1" path="$session_dir/$ledger_log_name" links

  ledger_path_is_safe "$session_dir" || return 1
  links="$(ledger_link_count "$path")" || return 1
  [ "$links" -eq 1 ]
}

# A hard link is safe to read as current-session history, but appending would
# mutate every linked name. Replace only this session entry with a copied
# regular file before a lifecycle write, leaving the other inode names intact.
ledger_detach_hardlinked_log() {
  local session_dir="$1" log="$session_dir/$ledger_log_name" tmp links

  ledger_path_is_safe "$session_dir" || return 1
  links="$(ledger_link_count "$log")" || return 1
  [ "$links" -eq 1 ] && return 0

  tmp="$log.tmp.$$"
  [ ! -e "$tmp" ] && [ ! -L "$tmp" ] || return 1
  if ! (
    umask 077
    set -C
    cat -- "$log" >"$tmp"
  ); then
    rm -f -- "$tmp"
    return 1
  fi
  ledger_path_is_safe "$session_dir" || {
    rm -f -- "$tmp"
    return 1
  }
  links="$(ledger_link_count "$log")" || {
    rm -f -- "$tmp"
    return 1
  }
  [ "$links" -gt 1 ] || {
    rm -f -- "$tmp"
    return 1
  }
  mv -T -- "$tmp" "$log" || {
    rm -f -- "$tmp"
    return 1
  }
  ledger_path_is_mutable "$session_dir"
}

ledger_create_empty_log() {
  local session_dir="$1" log="$session_dir/$ledger_log_name"

  [ -d "$session_dir" ] && [ ! -L "$session_dir" ] || return 1
  [ ! -e "$log" ] && [ ! -L "$log" ] || return 1
  # noclobber gives the fresh-log case a create-if-absent boundary. The
  # caller already holds the ECI mutation lock; a racing pre-existing path is
  # rejected rather than truncated or followed.
  if ! (umask 077; set -C; : >"$log"); then
    return 1
  fi
  ledger_path_is_safe "$session_dir" || return 1
  [ "$(ledger_bytes "$log")" = 0 ]
}

ledger_write_anchor() {
  local session_dir="$1" log="$session_dir/$ledger_log_name"
  local replace="${2:-false}"
  local anchor="$session_dir/$ledger_anchor_name"
  local tmp="$anchor.tmp.$$"
  local bytes hash

  ledger_path_is_safe "$session_dir" || return 1
  if [ "$replace" = true ]; then
    [ -f "$anchor" ] && [ ! -L "$anchor" ] || return 1
  else
    [ ! -e "$anchor" ] && [ ! -L "$anchor" ] || return 1
  fi
  [ ! -e "$tmp" ] && [ ! -L "$tmp" ] || return 1
  bytes="$(ledger_bytes "$log")"
  hash="$(ledger_sha256 "$log")"
  [[ "$bytes" =~ ^[0-9]+$ ]] || return 1
  [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || return 1
  if ! (
    set -C
    {
      printf 'schema: eci-high-level-log-anchor/v1\n'
      printf 'session_id: %s\n' "${session_dir##*/}"
      printf 'log_path: %s\n' "$log"
      printf 'bytes: %s\n' "$bytes"
      printf 'sha256: %s\n' "$hash"
    } >"$tmp"
  ); then
    rm -f -- "$tmp"
    return 1
  fi
  mv -- "$tmp" "$anchor" || {
    rm -f -- "$tmp"
    return 1
  }
  [ -f "$anchor" ] && [ ! -L "$anchor" ]
}

ledger_validate_anchor() {
  local session_dir="$1" log="$session_dir/$ledger_log_name"
  local anchor="$session_dir/$ledger_anchor_name"
  local bytes prefix_hash full_hash anchor_hash current_bytes
  local -a lines=()

  ledger_path_is_safe "$session_dir" || return 1
  [ -f "$anchor" ] && [ ! -L "$anchor" ] || return 1
  [ "$(realpath -m -- "$anchor" 2>/dev/null || true)" = "$anchor" ] || return 1
  [ "$(ledger_bytes "$anchor")" -le 4096 ] || return 1
  mapfile -t lines <"$anchor" || return 1
  [ "${#lines[@]}" -eq 5 ] || return 1
  [ "${lines[0]}" = 'schema: eci-high-level-log-anchor/v1' ] || return 1
  [ "${lines[1]}" = "session_id: ${session_dir##*/}" ] || return 1
  [ "${lines[2]}" = "log_path: $log" ] || return 1
  [[ "${lines[3]}" =~ ^bytes:\ [0-9]+$ ]] || return 1
  [[ "${lines[4]}" =~ ^sha256:\ [0-9a-f]{64}$ ]] || return 1
  bytes="${lines[3]#bytes: }"
  anchor_hash="${lines[4]#sha256: }"
  current_bytes="$(ledger_bytes "$log")"
  [[ "$current_bytes" =~ ^[0-9]+$ ]] && [ "$current_bytes" -le "$ledger_max_bytes" ] || return 1
  [ "$current_bytes" -ge "$bytes" ] || return 1
  if [ "$bytes" -eq 0 ]; then
    prefix_hash="$(printf '' | sha256sum | awk '{print $1}')"
  else
    prefix_hash="$(head -c "$bytes" -- "$log" | sha256sum | awk '{print $1}')"
  fi
  [ "$prefix_hash" = "$anchor_hash" ] || return 1
  if [ "$current_bytes" -gt "$bytes" ]; then
    # A crash after the append but before anchor publication is recoverable:
    # the old digest still proves the complete old prefix. Publish the new
    # full-file digest before accepting another append.
    ledger_write_anchor "$session_dir" true || return 1
  else
    full_hash="$(ledger_sha256 "$log")"
    [ "$full_hash" = "$anchor_hash" ] || return 1
  fi
}

ledger_ensure_anchor() {
  local session_dir="$1" log="$session_dir/$ledger_log_name"
  local anchor="$session_dir/$ledger_anchor_name"

  [ -d "$session_dir" ] && [ ! -L "$session_dir" ] || return 1
  if [ ! -e "$log" ] && [ ! -L "$log" ]; then
    ledger_create_empty_log "$session_dir" || {
      if [ -e "$log" ] || [ -L "$log" ]; then
        ledger_path_is_safe "$session_dir" || return 1
      else
        printf 'ECI advisory: high-level ledger bootstrap was unavailable; normal lifecycle work continues.\n' >&2
        return 0
      fi
    }
  fi
  ledger_path_is_safe "$session_dir" || return 1

  # The anchor records a convenient current digest for inspection; an old
  # malformed/stale regular record does not identify a dangerous operation.
  # Reconcile it under the caller's mutation lock instead of turning normal
  # activation or ledger append into a manual hash-recovery workflow.
  if [ -L "$anchor" ]; then
    # This is not a safe destination for an anchor refresh, but the current
    # regular log remains safe for normal lifecycle work. Never follow or
    # replace the link: retain it as diagnostic residue and continue.
    printf 'ECI advisory: high-level ledger anchor is a symlink; leaving it untouched while normal lifecycle work continues.\n' >&2
    return 0
  fi
  if [ -e "$anchor" ] || [ -L "$anchor" ]; then
    if [ ! -f "$anchor" ] || [ -L "$anchor" ]; then
      printf 'ECI advisory: high-level ledger anchor is not a regular file; leaving it untouched while normal lifecycle work continues.\n' >&2
      return 0
    fi
    ledger_write_anchor "$session_dir" true || {
      printf 'ECI advisory: high-level ledger anchor could not be refreshed; normal lifecycle work continues.\n' >&2
      return 0
    }
  else
    ledger_write_anchor "$session_dir" || {
      printf 'ECI advisory: high-level ledger anchor could not be initialized; normal lifecycle work continues.\n' >&2
      return 0
    }
  fi
}

# Import only to a fixed leaf of the already resolved current session. The Go
# helper keeps descriptor traversal and no-replace publication outside the
# shell's pathname-level copy operations.
safe_import_fixed_session_leaf() (
  local source="$1" session_dir="$2" leaf="$3" repo_id="${4:-}"
  local importer root provider importer_fd
  local -a arguments

  . "$base_dir/hooks/lib/eci-runtime-sync.sh"
  case "$base_dir" in
    "$(realpath -e -- "$HOME/.codex")") provider=codex ;;
    "$(realpath -e -- "${KIMI_CODE_HOME:-$HOME/.kimi-code}")") provider=kimi ;;
    *) return 1 ;;
  esac
  importer="$(eci_runtime_artifact_path "$provider" eci-safe-import)" || return 1
  if [ ! -f "$importer" ] || [ -L "$importer" ] || [ ! -x "$importer" ]; then
    eci_runtime_build_missing "$base_dir" eci-safe-import || return 1
  fi
  [ -f "$importer" ] && [ ! -L "$importer" ] && [ -x "$importer" ] || return 1
  root="$(codex_proof_root)"
  arguments=(--proof-root "$root" --session-dir "$session_dir" --leaf "$leaf" --source "$source")
  [ -z "$repo_id" ] || arguments+=(--repo-id "$repo_id")
  exec {importer_fd}<"$importer" || return 1
  "/proc/self/fd/$importer_fd" "${arguments[@]}"
)

require_main_lifecycle_owner() {
  # Direct current-session lifecycle operations are role-neutral: their live
  # marker/CWD target is the accidental-mistake boundary.  This helper is only
  # for aggregate, multi-session control operations, where a worker could
  # otherwise accidentally publish or clear another lane's aggregate state.
  case "${CODEX_ROLE:-}" in
  "" | main | orchestrator | lead | coordinator) ;;
  *)
    echo 'Only the main/orchestrator may publish or clear ECI lifecycle state.' >&2
    exit 1
    ;;
  esac
}

require_main_coordinator_owner() {
  require_main_lifecycle_owner
  case "${CODEX_HOOK_IS_SUBAGENT:-false}" in
  true)
    echo 'Only the main/coordinator may clean an accidental-mistake override claim.' >&2
    exit 1
    ;;
  esac
}

require_main_approval_owner() {
  # This is not an ordinary lifecycle operation: it publishes a one-time Git
  # commit approval.  Keep it routed to the owner of that destructive external
  # action; direct current-session state remains role-neutral.
  case "${CODEX_ROLE:-}" in
  "" | main | orchestrator | lead | coordinator) ;;
  *)
    echo 'ECI_APPROVE_COMMIT_OWNER_DENIED: worker/subagent context cannot create a Git approval artifact; route approval through the main/orchestrator.' >&2
    exit 1
    ;;
  esac
  case "${CODEX_HOOK_IS_SUBAGENT:-false}" in
  true)
    echo 'ECI_APPROVE_COMMIT_OWNER_DENIED: worker/subagent context cannot create a Git approval artifact; route approval through the main/orchestrator.' >&2
    exit 1
    ;;
  esac
}

validate_accidental_override_claim_tombstone() {
  local claim="$1" original record entry owner expected count=0

  codex_eci_accidental_override_claim_path_is_canonical "$claim" || {
    echo "accidental-override-cleanup requires an existing canonical proof-root claim directory: $claim" >&2
    return 1
  }
  original="${claim%.claim}"
  [ ! -e "$original" ] && [ ! -L "$original" ] || {
    echo "accidental-override-cleanup refused an active or ambiguous claim; the original override record still exists: $original" >&2
    return 1
  }
  record="$claim/record"
  [ -s "$record" ] && [ ! -L "$record" ] || {
    echo "accidental-override-cleanup requires one nonempty regular tombstone record: $record" >&2
    return 1
  }
  codex_state_file_owner_is_valid "$record" || {
    echo "accidental-override-cleanup refused a tombstone with an invalid owner or link count: $record" >&2
    return 1
  }
  read -r owner < <(stat -Lc '%u' -- "$claim" 2>/dev/null || true)
  expected="${EUID:-$(id -u 2>/dev/null || printf '%s' -1)}"
  [ "$owner" = "$expected" ] || {
    echo "accidental-override-cleanup refused a claim directory with an invalid owner: $claim" >&2
    return 1
  }
  while IFS= read -r -d '' entry; do
    count=$((count + 1))
    [ "$entry" = "$record" ] || {
      echo "accidental-override-cleanup refused an ambiguous claim with extra entries: $claim" >&2
      return 1
    }
  done < <(find -P "$claim" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
  [ "$count" -eq 1 ] || {
    echo "accidental-override-cleanup requires exactly one nonempty tombstone record: $claim" >&2
    return 1
  }
}

cleanup_accidental_override_claim() {
  local claim="$1" record

  validate_accidental_override_claim_tombstone "$claim" || return 1
  acquire_eci_mutation_lock || return 1
  # Revalidate after taking the lock so an active consumer cannot race the
  # coordinator into deleting a newly published or partially claimed record.
  validate_accidental_override_claim_tombstone "$claim" || return 1
  record="$claim/record"
  rm -f -- "$record" || {
    echo "accidental-override-cleanup could not remove the tombstone: $record" >&2
    return 1
  }
  rmdir -- "$claim" || {
    echo "accidental-override-cleanup refused to remove a changed claim directory: $claim" >&2
    return 1
  }
  [ ! -e "$record" ] && [ ! -e "$claim" ] && [ ! -L "$claim" ] || {
    echo "accidental-override-cleanup could not verify claim removal: $claim" >&2
    return 1
  }
  printf 'Removed orphaned accidental-mistake override claim: %s\n' "$claim"
}

approval_git_safe() {
  codex_git_safe "$@"
}

approval_git_repo_context() {
  local requested="$1" actual git_dir_raw git_dir
  case "$requested" in
  /*) ;;
  *)
    echo "repo_root must be an absolute canonical path: $requested" >&2
    return 1
    ;;
  esac
  [ "$requested" = "$(realpath -m -- "$requested" 2>/dev/null || true)" ] || {
    echo "repo_root is not canonically spelled: $requested" >&2
    return 1
  }
  [ -d "$requested" ] && [ ! -L "$requested" ] || {
    echo "repo_root must be an existing non-symlink directory: $requested" >&2
    return 1
  }
  [ "$(realpath -e -- "$requested" 2>/dev/null || true)" = "$requested" ] || {
    echo "repo_root must resolve to itself without symlink aliases: $requested" >&2
    return 1
  }
  actual="$(approval_git_safe -C "$requested" rev-parse --show-toplevel 2>/dev/null || true)"
  actual="$(realpath -e -- "$actual" 2>/dev/null || true)"
  [ -n "$actual" ] && [ "$actual" = "$requested" ] || {
    echo "repo_root is not the canonical top-level of a Git worktree: $requested" >&2
    return 1
  }
  git_dir_raw="$(approval_git_safe -C "$requested" rev-parse --git-dir 2>/dev/null || true)"
  [ -n "$git_dir_raw" ] || {
    echo "Git did not return a worktree git directory: $requested" >&2
    return 1
  }
  case "$git_dir_raw" in
  /*) git_dir="$git_dir_raw" ;;
  *) git_dir="$requested/$git_dir_raw" ;;
  esac
  git_dir="$(realpath -e -- "$git_dir" 2>/dev/null || true)"
  [ -n "$git_dir" ] && [ "$git_dir" != / ] && [ ! -L "$git_dir" ] || {
    echo "Git directory is missing, noncanonical, or unsafe for repo_root=$requested" >&2
    return 1
  }
  APPROVAL_REPO_ROOT="$requested"
  APPROVAL_GIT_DIR="$git_dir"
}

validate_approval_commit_command() {
  # R11: This exact commit-command grammar is an adversarial parser assumption; it does not itself prevent a concrete
  # accidental deviation. Correct behavior is to allow ordinary direct commit forms after current staged-diff/repository confirmation, which is the real boundary.
  python3 - "$1" <<'PY'
import re
import shlex
import sys

command = sys.argv[1]
if not command:
    print("command is empty")
    raise SystemExit(1)
if any(ord(char) < 32 or ord(char) == 127 for char in command):
    print("command contains control characters; tabs/newlines are not allowed")
    raise SystemExit(1)
quote = None
escaped = False
for index, char in enumerate(command):
    if escaped:
        escaped = False
        continue
    if char == "\\" and quote != "'":
        escaped = True
        continue
    if quote == "'":
        if char == "'":
            quote = None
        continue
    if quote == '"':
        if char == '"':
            quote = None
        elif char in ("$", "`"):
            print("shell substitution marker is not allowed inside double quotes")
            raise SystemExit(1)
        continue
    if char in ("'", '"'):
        quote = char
        continue
    if char in (";", "&", "|", "(", ")", "<", ">", "`", "$"):
        print("shell operator or substitution marker is not allowed")
        raise SystemExit(1)
if quote is not None or escaped:
    print("shell quoting is unbalanced")
    raise SystemExit(1)
if not re.match(r"^git\s+commit(?:\s|$)", command):
    print("expected a direct literal 'git commit' invocation; wrappers, assignments, and alternate Git paths are not allowed")
    raise SystemExit(1)
try:
    tokens = shlex.split(command, posix=True)
except ValueError as exc:
    print("shell quoting is invalid: " + str(exc))
    raise SystemExit(1)
if len(tokens) < 2 or tokens[0] != "git" or tokens[1] != "commit":
    print("expected command tokens ['git', 'commit']")
    raise SystemExit(1)
value_options = {
    "-m", "--message", "-F", "--file", "--author", "--date", "--cleanup",
    "--trailer", "--fixup", "--squash", "--reuse-message", "-C",
    "--reedit-message", "--template", "-S", "--gpg-sign",
}
flag_options = {
    "-a", "--all", "-p", "--patch", "--no-verify", "--verify", "--signoff",
    "--amend", "--allow-empty", "--allow-empty-message", "--edit", "--no-edit",
    "--reset-author", "--only", "--include", "--no-post-rewrite", "--quiet",
    "-q", "--verbose", "-v", "--status", "--no-status",
}
index = 2
while index < len(tokens):
    token = tokens[index]
    if token == "--":
        print("pathspec arguments are outside the bounded approval grammar; action: stage intended paths explicitly with git add -- <paths>, then rerun approval with a plain git commit -m ... and no -a/-am/pathspec")
        raise SystemExit(1)
    if token in value_options:
        if index + 1 >= len(tokens) or not tokens[index + 1] or any(ord(char) < 32 or ord(char) == 127 for char in tokens[index + 1]):
            print("option %s requires one bounded printable value" % token)
            raise SystemExit(1)
        index += 2
        continue
    if any(token.startswith(option + "=") for option in value_options if option.startswith("--")):
        if token.endswith("="):
            print("option %s requires a non-empty value" % token.split("=", 1)[0])
            raise SystemExit(1)
        index += 1
        continue
    if token in flag_options:
        index += 1
        continue
    if token == "-am":
        print("unsupported or unbounded commit option: -am; action: stage intended paths explicitly with git add -- <paths>, then rerun approval with a plain git commit -m ... and no -a/-am/pathspec")
    else:
        print("unsupported or unbounded commit option: %s" % token)
    raise SystemExit(1)
print("ok")
PY
}

validate_approval_artifact() {
  local path="$1" expected_command="$2" repo_root="$3" git_dir="$4"
  local reason
  local -a lines=()
  # R11: This writable `authorized_by: user` artifact is an adversarial provenance assumption; it does not itself prevent a concrete
  # accidental deviation. Correct behavior is explicit confirmation of the current staged diff/command or self-repair; that diff/command is the real boundary.
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
  [ "$(realpath -m -- "$path" 2>/dev/null || true)" = "$path" ] || return 1
  [ "$(wc -c <"$path" 2>/dev/null || printf 999999)" -le 4096 ] || return 1
  mapfile -t lines <"$path" || return 1
  [ "${#lines[@]}" -eq 9 ] || return 1
  [ "${lines[0]}" = 'schema: codex-user-git-approval/v1' ] || return 1
  [ "${lines[1]}" = 'authorized_by: user' ] || return 1
  [ "${lines[2]}" = 'operation: commit' ] || return 1
  [ "${lines[3]}" = "repo_root: $repo_root" ] || return 1
  [ "${lines[4]}" = "git_dir: $git_dir" ] || return 1
  [ "${lines[5]}" = "command: $expected_command" ] || return 1
  case "${lines[6]}" in
  reason:\ *)
    reason="${lines[6]#reason: }"
    [ -n "$reason" ] && [ "${#reason}" -le 512 ] || return 1
    ;;
  *) return 1 ;;
  esac
  [[ "${lines[7]}" =~ ^approved_at:\ [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || return 1
  [ "${lines[8]}" = 'one_time: true' ] || return 1
}

write_approval_artifact() {
  local command="$1" repo_root="$2" git_dir="$3" path reason approved_at
  path="$repo_root/.git-commit-approved-once"
  [ ! -e "$path" ] && [ ! -L "$path" ] || {
    echo "approval artifact already exists and will not be overwritten: $path" >&2
    return 1
  }
  if approval_git_safe -C "$repo_root" ls-files --error-unmatch -- .git-commit-approved-once >/dev/null 2>&1; then
    echo "approval artifact path is tracked or staged and cannot be used: $path" >&2
    return 1
  fi
  reason='coordinator requested one-time direct git commit admission'
  approved_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  if ! (
    umask 077
    set -C
    {
      printf 'schema: codex-user-git-approval/v1\n'
      printf 'authorized_by: user\n'
      printf 'operation: commit\n'
      printf 'repo_root: %s\n' "$repo_root"
      printf 'git_dir: %s\n' "$git_dir"
      printf 'command: %s\n' "$command"
      printf 'reason: %s\n' "$reason"
      printf 'approved_at: %s\n' "$approved_at"
      printf 'one_time: true\n'
    } >"$path"
  ); then
    rm -f -- "$path"
    echo "could not atomically create approval artifact: $path" >&2
    return 1
  fi
  if ! validate_approval_artifact "$path" "$command" "$repo_root" "$git_dir"; then
    rm -f -- "$path"
    echo "created approval artifact failed schema validation and was removed: $path" >&2
    return 1
  fi
  printf 'ECI commit approval artifact created for exact command: %s\n' "$path"
}

manifest_temp_root() {
  local configured="${TMPDIR:-$HOME/tmp}" canonical
  case "$configured" in
  /*) ;;
  *) return 1 ;;
  esac
  case "$configured" in
  *[![:print:]]* | *//* | */./* | */../* | */.. | */.) return 1 ;;
  esac
  canonical="$(realpath -m -- "$configured" 2>/dev/null || true)"
  [ -n "$canonical" ] && [ "$canonical" = "$configured" ] || return 1
  [ "$canonical" != /tmp ] && [[ "$canonical" != /tmp/* ]] || return 1
  [ "$canonical" != / ] || return 1
  [ -d "$canonical" ] && [ ! -L "$canonical" ] || return 1
  printf '%s\n' "$canonical"
}

manifest_temp_source_is_safe() {
  local path="$1" temp_root canonical parent name
  # R11: This fixed temp path/name rule is an adversarial source-substitution assumption; it does not itself prevent a concrete
  # accidental deviation. Correct behavior is to normalize or warn on a readable source and enforce the selected session, destination, and manifest content scope.
  case "$path" in
  /*) ;;
  *) return 1 ;;
  esac
  case "$path" in
  *[![:print:]]* | *//* | */./* | */../* | */.. | */.) return 1 ;;
  esac
  canonical="$(realpath -m -- "$path" 2>/dev/null || true)"
  [ -n "$canonical" ] && [ "$canonical" = "$path" ] || return 1
  temp_root="$(manifest_temp_root 2>/dev/null || true)"
  [ -n "$temp_root" ] || return 1
  case "$path" in
  "$temp_root"/*) ;;
  *) return 1 ;;
  esac
  name="${path##*/}"
  [ "$name" = 'eci-required-critics.json.source' ] || return 1
  parent="${path%/*}"
  [ -d "$parent" ] && [ ! -L "$parent" ] || return 1
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
}

validate_manifest_for_write() {
  local path="$1" bytes last top_keys row_keys target_keys
  bytes="$(wc -c <"$path" 2>/dev/null || true)"
  case "$bytes" in '' | *[!0-9]*) return 1 ;; esac
  [ "$bytes" -le 65536 ] || return 1
  last="$(tail -c 1 -- "$path" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')"
  [ "$last" = 0a ] || return 1
  [ "$(awk 'END { print NR + 0 }' "$path" 2>/dev/null || printf 0)" -eq 1 ] || return 1
  LC_ALL=C grep -q $'\r' "$path" 2>/dev/null && return 1 || true
  jq -e . "$path" >/dev/null 2>&1 || return 1
  # R11: This canonical byte/order requirement is an adversarial parser assumption; it does not itself prevent a concrete
  # accidental deviation. Correct behavior is normalization/self-repair with warning, enforcing only the selected session, destination, and typed manifest scope.
  jq -c . "$path" | cmp -s - "$path" || return 1
  top_keys='["schema","current_target_id","current_target_kind","current_diff_artifact","current_diff_sha256","current_target_path","repo_root","git_dir","git_common_dir","base_oid","head_oid","staged_diff_sha256","worktree_diff_sha256","status_sha256","target_file_hashes","acceptance_version","targets","rows"]'
  row_keys='["target_id","target_kind","diff_artifact","diff_sha256","critic_role","gate_phase","child_identity","critic_provider","critic_semantic_role","critic_provenance","spawn_request_artifact","spawn_request_sha256","report_artifact","report_sha256","adjudication_artifact","adjudication_sha256","verdict","e2e_required","e2e_artifact","e2e_sha256","repo_root","git_dir","git_common_dir","base_oid","head_oid","staged_diff_sha256","worktree_diff_sha256","status_sha256","target_path","target_version","intention_artifact","intention_sha256","acceptance_version"]'
  target_keys='["target_id","target_kind","diff_artifact","diff_sha256","e2e_required","target_path","target_version"]'
  jq -e --argjson expected "$top_keys" --argjson rows_expected "$row_keys" --argjson targets_expected "$target_keys" '
    (keys_unsorted == $expected) and (.schema == "eci-required-critics/v2") and
    (.current_target_id | type == "string") and (.current_target_kind | type == "string") and
    (.current_diff_artifact | type == "string") and (.current_diff_sha256 | test("^[0-9a-f]{64}$")) and
    (.current_target_path | type == "string") and (.repo_root | type == "string") and
    (.git_dir | type == "string") and (.git_common_dir | type == "string") and
    (.base_oid | test("^[0-9a-f]{40,64}$")) and (.head_oid | test("^[0-9a-f]{40,64}$")) and
    (.staged_diff_sha256 | test("^[0-9a-f]{64}$")) and (.worktree_diff_sha256 | test("^[0-9a-f]{64}$")) and
    (.status_sha256 | test("^[0-9a-f]{64}$")) and (.target_file_hashes | type == "object") and
    (.acceptance_version | test("^[1-9][0-9]*$")) and (.targets | type == "array" and length > 0) and
    (.rows | type == "array" and length > 0) and
    all(.targets[]; keys_unsorted == $targets_expected and (.target_id | type == "string") and
      (.target_kind | . == "root" or . == "subtask" or . == "candidate-fix") and
      (.diff_artifact | type == "string") and (.diff_sha256 | test("^[0-9a-f]{64}$")) and
      (.e2e_required | type == "boolean") and (.target_path | type == "string") and
      (.target_version | test("^[0-9a-f]{64}$"))) and
    all(.rows[]; keys_unsorted == $rows_expected and (.target_id | type == "string") and
      (.target_kind | . == "root" or . == "subtask" or . == "candidate-fix") and
      (.diff_artifact | type == "string") and (.diff_sha256 | test("^[0-9a-f]{64}$")) and
      (.critic_role | . == "A" or . == "B" or . == "C") and
      (.gate_phase | . == "prewrite" or . == "postwrite") and (.child_identity | type == "string" and length > 0) and
      (.critic_provider | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")) and
      (.critic_semantic_role == ("ECI Critic " + .critic_role)) and
      (.critic_provenance | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9_.:/=-]{0,255}$")) and
      (.spawn_request_artifact | type == "string") and (.spawn_request_sha256 | test("^[0-9a-f]{64}$")) and
      (.report_artifact | type == "string") and (.report_sha256 | test("^[0-9a-f]{64}$")) and
      (.adjudication_artifact | type == "string") and (.adjudication_sha256 | test("^[0-9a-f]{64}$")) and
      (.verdict == "PASS") and (.e2e_required | type == "boolean") and
      (((.e2e_required and (.e2e_artifact | type == "string") and (.e2e_sha256 | test("^[0-9a-f]{64}$"))) or
        ((.e2e_required | not) and .e2e_artifact == null and .e2e_sha256 == null))) and
      (.repo_root | type == "string") and (.git_dir | type == "string") and (.git_common_dir | type == "string") and
      (.base_oid | test("^[0-9a-f]{40,64}$")) and (.head_oid | test("^[0-9a-f]{40,64}$")) and
      (.staged_diff_sha256 | test("^[0-9a-f]{64}$")) and (.worktree_diff_sha256 | test("^[0-9a-f]{64}$")) and
      (.status_sha256 | test("^[0-9a-f]{64}$")) and (.target_path | type == "string") and
      (.target_version | test("^[0-9a-f]{64}$")) and (.intention_artifact == null or (.intention_artifact | type == "string")) and
      (.intention_sha256 == null or (.intention_sha256 | test("^[0-9a-f]{64}$"))) and (.acceptance_version | test("^[1-9][0-9]*$")))
  ' "$path" >/dev/null 2>&1
}

aggregate_repo_id_is_valid() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$ ]]
}

aggregate_current_context() {
  local session_dir="$1"

  aggregate_marker=''
  aggregate_plan="$session_dir/eci-aggregate-plan.json"
  aggregate_outer_cwd="$(jq -r '.outer_cwd // empty' "$aggregate_plan")" || return 1
  codex_eci_aggregate_normal_evidence_is_absent "$session_dir" || return 1
  codex_eci_aggregate_plan_is_valid "$aggregate_plan" "${session_dir##*/}" \
    "$aggregate_outer_cwd" "$aggregate_marker"
}

aggregate_caller_is_selected_target() {
  local session_dir="$1" expected_repo_id="${2:-}" caller_cwd

  caller_cwd="$(codex_canonical_cwd "$PWD")"
  [ -n "$caller_cwd" ] && [ -d "$caller_cwd" ] && [ ! -L "$caller_cwd" ] || return 1
  [ "$caller_cwd" = "$aggregate_outer_cwd" ] && return 0
  codex_eci_aggregate_plan_select "$aggregate_plan" "${session_dir##*/}" \
    "$aggregate_outer_cwd" "$aggregate_marker" "$expected_repo_id" || return 1
  case "$caller_cwd" in
    "$codex_eci_aggregate_selected_root"|"$codex_eci_aggregate_selected_root"/*) return 0 ;;
    *) return 1 ;;
  esac
}

reject_normal_lifecycle_for_aggregate_session() {
  local session_dir="$1" lifecycle="$2"
  local plan="$session_dir/eci-aggregate-plan.json"

  # A plan file is ordinary local residue until it resolves a live aggregate
  # parent target for this invocation. Do not turn stale format, links, or
  # history into a singleton lifecycle denial; leave unsafe objects untouched.
  if aggregate_current_context "$session_dir"; then
    echo "ECI $lifecycle rejected an aggregate session; aggregate and singleton lifecycle state are mutually exclusive." >&2
    return 1
  fi
  if [ -e "$plan" ] || [ -L "$plan" ]; then
    printf 'ECI advisory: local aggregate-plan residue is not a live target for %s and remains diagnostic: %s\n' "$lifecycle" "$plan" >&2
  fi
}

permissive_context() {
  local scope="$1"
  permissive_session_id="${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}"
  permissive_cwd="$PWD"
  if [ "$scope" = session ]; then
    codex_valid_session_id "$permissive_session_id" || return 1
    permissive_session_dir="$(resolve_session_dir)" || return 1
    [ "${permissive_session_dir##*/}" = "$permissive_session_id" ] || return 1
    permissive_cwd="$(codex_canonical_cwd "$PWD")"
  elif [ "$scope" = global ]; then
    permissive_session_id="${permissive_session_id:-global}"
  else
    return 1
  fi
}

coordinator_edit_context() {
  local session_var=''

  coordinator_edit_session_id=''
  coordinator_edit_session_dir=''
  coordinator_edit_cwd=''
  coordinator_edit_marker=''
  if [ -n "${CODEX_SESSION_ID:-}" ]; then
    coordinator_edit_session_id="$CODEX_SESSION_ID"
    session_var=CODEX_SESSION_ID
  elif [ -n "${CODEX_THREAD_ID:-}" ]; then
    coordinator_edit_session_id="$CODEX_THREAD_ID"
    session_var=CODEX_THREAD_ID
  else
    echo 'Coordinator edit state requires an explicit CODEX_SESSION_ID or CODEX_THREAD_ID.' >&2
    return 1
  fi
  codex_valid_session_id "$coordinator_edit_session_id" || {
    echo "Coordinator edit state has an invalid $session_var." >&2
    return 1
  }
  coordinator_edit_session_dir="$(resolve_session_dir)" || {
    echo "Coordinator edit state has no session directory for $coordinator_edit_session_id." >&2
    return 1
  }
  [ "${coordinator_edit_session_dir##*/}" = "$coordinator_edit_session_id" ] || {
    echo "Coordinator edit state did not resolve the requested $session_var." >&2
    return 1
  }
  coordinator_edit_cwd="$(codex_canonical_cwd "$PWD")"
  [ -d "$coordinator_edit_cwd" ] && [ ! -L "$coordinator_edit_cwd" ] || {
    echo 'Coordinator edit state requires a real current working directory.' >&2
    return 1
  }
}

coordinator_edit_ttl_seconds=600

write_permissive_record() {
  local record="$1" scope="$2" session_id="$3" cwd="$4" gate="$5" operation="$6" request="$7" ttl="$8"
  local now expires tmp session_value='*' cwd_value='*'
  codex_eci_session_permissive_scope_is_valid "$scope" &&
    codex_eci_session_permissive_selector_is_valid "$gate" &&
    codex_eci_session_permissive_selector_is_valid "$operation" &&
    codex_eci_session_permissive_request_is_valid "$request" || return 1
  now="$(date -u '+%s')"; [[ "$now" =~ ^[0-9]{1,12}$ ]] || return 1
  expires=$((now + ttl))
  if [ "$scope" = session ]; then session_value="$session_id"; cwd_value="$(codex_canonical_cwd "$cwd")"; fi
  tmp="$record.tmp.$$"
  [ ! -e "$tmp" ] && [ ! -L "$tmp" ] || return 1
  if ! (set -C; {
    printf 'schema: eci-permissive-mode/v2\n'
    printf 'scope: %s\n' "$scope"
    printf 'session_id: %s\n' "$session_value"
    printf 'cwd: %s\n' "$cwd_value"
    printf 'gate: %s\n' "$gate"
    printf 'operation: %s\n' "$operation"
    printf 'issued_at_epoch: %s\n' "$now"
    printf 'expires_at_epoch: %s\n' "$expires"
    printf 'state: active\n'
  } >"$tmp"); then rm -f -- "$tmp"; return 1; fi
  chmod 600 -- "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -- "$tmp" "$record" || { rm -f -- "$tmp"; return 1; }
  codex_eci_session_permissive_record_is_valid "$scope" "$session_id" "$cwd" "$gate" "$operation" "$request" "$now"
}

repository_allow_context() {
  repository_allow_session_id="${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}"
  [ -n "$repository_allow_session_id" ] || {
    echo 'repository-allow requires an explicit CODEX_SESSION_ID or CODEX_THREAD_ID.' >&2
    return 1
  }
  codex_valid_session_id "$repository_allow_session_id" || {
    echo 'repository-allow has an invalid session identity.' >&2
    return 1
  }
  repository_allow_session_dir="$(resolve_session_dir)" || {
    echo "repository-allow has no session directory for $repository_allow_session_id." >&2
    return 1
  }
  [ "${repository_allow_session_dir##*/}" = "$repository_allow_session_id" ] || {
    echo 'repository-allow resolved a different session than the current identity.' >&2
    return 1
  }
  repository_allow_cwd="$(codex_canonical_cwd "$PWD")"
  [ -d "$repository_allow_cwd" ] && [ ! -L "$repository_allow_cwd" ] || {
    echo 'repository-allow requires a real current working directory.' >&2
    return 1
  }
}

repository_allow_record_path() {
  repository_allow_record="$(codex_eci_additional_repository_record_path "$repository_allow_session_id")" || {
    echo 'repository-allow state target is unsafe.' >&2
    return 1
  }
}

repository_allow_status() {
  local repository reason

  [ "$#" -eq 1 ] || { usage; exit 2; }
  repository_allow_context || exit 1
  repository_allow_record_path || exit 1
  if [ ! -e "$repository_allow_record" ] && [ ! -L "$repository_allow_record" ]; then
    printf 'ECI additional repository inactive\n'
    return 0
  fi
  codex_eci_additional_repository_record_is_valid \
    "$repository_allow_session_id" "$repository_allow_cwd" '' || {
    echo "ECI additional repository state is invalid: $repository_allow_record" >&2
    exit 1
  }
  repository="$(sed -n 's/^repository: //p' "$repository_allow_record")"
  reason="$(sed -n 's/^reason: //p' "$repository_allow_record")"
  printf 'ECI additional repository active: %s\n' "$repository"
  printf 'reason: %s\n' "$reason"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
case "$cmd" in
--help|-h)
  usage 2>&1
  exit 0
  ;;
coordinator-edit-status)
  [ "$#" -eq 1 ] || { usage; exit 2; }
  coordinator_edit_context || exit 1
  coordinator_edit_record="$(codex_eci_coordinator_edit_record_path "$coordinator_edit_session_id")" || {
    echo "Coordinator edit state target is unsafe: $coordinator_edit_session_dir/eci-coordinator-edit" >&2
    exit 1
  }
  coordinator_edit_state="$(codex_eci_coordinator_edit_record_state "$coordinator_edit_session_id" "$coordinator_edit_cwd")" || {
    echo "Coordinator edit state target is unsafe: $coordinator_edit_record" >&2
    exit 1
  }
  case "$coordinator_edit_state" in
  active) printf 'ECI coordinator edit state active\n' ;;
  inactive) printf 'ECI coordinator edit state inactive\n' ;;
  *)
    echo "Coordinator edit state is invalid: $coordinator_edit_record" >&2
    exit 1
    ;;
  esac
  ;;
repository-allow-status)
  repository_allow_status "$@"
  ;;
permissive-status)
  [ "$#" -eq 5 ] || { usage; exit 2; }
  permissive_scope="$2"; permissive_gate="$3"; permissive_operation="$4"; permissive_request="$5"
  permissive_context "$permissive_scope" || {
    printf 'ECI permissive mode inactive\n'
    exit 0
  }
  if codex_eci_session_permissive_active "$permissive_scope" "$permissive_session_id" \
    "$permissive_cwd" "$permissive_gate" "$permissive_operation" "$permissive_request"; then
    printf 'ECI permissive mode active\n'
  else
    printf 'ECI permissive mode inactive\n'
  fi
  ;;
permissive-on)
  [ "$#" -eq 6 ] || { usage; exit 2; }
  permissive_scope="$2"; permissive_gate="$3"; permissive_operation="$4"; permissive_request="$5"; permissive_ttl="$6"
  [[ "$permissive_ttl" =~ ^[0-9]{1,4}$ ]] && [ "$permissive_ttl" -ge 1 ] && [ "$permissive_ttl" -le 3600 ] || exit 1
  permissive_context "$permissive_scope" || exit 1
  acquire_eci_mutation_lock || exit 1
  permissive_record="$(codex_eci_session_permissive_record_path "$permissive_scope" "$permissive_session_id")" || exit 1
  if [ -e "$permissive_record" ] || [ -L "$permissive_record" ]; then
    [ -f "$permissive_record" ] && [ ! -L "$permissive_record" ] || {
      echo "ECI permissive mode target is unsafe: $permissive_record" >&2
      exit 1
    }
  fi
  write_permissive_record "$permissive_record" "$permissive_scope" "$permissive_session_id" "$permissive_cwd" "$permissive_gate" "$permissive_operation" "$permissive_request" "$permissive_ttl" || exit 1
  printf 'ECI permissive mode active: %s\n' "$permissive_record"
  ;;
permissive-off)
  [ "$#" -eq 5 ] || { usage; exit 2; }
  permissive_scope="$2"; permissive_gate="$3"; permissive_operation="$4"; permissive_request="$5"
  codex_eci_session_permissive_scope_is_valid "$permissive_scope" &&
    codex_eci_session_permissive_selector_is_valid "$permissive_gate" &&
    codex_eci_session_permissive_selector_is_valid "$permissive_operation" &&
    codex_eci_session_permissive_request_is_valid "$permissive_request" || exit 1
  permissive_context "$permissive_scope" || exit 1
  acquire_eci_mutation_lock || exit 1
  permissive_record="$(codex_eci_session_permissive_record_path "$permissive_scope" "$permissive_session_id")" || exit 1
  if [ -e "$permissive_record" ] || [ -L "$permissive_record" ]; then
    [ -f "$permissive_record" ] && [ ! -L "$permissive_record" ] || {
      echo "ECI permissive mode target is unsafe: $permissive_record" >&2
      exit 1
    }
    rm -f -- "$permissive_record" || exit 1
  fi
  printf 'ECI permissive mode inactive: %s\n' "$permissive_record"
  ;;
ledger-append)
  if [ "${2:-}" = --json ]; then
    [ "$#" -eq 3 ] || {
      usage
      exit 2
    }
    # Slurp proves there is exactly one document. Validate and compact before
    # any bootstrap, LF normalization, or hardlink detachment touches history.
    entry="$(jq -cse '
      def nonempty: type == "string" and test("\\S");
      def references: type == "array" and length > 0 and all(.[]; nonempty);
      def identity: type == "object" and (.id | nonempty) and (.role | nonempty)
        and ((has("turn") | not) or (.turn | nonempty));
      if length != 1 then error("expected exactly one JSON object") else .[0] end
      | if type != "object" then error("expected exactly one JSON object") else . end
      | if ((.event | IN("worker_progress", "assignment_change", "review_result",
          "decision", "verification_result", "requirement_change", "forecast_change",
          "blocker_change", "checkpoint", "lifecycle_change", "correction"))
          and (.summary | nonempty)
          and ((has("actor") | not) or (.actor | identity))
          and ((has("recorded_by") | not) or (.recorded_by | identity))
          and ((has("next_action") | not) or (.next_action | nonempty))) | not
        then error("invalid event, summary, identity, or next_action") else . end
      | if .event == "worker_progress" then
          if ((.actor | identity) and (.requirements | references)
              and (.evidence | references) and (.change | type == "object")
              and (.change.before | nonempty) and (.change.after | nonempty)
              and (.reason | nonempty))
          then . else error("worker_progress requires actor, requirements, change, reason, and evidence") end
        else . end
    ' <<<"$3")" || {
      echo 'ECI high-level log append rejected invalid structured entry before log mutation.' >&2
      exit 2
    }
  else
    usage
    exit 2
  fi
  session_dir="$(resolve_session_dir)" || {
    echo 'eci-active: no current session directory found under the proof root.' >&2
    exit 1
  }
  acquire_eci_mutation_lock || exit 1
  current_cwd="$(codex_canonical_cwd "$PWD")"
  ledger_timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  [[ "$ledger_timestamp" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || {
    echo "ECI high-level log append produced an invalid UTC timestamp: $ledger_timestamp" >&2
    exit 1
  }
  formatted_entry="$(jq -c --arg timestamp "$ledger_timestamp" \
    --arg session_id "$(basename -- "$session_dir")" \
    '. + {schema:"eci-high-level-log/v1",timestamp:$timestamp,session_id:$session_id}' \
    <<<"$entry")" || exit 1
  # Reconcile the current JSONL and its anchor under this mutation lock.
  # Anchor metadata is advisory; concrete destination safety governs writes.
  ledger_ensure_anchor "$session_dir" || {
    echo 'ECI high-level log append found an unsafe current ledger target.' >&2
    exit 1
  }
  ledger_detach_hardlinked_log "$session_dir" || {
    echo 'ECI high-level log append could not detach an externally linked current ledger target.' >&2
    exit 1
  }
  log_path="$session_dir/$ledger_log_name"
  ledger_path_is_mutable "$session_dir" || {
    echo 'ECI high-level log append could not access an exclusive current ledger target.' >&2
    exit 1
  }
  if [ "$(ledger_bytes "$log_path")" -gt 0 ] &&
    [ "$(tail -c 1 -- "$log_path" 2>/dev/null | od -An -t x1 | tr -d '[:space:]')" != 0a ]; then
    ledger_path_is_mutable "$session_dir" || {
      echo 'ECI high-level log changed to an externally linked target during normalization.' >&2
      exit 1
    }
    printf '\n' >>"$log_path" || {
      echo 'ECI high-level log append could not normalize its current regular ledger target.' >&2
      exit 1
    }
  fi
  ledger_path_is_mutable "$session_dir" || {
    echo 'ECI high-level log changed to an unsafe or externally linked file during normalization.' >&2
    exit 1
  }
  printf '%s\n' "$formatted_entry" >>"$log_path"
  ledger_path_is_mutable "$session_dir" || {
    echo 'ECI high-level log changed to an unsafe or externally linked file during append.' >&2
    exit 1
  }
  ledger_write_anchor "$session_dir" true ||
    printf 'ECI advisory: high-level ledger anchor could not be refreshed after append.\n' >&2
  printf 'ECI high-level log appended at EOF: %s\n' "$log_path"
  ;;
aggregate-review)
  shift
  aggregate_phase="${1:-}"
  aggregate_repo_id="${2:-}"
  [ "$#" -eq 2 ] || {
    usage
    exit 2
  }
  case "$aggregate_phase" in prewrite|final) ;; *)
    echo 'aggregate-review supports only prewrite or final; commit and off remain aggregate-owned composite operations.' >&2
    exit 1
    ;;
  esac
  aggregate_repo_id_is_valid "$aggregate_repo_id" || {
    echo 'aggregate-review requires a bounded aggregate repository ID.' >&2
    exit 1
  }
  current_session="${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}"
  codex_valid_session_id "$current_session" || {
    echo 'aggregate-review requires an explicit current CODEX_SESSION_ID or CODEX_THREAD_ID.' >&2
    exit 1
  }
  session_dir="$(resolve_session_dir)" || {
    echo 'eci-active: no current session directory found under the proof root.' >&2
    exit 1
  }
  [ "${session_dir##*/}" = "$current_session" ] || {
    echo 'aggregate-review resolved a different session than the current identity.' >&2
    exit 1
  }
  acquire_eci_mutation_lock || exit 1
  aggregate_current_context "$session_dir" || {
    echo 'aggregate-review requires a validated active aggregate session and selected target.' >&2
    exit 1
  }
  aggregate_current_context "$session_dir" || {
    echo 'aggregate-review could not revalidate the selected aggregate target after session validation.' >&2
    exit 1
  }
  aggregate_caller_is_selected_target "$session_dir" "$aggregate_repo_id" || {
    echo 'aggregate-review rejected a caller outside the selected aggregate target.' >&2
    exit 1
  }
  codex_eci_aggregate_plan_select "$aggregate_plan" "$current_session" \
    "$aggregate_outer_cwd" "$aggregate_marker" "$aggregate_repo_id" || {
    echo 'aggregate-review rejected an unknown or invalid aggregate repository ID.' >&2
    exit 1
  }
  run_aggregate_review_gate "$aggregate_phase" "$current_session" "$aggregate_repo_id" "$aggregate_outer_cwd" || {
    echo "ECI aggregate required-critic review gate rejected phase=$aggregate_phase repo=$aggregate_repo_id." >&2
    exit 1
  }
  ;;
manifest-write)
  [ "$#" -eq 2 ] || {
    usage
    exit 2
  }
  current_session="${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}"
  codex_valid_session_id "$current_session" || {
    echo 'manifest-write requires an explicit current CODEX_SESSION_ID or CODEX_THREAD_ID.' >&2
    exit 1
  }
  session_dir="$(resolve_session_dir)" || {
    echo 'eci-active: no current session directory found under the proof root.' >&2
    exit 1
  }
  [ "${session_dir##*/}" = "$current_session" ] || {
    echo 'manifest-write resolved a different session than the current identity.' >&2
    exit 1
  }
  acquire_eci_mutation_lock || exit 1
  reject_normal_lifecycle_for_aggregate_session "$session_dir" manifest-write || exit 1
  current_cwd="$(codex_canonical_cwd "$PWD")"
  manifest_source="$2"
  manifest_destination="$session_dir/eci-required-critics.json"
  safe_import_fixed_session_leaf "$manifest_source" "$session_dir" singleton-manifest || {
    echo 'manifest-write source or fixed destination is unsafe.' >&2
    exit 1
  }
  printf 'ECI required-critic manifest published: %s\n' "$manifest_destination"
  ;;
approve-commit)
  # Compatibility only: normal commits are reviewed as ordinary work and do
  # not need an owner role, a command grammar, or a one-time artifact.
  printf '%s\n' 'Normal Git commits do not need ECI approval artifacts. Continue with the intended Git command.'
  ;;
maintain-planner)
  [ "$#" -eq 1 ] || {
    usage
    exit 2
  }
  exec "$base_dir/bin/eci-runtime-sync" planner-apply \
    --target "${KIMI_CODE_HOME:-${HOME:?HOME must be set}/.kimi-code}"
  ;;
accidental-override-cleanup)
  [ "$#" -eq 3 ] && [ "${2:-}" = --authorized-by-user ] || {
    usage
    exit 2
  }
  require_main_coordinator_owner
  cleanup_accidental_override_claim "$3"
  ;;
sync-runtime)
  [ "$#" -eq 1 ] || {
    usage
    exit 2
  }
  # The local Codex runtime is the operation this lifecycle command owns.
  # Publish it first; a missing or stale optional Kimi peer must not turn a
  # local repair into a no-op. A concrete local target/publish failure still
  # exits through `set -e` below.
  . "$base_dir/hooks/lib/eci-runtime-sync.sh"
  eci_runtime_sync_run codex "$base_dir"
  peer_target="${KIMI_CODE_HOME:-${HOME:?HOME must be set}/.kimi-code}"
  if ! "$base_dir/bin/eci-runtime-sync" peer-apply --target "$peer_target"; then
    printf 'ECI runtime peer synchronization advisory: Codex local runtime synchronization succeeded; Codex-to-Kimi peer runtime was not synchronized.\n' >&2
  fi
  ;;
*)
  usage
  exit 2
  ;;
esac
fi
