  printf 'Nested ECI inactive; outer marker retained.\n'
  ;;
maintain-planner)
  [ "$#" -eq 1 ] || {
    usage
    exit 2
  }
  exec "$base_dir/bin/eci-runtime-sync" planner-apply \
    --target "${KIMI_CODE_HOME:-${HOME:?HOME must be set}/.kimi-code}"
  ;;
accidental-override-cleanup)
  [ "$#" -eq 3 ] && [ "${2:-}" = --authorized-by-user ] || {
    usage
    exit 2
  }
  require_main_coordinator_owner
  cleanup_accidental_override_claim "$3"
  ;;
sync-runtime)
  [ "$#" -eq 1 ] || {
    usage
    exit 2
  }
  # The local Codex runtime is the operation this lifecycle command owns.
  # Publish it first; a missing or stale optional Kimi peer must not turn a
  # local repair into a no-op. A concrete local target/publish failure still
  # exits through `set -e` below.
  . "$base_dir/hooks/lib/eci-runtime-sync.sh"
  eci_runtime_sync_run codex "$base_dir"
  peer_target="${KIMI_CODE_HOME:-${HOME:?HOME must be set}/.kimi-code}"
  if ! "$base_dir/bin/eci-runtime-sync" peer-apply --target "$peer_target"; then
    printf 'ECI runtime peer synchronization advisory: Codex local runtime synchronization succeeded; Codex-to-Kimi peer runtime was not synchronized.\n' >&2
  fi
  ;;
off)
  report="${2:-}"
  [ -n "$report" ] || {
    usage
    exit 2
  }
  [ -f "$report" ] && [ ! -L "$report" ] || {
    echo "Disengage report not found or unsafe: $report" >&2
    exit 1
  }
  # When the caller supplies a report inside a proof session, that path is
  # an identity claim, not a hint.  Bind it before resolving the active
  # marker so a stale report cannot fall through to the newest session and
  # produce a misleading generic "inactive" error.  Reports outside the
  # proof root remain supported for the existing user-owned flow.
  report_path="$(realpath -e -- "$report" 2>/dev/null || true)"
  codex_eci_teardown_report_path_is_safe "$report_path" || {
    echo "Disengage report target is unsafe: $report" >&2
    exit 1
  }
  report_root="$(codex_proof_root)"
  report_session=""
  case "$report_path" in
  "$report_root"/*/*)
    report_rest="${report_path#"$report_root"/}"
    report_session="${report_rest%%/*}"
    report_tail="${report_rest#*/}"
    if codex_valid_session_id "$report_session" && [ "$report_tail" != "$report_rest" ]; then
      requested_session="${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}"
      if [ -n "$requested_session" ] && [ "$requested_session" != "$report_session" ]; then
        echo "ECI off session identity mismatch: supplied report $report_path belongs to session $report_session, but the requested active session is $requested_session; refusing teardown." >&2
        exit 1
      fi
      [ -n "$requested_session" ] || export CODEX_SESSION_ID="$report_session"
    fi
    ;;
  esac
  session_dir="$(resolve_session_dir)" || {
    echo "eci-active: no session directory found under $(codex_proof_root)" >&2
    exit 1
  }
  acquire_eci_mutation_lock || exit 1
  reject_normal_lifecycle_for_aggregate_session "$session_dir" off || exit 1
  marker="$session_dir/eci_active"
  if [ -L "$marker" ]; then
    echo "ECI marker is a symlink; refusing to use it: $marker" >&2
    exit 1
  fi
  if [ ! -f "$marker" ]; then
    printf 'ECI inactive for the current direct session target: %s\n' "$marker"
    report_legacy_eci_markers_for_cwd "$marker"
    exit 1
  fi
  current_cwd="$(codex_canonical_cwd "$PWD")"
  marker="$(prepare_current_direct_marker_for_mutation "$session_dir" "$current_cwd")" || {
    echo "ECI marker is not a regular direct marker bound to this current session/cwd: $session_dir/eci_active" >&2
    exit 1
  }
  report_legacy_eci_markers_for_cwd "$marker"
  wait_state="$session_dir/eci_wait"
  for history_path in "$session_dir/eci-user-closed.ledger" "$session_dir/eci-teardown-complete"; do
    if [ -L "$history_path" ]; then
      printf 'ECI advisory: preserved symlinked local history during teardown: %s\n' "$history_path" >&2
    elif [ -f "$history_path" ]; then
      rm -f -- "$history_path" ||
        printf 'ECI advisory: could not clear stale regular local history during teardown: %s\n' "$history_path" >&2
    elif [ -e "$history_path" ]; then
      printf 'ECI advisory: preserved nonregular local history during teardown: %s\n' "$history_path" >&2
    fi
  done
  for prewrite_sentinel in "$session_dir"/eci-prewrite-admitted.*; do
    [ -e "$prewrite_sentinel" ] || [ -L "$prewrite_sentinel" ] || continue
    if [ -f "$prewrite_sentinel" ] && [ ! -L "$prewrite_sentinel" ]; then
      rm -f -- "$prewrite_sentinel" ||
        printf 'ECI advisory: could not clear stale regular prewrite history: %s\n' "$prewrite_sentinel" >&2
    else
      printf 'ECI advisory: preserved unusual prewrite history during teardown: %s\n' "$prewrite_sentinel" >&2
    fi
  done
  if [ -f "$wait_state" ] && [ ! -L "$wait_state" ]; then
    rm -f -- "$wait_state" ||
      printf 'ECI advisory: could not clear stale regular wait history during teardown: %s\n' "$wait_state" >&2
  elif [ -e "$wait_state" ] || [ -L "$wait_state" ]; then
    printf 'ECI advisory: preserved unusual wait history during teardown: %s\n' "$wait_state" >&2
  fi
  rm -f -- "$marker"
  [ ! -e "$marker" ] && [ ! -L "$marker" ] || {
    echo "ECI marker could not be removed: $marker" >&2
    exit 1
  }
  # Preserve legacy user-closed visibility only after the actual teardown
  # succeeds. Its publication is advisory history, never a condition for
  # clearing the current marker; unusual existing local targets remain
  # untouched through the writer's direct no-follow checks.
  if grep -Fqx 'schema: eci-user-closed/v1' "$report_path" 2>/dev/null; then
    write_user_closed_ledger "$session_dir" "$report_path" "$current_cwd" ||
      printf 'ECI advisory: user-closed history could not be published after teardown: %s\n' \
        "$session_dir/eci-user-closed.ledger" >&2
  fi
  printf 'ECI inactive. Disengage report read: %s\n' "$report"
  ;;
status)
  session_dir="$(resolve_session_dir)" || {
    echo "eci-active: no session directory found under $(codex_proof_root)" >&2
    exit 1
  }
  marker="$session_dir/eci_active"
  if [ -L "$marker" ]; then
    echo "ECI marker is a symlink; refusing to read it: $marker" >&2
    exit 1
  fi
  if [ -n "${marker:-}" ] && [ -f "$marker" ] && [ ! -L "$marker" ]; then
    read_only_marker_summary "$marker" "${session_dir##*/}"
  elif legacy_marker="$(codex_legacy_eci_markers_for_cwd "$PWD" 2>/dev/null | head -n1)" &&
    [ -n "$legacy_marker" ]; then
    legacy_session_id="${legacy_marker%/*}"
    read_only_marker_summary "$legacy_marker" "${legacy_session_id##*/}"
  else
    echo "ECI inactive"
  fi
  ;;
*)
  usage
  exit 2
  ;;
esac
