#!/usr/bin/env bash

set -euo pipefail

provider=codex
if [ -n "${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}" ] || [ -n "${CODEX_PROOF_ROOT:-}" ]; then
  provider=codex
elif [ -n "${KIMI_SESSION_ID:-${KIMI_THREAD_ID:-}}" ] || [ -n "${KIMI_PROOF_ROOT:-}" ]; then
  provider=kimi
else
  probe_pid=$PPID
  while [ "$probe_pid" -gt 1 ] 2>/dev/null; do
    read -r probe_name probe_parent < <(awk '{print $2, $4}' "/proc/$probe_pid/stat" 2>/dev/null) || break
    probe_name="${probe_name#(}"; probe_name="${probe_name%)}"
    if [ "$probe_name" = kimi ]; then provider=kimi; break; fi
    probe_pid="$probe_parent"
  done
fi

if [ "$provider" = kimi ]; then
  provider_home="${KIMI_CODE_HOME:-${HOME:?}/.kimi-code}"
else
  provider_home="${HOME:?}/.codex"
fi
entrypoint="$provider_home/bin/eci-active"
[ -x "$entrypoint" ] && [ ! -L "$entrypoint" ] || {
  printf 'eci-active: %s provider entrypoint is unavailable\n' "$provider" >&2
  exit 1
}
exec "$entrypoint" "$@"
