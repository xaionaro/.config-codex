#!/usr/bin/env bash
# Build the canonical host guard on demand; keep generated executables out of Git.
set -euo pipefail

source_dir=${OWNED_COMMAND_SOURCE:-$HOME/.codex/tools/owned-command}
cache_dir=${OWNED_COMMAND_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/codex/owned-command}
resolve_executable=false
if [[ ${1:-} == --resolve-executable ]]; then
  [[ $# == 1 ]] || {
    printf 'owned-command: --resolve-executable accepts no other arguments\n' >&2
    exit 1
  }
  resolve_executable=true
fi
if [[ ${1:-} == --wrapper-help ]]; then
  cat <<'EOF'
Usage: owned-command [guard flags] -- command args...
       owned-command -help
       owned-command --resolve-executable

Builds Codex tools/owned-command automatically and forwards arguments/status.
OWNED_COMMAND_SOURCE: Go module directory override (default ~/.codex/tools/owned-command).
OWNED_COMMAND_CACHE: generated executable cache (default ${XDG_CACHE_HOME:-$HOME/.cache}/codex/owned-command).
Source changes rebuild before the next invocation. Requires Go, flock, sha256sum.
Cache versions belong to this wrapper; remove old versions only after their callers exit.
--resolve-executable prepares without executing and prints one absolute cache path.
Resolve before timed phases; execute that path directly with caller arguments/environment.
Resolve again to select changed source/toolchain settings. Retain the path while in use.
Guard flags and receipt semantics: owned-command -help and the source README.md.
EOF
  exit 0
fi
source_dir=$(realpath -e -- "$source_dir")
[[ -f $source_dir/go.mod && -f $source_dir/main.go ]] || {
  printf 'owned-command: source module missing at %s\n' "$source_dir" >&2
  exit 1
}
# Resolve caller-relative configuration before entering the canonical module.
go_config=()
if [[ -n ${GOENV:-} && $GOENV != off ]]; then
  go_config+=("GOENV=$(realpath -m -- "$GOENV")")
fi
# Select a PATH executable or shim even when the caller exports a go function.
go_launcher=$(type -P go) || {
  printf 'owned-command: Go compiler not found in PATH\n' >&2
  exit 1
}
go_launcher=$(realpath -e -- "$go_launcher")
# Bootstrap retains dependency transport, caches and requested toolchain selection.
bootstrap=$(cd -- "$source_dir"; env "${go_config[@]}" GO111MODULE=on GOWORK=off CGO_ENABLED=0 GOFLAGS=' ' GO_EXTLINK_ENABLED=0 \
  "$go_launcher" env GOHOSTOS GOHOSTARCH GOROOT GOVERSION GOTOOLCHAIN)
mapfile -t compiler_selection <<< "$bootstrap"
[[ ${#compiler_selection[@]} == 5 ]] || {
  printf 'owned-command: incomplete Go compiler selection\n' >&2
  exit 1
}
host_os=${compiler_selection[0]}
host_arch=${compiler_selection[1]}
compiler_root=${compiler_selection[2]}
compiler_version=${compiler_selection[3]}
requested_toolchain=${compiler_selection[4]}
compiler=$compiler_root/bin/go
[[ -n $host_os && -n $host_arch && -n $compiler_version && -x $compiler ]] || {
  printf 'owned-command: selected native Go compiler unavailable\n' >&2
  exit 1
}
# Ask the selected compiler for its baseline ISA, without caller target tuning.
tuning_names=(GO386 GOAMD64 GOARM GOARM64 GOMIPS GOMIPS64 GOPPC64 GORISCV64 GOWASM)
defaults_env=(env)
for name in "${tuning_names[@]}"; do
  defaults_env+=(-u "$name")
done
# A selected toolchain may differ from the caller's bootstrap GOROOT.
native_env=(env "${go_config[@]}" GOROOT="$compiler_root" GOTOOLCHAIN=local GOOS="$host_os" GOARCH="$host_arch" \
  GO111MODULE=on GOWORK=off CGO_ENABLED=0 GOFLAGS=' ' GO_EXTLINK_ENABLED=0)
case $host_arch in
  386) tuning=GO386 ;;
  amd64) tuning=GOAMD64 ;;
  arm) tuning=GOARM ;;
  arm64) tuning=GOARM64 ;;
  mips|mipsle) tuning=GOMIPS ;;
  mips64|mips64le) tuning=GOMIPS64 ;;
  ppc64|ppc64le) tuning=GOPPC64 ;;
  riscv64) tuning=GORISCV64 ;;
  wasm) tuning=GOWASM ;;
  *) tuning= ;;
esac
if [[ -n $tuning ]]; then
  native_default=$(cd -- "$source_dir"; "${defaults_env[@]}" GOROOT="$compiler_root" GOENV=off GOTOOLCHAIN=local \
    GOOS="$host_os" GOARCH="$host_arch" GO111MODULE=on GOWORK=off CGO_ENABLED=0 GOFLAGS=' ' GO_EXTLINK_ENABLED=0 \
    "$compiler" env "$tuning")
  [[ -n $native_default ]] || {
    printf 'owned-command: native Go architecture default missing for %s\n' "$tuning" >&2
    exit 1
  }
  native_env+=("$tuning=$native_default")
fi
# Every steady query and compilation shares this exact compiler and native policy.
native_go() {
  "${native_env[@]}" "$compiler" "$@"
}
mkdir -p -- "$cache_dir"
cache_dir=$(realpath -e -- "$cache_dir")
# One builder per cache. Immutable filenames remain safe after unlocking and exec.
exec 9>"$cache_dir/build.lock"
flock 9
fingerprint() (
  cd -- "$source_dir" || return
  printf '%s\n' 'owned-command cache format 2; native host/default ISA; GOFLAGS=space; GO_EXTLINK_ENABLED=0; -buildvcs=false'
  printf '%s\n' "$source_dir"
  printf '%s\n' "$go_launcher" "$compiler" "$compiler_root" "$compiler_version" "$requested_toolchain" "$tuning"
  sha256sum -- "$go_launcher" "$compiler" || return
  native_go version || return
  native_go env GOOS GOARCH GO111MODULE GOWORK CGO_ENABLED GOFLAGS GO_EXTLINK_ENABLED \
    GOPATH GOMODCACHE GOEXPERIMENT GOFIPS140 || return
  if [[ -n $tuning ]]; then
    native_go env "$tuning" || return
  fi
  find . -type f \( -name '*.go' -o -name go.mod -o -name go.sum \) -print0 |
    sort -z | xargs -0 sha256sum
)
key=$(fingerprint | sha256sum)
key=${key%% *}
executable=$cache_dir/$key/owned-command
if [[ ! -x $executable ]]; then
  build_dir=$(mktemp -d "$cache_dir/.build.XXXXXXXX")
  trap 'rm -rf -- "$build_dir"' EXIT
  if "$resolve_executable"; then
    (cd -- "$source_dir"; native_go build -buildvcs=false -o "$build_dir/owned-command" .) >&2
  else
    (cd -- "$source_dir"; native_go build -buildvcs=false -o "$build_dir/owned-command" .)
  fi
  # Source writers do not share this cache lock. Refuse a changed build snapshot.
  after=$(fingerprint | sha256sum)
  [[ ${after%% *} == "$key" ]] || {
    printf 'owned-command: source changed during build; retry invocation\n' >&2
    exit 1
  }
  mkdir -p -- "$cache_dir/$key"
  mv -T -- "$build_dir/owned-command" "$executable"
  rmdir -- "$build_dir"
  trap - EXIT
fi
flock -u 9
exec 9>&-
if "$resolve_executable"; then
  case $executable in
    *$'\r'*|*$'\n'*)
      printf 'owned-command: resolved executable path contains CR/LF\n' >&2
      exit 1
      ;;
  esac
  printf '%s\n' "$executable"
  exit 0
fi
exec "$executable" "$@"
