#!/usr/bin/env bash
# Coordinator-owned provider runtime synchronizer.
#
# This route copies only the provider's hook/runtime surface from the
# configured canonical provider home to a declared provider target. It
# resolves ordinary mount/symlink spellings, then errors only when the
# resolved target has the wrong provider shape or publication cannot proceed.

set -euo pipefail

# Use the system utility locations consistently. This is for predictable
# maintenance behavior, not a condition for admitting ordinary work.
PATH='/usr/bin:/bin'
export PATH

usage() {
  printf '%s\n' \
    'usage: eci-runtime-sync {check|apply} --target PROVIDER_HOME' \
    '       eci-runtime-sync {planner-check|planner-apply} --target KIMI_CODE_HOME' \
    '       eci-runtime-sync {peer-check|peer-apply} --target KIMI_CODE_HOME' \
    '' \
    'Synchronize CODEX.md, config.toml, hooks.json, hooks/, and bin/ from' \
    'the canonical provider home to an explicit runtime provider home.' \
    '' \
    'planner-apply builds and publishes the local Codex command planner first,' \
    'then refreshes the Kimi planner when that optional peer is available.' \
    'peer-apply copies only the canonical Codex hooks/bin runtime surface into' \
    'a Kimi provider home and preserves Kimi config.toml.' >&2
}

fail() {
  local code="$1"
  shift
  printf '[%s] runtime synchronization denied: %s\n' "$code" "$*" >&2
  exit 2
}

hash_file() {
  local digest
  digest="$(sha256sum -- "$1" 2>/dev/null)" || return 1
  digest="${digest%% *}"
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s' "$digest"
}

PEER_RECEIPT_NAME='.eci-codex-kimi-peer-sync-manifest'

planner_binary_path() {
  local root="$1"

  printf '%s/hooks/lib/eci-command-plan-go/eci-command-plan\n' "$root"
}

safe_importer_source_dir() {
  local root="$1"

  printf '%s/hooks/lib/eci-safe-import-go\n' "$root"
}

safe_importer_binary_path() {
  local root="$1"

  printf '%s/eci-safe-import\n' "$(safe_importer_source_dir "$root")"
}

PLANNER_GO='/usr/lib/go-1.24/bin/go'
PLANNER_GOROOT='/usr/lib/go-1.24'
PLANNER_GO_TOOL_DIR='/usr/lib/go-1.24/pkg/tool/linux_arm64'
PLANNER_TARGET='linux/arm64'
PLANNER_RECEIPT_NAME='.eci-command-plan.provenance'
PLANNER_LOCK_NAME='.planner-importer.publish.lock'
PLANNER_SOURCE_FILES=(go.mod go.sum main.go classifier.go shell_analysis.go shell_projection.go hook.go hook_context.go hook_effects.go response.go)
readonly -a PLANNER_SOURCE_FILES
readonly PLANNER_GO PLANNER_GOROOT PLANNER_GO_TOOL_DIR PLANNER_TARGET PLANNER_RECEIPT_NAME PLANNER_LOCK_NAME

# Private no-op rendezvous, overridden only in an owned proof child.
if ! declare -F planner_publication_event >/dev/null; then
  planner_publication_event() { :; }
fi

planner_leaf_state() {
  local path="$1" mode digest
  if [ -L "$path" ]; then printf 'symlink\n'
  elif [ -f "$path" ]; then
    if ! mode="$(stat -c %a -- "$path")" || ! [[ "$mode" =~ ^[0-7]{1,4}$ ]]; then
      printf 'ECI observation uncertain: stat/mode unavailable: %s\n' "$path" >&2
      printf 'unknown\n'; return 1
    fi
    if ! digest="$(hash_file "$path")"; then
      printf 'ECI observation uncertain: digest unavailable: %s\n' "$path" >&2
      printf 'unknown\n'; return 1
    fi
    printf 'regular:%s:%s\n' "$mode" "$digest"
  elif [ -e "$path" ]; then printf 'other\n'
  else printf 'absent\n'
  fi
}

planner_rename() {
  local source_device target_device
  source_device="$(stat -c %d -- "$1")" && [[ "$source_device" =~ ^[0-9]+$ ]] || {
    printf 'ECI observation uncertain: source device unavailable: %s\n' "$1" >&2; return 1;
  }
  target_device="$(stat -c %d -- "${2%/*}")" && [[ "$target_device" =~ ^[0-9]+$ ]] || {
    printf 'ECI observation uncertain: destination device unavailable: %s\n' "${2%/*}" >&2; return 1;
  }
  [ "$source_device" = "$target_device" ] || return 1
  /usr/bin/mv --no-copy -fT -- "$1" "$2"
}

planner_record_inputs() {
  local name module path digest
  : >"$transaction/source-inputs" || return 1
  for name in eci-command-plan eci-safe-import; do
    module="$source_root/hooks/lib/$name-go"
    printf 'module\t%s\n' "$module" >>"$transaction/source-inputs" || return 1
    find "$module" -maxdepth 1 -type f \( -name '*.go' ! -name '*_test.go' -o -name go.mod -o -name go.sum \) -print0 | sort -z >"$transaction/source-file-list" || return 1
    while IFS= read -r -d '' path; do
      digest="$(hash_file "$path")" || {
        printf 'ECI provenance advisory: input digest unavailable: %s\n' "$path" >&2; return 1;
      }
      printf 'input\t%s\t%s\n' "$path" "$digest" >>"$transaction/source-inputs" || return 1
    done <"$transaction/source-file-list" || return 1
  done
}

planner_build_original() {
  local module="$1" name="$2"
  planner_publication_event "before-build:$name" "$module" || return 1
  (
    cd -- "$module" &&
    env -u GOCACHEPROG -u GOARM -u GOAMD64 \
      GOOS=linux GOARCH=arm64 CGO_ENABLED=0 GOFLAGS= GOWORK=off GOTOOLCHAIN=local \
      GOROOT="$PLANNER_GOROOT" GOPATH="$transaction/gopath" \
      GOCACHE="$transaction/gocache" GOMODCACHE="$transaction/gomodcache" \
      GOTMPDIR="$transaction/tmp" TMPDIR="$transaction/tmp" \
      "$PLANNER_GO" build -mod=readonly -trimpath -buildvcs=false -pgo=off \
        -ldflags=-buildid= -o "$transaction/built/$name" .
  ) || return 1
  chmod 755 -- "$transaction/built/$name" || return 1
  planner_publication_event "after-build:$name" "$module"
}

planner_prepare_pair() {
  local provider="$1" name path state
  [ ! -L "$output_root/$provider" ] || return 1
  mkdir -p -- "$output_root/$provider" "$transaction/$provider" || return 1
  for name in eci-command-plan eci-safe-import; do
    path="$output_root/$provider/$name"
    state="$(planner_leaf_state "$path")" || return 1
    case "$state" in
      regular:*) cp -p -- "$path" "$transaction/$provider/$name.backup" || return 1 ;;
      absent) ;;
      *) printf 'ECI pair target retained: %s (%s)\n' "$path" "$state" >&2; return 1 ;;
    esac
    old_states["$provider/$name"]="$state"
    cp -p -- "$transaction/built/$name" "$transaction/$provider/$name.install" || return 1
    state="$(planner_leaf_state "$transaction/$provider/$name.install")" || return 1
    new_states["$provider/$name"]="$state"
  done
}

# Restore both members, even if a signal followed rename before bookkeeping.
planner_restore_pair() {
  local provider="$1" name path state wanted restore ok=true
  for name in eci-command-plan eci-safe-import; do
    path="$output_root/$provider/$name"
    wanted="${old_states[$provider/$name]}"
    state="$(planner_leaf_state "$path")" || { ok=false; continue; }
    [ "$state" != "$wanted" ] || continue
    if [ "$state" != "${new_states[$provider/$name]}" ]; then
      printf 'ECI recovery retained foreign state: %s=%s\n' "$path" "$state" >&2
      ok=false
      continue
    fi
    planner_publication_event "before-restore:$provider:$name" "$path" || { ok=false; continue; }
    if [ "$wanted" = absent ]; then
      rm -- "$path" || { ok=false; continue; }
    else
      restore="$transaction/$provider/$name.restore"
      cp -p -- "$transaction/$provider/$name.backup" "$restore" &&
        planner_rename "$restore" "$path" || { ok=false; continue; }
    fi
    state="$(planner_leaf_state "$path")" && [ "$state" = "$wanted" ] || ok=false
  done
  for name in eci-command-plan eci-safe-import; do
    path="$output_root/$provider/$name"
    state="$(planner_leaf_state "$path")" || { state=unknown; ok=false; }
    printf 'ECI recovery state: %s=%s\n' "$path" "$state" >&2
  done
  [ "$ok" = true ]
}

planner_publish_pair() {
  local provider="$1" name path state
  planner_prepare_pair "$provider" || return 1
  pair_in_progress="$provider"
  for name in eci-command-plan eci-safe-import; do
    path="$output_root/$provider/$name"
    planner_publication_event "before-rename:$provider:$name" "$path" || return 1
    state="$(planner_leaf_state "$path")" && [ "$state" = "${old_states[$provider/$name]}" ] || return 1
    planner_rename "$transaction/$provider/$name.install" "$path" || return 1
    planner_publication_event "after-rename:$provider:$name" "$path" || return 1
  done
  planner_publication_event "before-complete:$provider" "$output_root/$provider" || return 1
  for name in eci-command-plan eci-safe-import; do
    state="$(planner_leaf_state "$output_root/$provider/$name")" && [ "$state" = "${new_states[$provider/$name]}" ] || return 1
  done
  if [ "$provider" = codex ]; then local_complete=true; else peer_complete=true; fi
  pair_in_progress=''
  planner_publication_event "after-complete:$provider" "$output_root/$provider"
}

planner_restore_receipt() {
  local state restore
  state="$(planner_leaf_state "$receipt_path")" || return 1
  if [ "$state" != "$receipt_old_state" ]; then
    [ "$state" = "$receipt_new_state" ] || return 1
    planner_publication_event "before-receipt-restore:$receipt_in_progress" "$receipt_path" || return 1
    if [ "$receipt_old_state" = absent ]; then
      rm -- "$receipt_path" || return 1
    else
      restore="$transaction/$receipt_in_progress/receipt.restore"
      cp -p -- "$transaction/$receipt_in_progress/receipt.backup" "$restore" &&
        planner_rename "$restore" "$receipt_path" || return 1
    fi
  fi
  state="$(planner_leaf_state "$receipt_path")" && [ "$state" = "$receipt_old_state" ]
}

# Receipt failures cannot reverse an explicitly completed binary phase.
planner_refresh_receipt() {
  local provider="$1" path state temporary go_digest compiler_digest linker_digest planner_digest importer_digest
  path="$output_root/$provider/$PLANNER_RECEIPT_NAME"
  state="$(planner_leaf_state "$path")" || return 1
  case "$state" in
    regular:*) cp -p -- "$path" "$transaction/$provider/receipt.backup" || return 1 ;;
    absent) ;;
    *) printf 'ECI receipt advisory: retained non-regular receipt: %s\n' "$path" >&2; return 1 ;;
  esac
  temporary="$transaction/$provider/receipt.install"
  go_digest="$(hash_file "$PLANNER_GO")" || return 1
  compiler_digest="$(hash_file "$PLANNER_GO_TOOL_DIR/compile")" || return 1
  linker_digest="$(hash_file "$PLANNER_GO_TOOL_DIR/link")" || return 1
  planner_digest="$(hash_file "$output_root/$provider/eci-command-plan")" || return 1
  importer_digest="$(hash_file "$output_root/$provider/eci-safe-import")" || return 1
  [ "${source_inputs_complete:-true}" = true ] || return 1
  {
    printf 'contract\toriginal-go-build/v1\n'
    printf 'go_binary_path\t%s\n' "$PLANNER_GO"
    printf 'go_binary_sha256\t%s\n' "$go_digest"
    printf 'compiler_sha256\t%s\n' "$compiler_digest"
    printf 'linker_sha256\t%s\n' "$linker_digest"
    printf 'target\t%s\n' "$PLANNER_TARGET"
    cat -- "$transaction/source-inputs" || return 1
    printf 'binary_sha256\t%s\n' "$planner_digest"
    printf 'importer_sha256\t%s\n' "$importer_digest"
  } >"$temporary" || return 1
  chmod 600 -- "$temporary" || return 1
  receipt_path="$path"
  receipt_old_state="$state"
  receipt_new_state="$(planner_leaf_state "$temporary")" || return 1
  planner_publication_event "before-receipt:$provider" "$path" || return 1
  local observed
  observed="$(planner_leaf_state "$path")" && [ "$observed" = "$state" ] || return 1
  receipt_in_progress="$provider"
  planner_rename "$temporary" "$path" || return 1
  planner_publication_event "after-receipt:$provider" "$path" || return 1
  observed="$(planner_leaf_state "$path")" && [ "$observed" = "$receipt_new_state" ] || return 1
  receipt_in_progress=''
}

planner_finish() {
  local status="$1" retained=false state resolved_transaction
  trap - EXIT HUP INT TERM
  if [ -n "$pair_in_progress" ]; then planner_restore_pair "$pair_in_progress" || retained=true; fi
  if [ -n "$receipt_in_progress" ]; then planner_restore_receipt || retained=true; fi
  if [ "$retained" = true ]; then
    if [ -n "$receipt_in_progress" ]; then
      state="$(planner_leaf_state "$receipt_path")" || state=unknown
      printf 'ECI receipt recovery state: %s=%s\n' "$receipt_path" "$state" >&2
    fi
    printf 'ECI recovery transaction retained: %s; local_complete=%s peer_complete=%s\n' "$transaction" "$local_complete" "$peer_complete" >&2
    status=1
  elif [ -n "$transaction" ]; then
    if [ ! -L "$transaction" ] && resolved_transaction="$(realpath -e -- "$transaction")" &&
      [ "$resolved_transaction" = "$transaction" ] && [ "${transaction%/*}" = "$output_root" ] &&
      [[ "${transaction##*/}" = .planner-importer.txn.* ]] &&
      [ "$(stat -c %u -- "$transaction")" = "$(id -u)" ]; then
      # Go's downloaded module directories are read-only; never follow cache links.
      if [ ! -L "$transaction/gomodcache" ] && [ -d "$transaction/gomodcache" ]; then
        find -P "$transaction/gomodcache" -type d -uid "$(id -u)" -exec chmod u+w -- {} + || status=1
      fi
      rm -r -- "$transaction" || status=1
    else
      printf 'ECI cleanup retained unverified transaction: %s\n' "$transaction" >&2
      status=1
    fi
  fi
  exit "$status"
}

# An owned child contains options, traps, PATH and lock descriptors.
planner_sync() (
  local planner_mode="$1" source_root="$2" peer_root="$3" uid="$4"
  local output_root="$5" requested_provider="$6"
  shift 6
  local name transaction='' lock_fd pair_in_progress='' receipt_in_progress=''
  local receipt_path='' receipt_old_state='' receipt_new_state=''
  local local_complete=false peer_complete=false requested_ok=true source_inputs_complete=true lock_type
  local -A old_states=() new_states=()
  set -euo pipefail
  [ "$source_root" = "$(realpath -e -- "$HOME/.codex")" ] || return 1
  [ -z "$peer_root" ] || [ "$peer_root" = "$(realpath -e -- "${KIMI_CODE_HOME:-$HOME/.kimi-code}")" ] || return 1
  case "$requested_provider" in codex|kimi) ;; *) return 1 ;; esac
  [ "$#" -gt 0 ] || set -- eci-command-plan eci-safe-import
  for name in "$@"; do case "$name" in eci-command-plan|eci-safe-import) ;; *) return 1 ;; esac; done
  [ ! -L "$output_root" ] || return 1
  output_root="$(realpath -m -- "$output_root")" || return 1
  [ "$output_root" != "$(realpath -e -- "$HOME/tmp")" ] || return 1
  case "$output_root/" in "$(realpath -e -- "$HOME/tmp")"/*) ;; *) return 1 ;; esac
  mkdir -p -- "$output_root" || return 1
  output_root="$(realpath -e -- "$output_root")"
  if [ -L "$output_root/$PLANNER_LOCK_NAME" ] || { [ -e "$output_root/$PLANNER_LOCK_NAME" ] && [ ! -f "$output_root/$PLANNER_LOCK_NAME" ]; }; then
    if [ -L "$output_root/$PLANNER_LOCK_NAME" ]; then lock_type=symlink
    else lock_type="$(stat -c %F -- "$output_root/$PLANNER_LOCK_NAME")" || lock_type=unknown; fi
    printf 'ECI publication lock retained: %s (type=%s). For isolated work choose an unused owned output descendant; for a fixed namespace ask the responsible owner to preserve/move only this conflicting leaf, then retry the same namespace as the same owner.\n' "$output_root/$PLANNER_LOCK_NAME" "$lock_type" >&2
    return 1
  fi
  exec {lock_fd}<>"$output_root/$PLANNER_LOCK_NAME" || return 1
  planner_publication_event before-lock "$output_root/$PLANNER_LOCK_NAME" || return 1
  /usr/bin/flock "$lock_fd" || return 1
  planner_publication_event after-lock "$output_root/$PLANNER_LOCK_NAME" || return 1
  for name in "$@"; do
    [ -f "$output_root/$requested_provider/$name" ] &&
      [ ! -L "$output_root/$requested_provider/$name" ] &&
      [ -x "$output_root/$requested_provider/$name" ] || requested_ok=false
  done
  case "$planner_mode" in
    ensure) [ "$requested_ok" != true ] || return 0 ;;
    planner-check) [ "$requested_ok" = true ] || return 1; printf 'OK\tmanaged pair\t%s\n' "$requested_provider"; return 0 ;;
    planner-apply) ;;
    *) return 1 ;;
  esac
  transaction="$(mktemp -d "$output_root/.planner-importer.txn.XXXXXX")" || return 1
  trap 'planner_finish "$?"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  mkdir -- "$transaction/built" "$transaction/tmp" "$transaction/gopath" "$transaction/gocache" "$transaction/gomodcache" || return 1
  if ! planner_record_inputs; then
    source_inputs_complete=false
    printf 'ECI provenance advisory: incomplete source observation; receipts will not refresh\n' >&2
  fi
  printf 'ECI build: original modules; GOCACHEPROG cleared; scratch=%s\n' "$transaction" >&2
  planner_build_original "$source_root/hooks/lib/eci-command-plan-go" eci-command-plan || return 1
  planner_build_original "$source_root/hooks/lib/eci-safe-import-go" eci-safe-import || return 1
  planner_publish_pair codex || return 1
  if ! planner_refresh_receipt codex; then
    printf 'ECI receipt advisory: Codex refresh failed\n' >&2
    if [ -n "$receipt_in_progress" ]; then planner_restore_receipt || return 1; receipt_in_progress=''; fi
  fi
  if [ -n "$peer_root" ]; then
    if planner_publish_pair kimi; then
      if ! planner_refresh_receipt kimi; then
        printf 'ECI receipt advisory: Kimi refresh failed\n' >&2
        if [ -n "$receipt_in_progress" ]; then planner_restore_receipt || return 1; receipt_in_progress=''; fi
      fi
    else
      printf 'ECI peer advisory: completed Codex pair preserved\n' >&2
      if [ -n "$pair_in_progress" ]; then planner_restore_pair kimi || return 1; pair_in_progress=''; fi
    fi
  fi
  if [ "$planner_mode" = ensure ]; then
    for name in "$@"; do
      [ -f "$output_root/$requested_provider/$name" ] &&
        [ ! -L "$output_root/$requested_provider/$name" ] &&
        [ -x "$output_root/$requested_provider/$name" ] || return 1
    done
  fi
  printf 'ECI pair complete: local=%s peer=%s requested=%s\n' "$local_complete" "$peer_complete" "$requested_provider" >&2
)

# Callability for owned children; ordinary CLI behavior remains below.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 0; fi

mode=""
target_arg=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    check|apply|planner-check|planner-apply|peer-check|peer-apply)
      [ -z "$mode" ] || fail ECI_RUNTIME_SYNC_ARGUMENTS 'mode was supplied more than once'
      mode="$1"
      ;;
    --target)
      shift
      [ "$#" -gt 0 ] || fail ECI_RUNTIME_SYNC_ARGUMENTS '--target requires one provider-home path'
      [ -z "$target_arg" ] || fail ECI_RUNTIME_SYNC_ARGUMENTS '--target was supplied more than once'
      target_arg="$1"
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail ECI_RUNTIME_SYNC_ARGUMENTS "unrecognized argument: $1"
      ;;
  esac
  shift
done
[ -n "$mode" ] || { usage; exit 2; }
[ -n "$target_arg" ] || fail ECI_RUNTIME_SYNC_ARGUMENTS 'an explicit --target is required'

launcher_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd -P)" ||
  fail ECI_RUNTIME_SYNC_SOURCE_UNRESOLVED 'unable to resolve the runtime launcher home'
provider="${launcher_root##*/}"
case "$provider" in
  .codex|.kimi-code) ;;
  *) fail ECI_RUNTIME_SYNC_PROVIDER "runtime launcher home is not a provider directory: $launcher_root" ;;
esac

# A deployed launcher is deliberately allowed to be stale or mounted under a
# different provider root.  Maintenance always repairs from the user's
# selected provider source; launcher spelling is diagnostic context only.
case "$provider" in
  .codex) canonical_source_root="${HOME:?HOME must be set}/.codex" ;;
  .kimi-code) canonical_source_root="${KIMI_CODE_HOME:-${HOME:?HOME must be set}/.kimi-code}" ;;
esac
canonical_source_root_real="$(realpath -e -- "$canonical_source_root" 2>/dev/null || true)"
[ -n "$canonical_source_root_real" ] && [ -d "$canonical_source_root_real" ] ||
  fail ECI_RUNTIME_SYNC_SOURCE_UNRESOLVED "provider=$provider selected source is unavailable: $canonical_source_root"
source_root="$canonical_source_root_real"

owner_uid="${EUID:-$(id -u 2>/dev/null || printf '%s' -1)}"
owner_of() { stat -Lc '%u' -- "$1" 2>/dev/null || true; }
mode_of() { stat -Lc '%a' -- "$1" 2>/dev/null || true; }

write_peer_receipt() {
  local peer_source_root="$1" peer_target_root="$2"
  local receipt receipt_tmp relative source_path source_hash source_mode

  receipt="$peer_target_root/$PEER_RECEIPT_NAME"
  if [ -L "$receipt" ]; then
    fail ECI_RUNTIME_SYNC_TARGET_UNSAFE "peer receipt is a symlink: $receipt"
  fi
  if [ -e "$receipt" ] || [ -L "$receipt" ]; then
    # A receipt is status from an earlier run. Refresh it when it is a
    # replaceable leaf; otherwise keep the metadata residue and let the
    # already-published runtime files stand.
    if [ -f "$receipt" ]; then
      if ! rm -f -- "$receipt"; then
        printf 'ECI runtime maintenance advisory: could not replace peer receipt: %s\n' "$receipt" >&2
        return 0
      fi
    else
      printf 'ECI runtime maintenance advisory: peer receipt is not a replaceable file: %s\n' "$receipt" >&2
      return 0
    fi
  fi
  receipt_tmp="$receipt.eci-runtime-sync.$$"
  if [ -e "$receipt_tmp" ] || [ -L "$receipt_tmp" ]; then
    printf 'ECI runtime maintenance advisory: peer receipt temporary path already exists: %s\n' "$receipt_tmp" >&2
    return 0
  fi
  if ! (
    for relative in "${manifest[@]}"; do
      source_path="$peer_source_root/$relative"
      source_hash="$(hash_file "$source_path")" ||
        exit 1
      source_mode="$(mode_of "$source_path")"
      printf '%s\t%s\t%s\n' "$relative" "$source_hash" "$source_mode"
    done
  ) >"$receipt_tmp"; then
    printf 'ECI runtime maintenance advisory: could not stage peer receipt: %s\n' "$receipt_tmp" >&2
    rm -f -- "$receipt_tmp" 2>/dev/null || true
    return 0
  fi
  if ! chmod 600 -- "$receipt_tmp"; then
    printf 'ECI runtime maintenance advisory: could not set peer receipt mode: %s\n' "$receipt_tmp" >&2
  fi
  if ! mv -f -- "$receipt_tmp" "$receipt"; then
    printf 'ECI runtime maintenance advisory: could not publish peer receipt: %s\n' "$receipt" >&2
    rm -f -- "$receipt_tmp" 2>/dev/null || true
  fi
}

[ -d "$source_root" ] ||
  fail ECI_RUNTIME_SYNC_SOURCE_UNSAFE "canonical provider home is not a regular directory: $source_root"
if [[ "$mode" == planner-* ]]; then
  # Planner maintenance has a local Codex publication that is useful on its
  # own. A nonexistent peer is not a target failure until a peer operation is
  # actually attempted; an existing wrong-provider target remains concrete.
  target_root="$(realpath -e -- "$target_arg" 2>/dev/null || true)"
  if [ -n "$target_root" ] && [ -d "$target_root" ]; then
    [ "$target_root" != "$source_root" ] ||
      fail ECI_RUNTIME_SYNC_TARGET 'target resolves to the canonical provider home'
  else
    target_root=''
  fi
  planner_sync "$mode" "$source_root" "$target_root" "$owner_uid" "$HOME/tmp/eci-runtime" codex
  exit 0
fi
case "$target_arg" in
  /*) ;;
  *) fail ECI_RUNTIME_SYNC_TARGET 'target must be an absolute provider-home path' ;;
esac
# Declared provider targets may be mounted or symlinked. Resolve the actual
# directory and validate its provider basename below; the caller's spelling
# is diagnostic only.
target_root="$(realpath -e -- "$target_arg" 2>/dev/null || true)"
[ -n "$target_root" ] && [ -d "$target_root" ] ||
  fail ECI_RUNTIME_SYNC_TARGET 'target provider home is unavailable'
[ "$target_root" != "$source_root" ] || fail ECI_RUNTIME_SYNC_TARGET 'target resolves to the canonical provider home'
case "$mode" in
  peer-check|peer-apply)
    [ "$provider" = .codex ] ||
      fail ECI_RUNTIME_SYNC_PROVIDER "peer synchronization must run from the canonical Codex home: $source_root"
    [ "${target_root##*/}" = .kimi-code ] ||
      fail ECI_RUNTIME_SYNC_PROVIDER "peer synchronization target basename must be .kimi-code: $target_root"
    ;;
  *)
    [ "${target_root##*/}" = "$provider" ] ||
      fail ECI_RUNTIME_SYNC_PROVIDER "target basename must be $provider: $target_root"
    ;;
esac
[ -d "$target_root" ] ||
  fail ECI_RUNTIME_SYNC_TARGET_UNSAFE "target provider home is not a regular directory: $target_root"

manifest=()
fixed_files=()
if [[ "$mode" != peer-* ]]; then
  case "$provider" in
    .codex) fixed_files=(CODEX.md config.toml hooks.json) ;;
    # Kimi has no Codex hooks.json/CODEX.md; its runtime configuration is the
    # provider-owned config.toml plus the shared hook/bin surface.
    .kimi-code) fixed_files=(config.toml) ;;
  esac
fi
for fixed in "${fixed_files[@]}"; do
  [ -f "$source_root/$fixed" ] && [ ! -L "$source_root/$fixed" ] ||
    fail ECI_RUNTIME_SYNC_SOURCE_MISSING "canonical managed file is unavailable: $source_root/$fixed"
  manifest+=("$fixed")
done
# Keep Go production sources so a deployed runtime can rebuild missing tools.
# Tests, bytecode caches, build staging, and editor backups are not runtime inputs.
while IFS= read -r -d '' source_path; do
  [ -f "$source_path" ] && [ ! -L "$source_path" ] ||
    fail ECI_RUNTIME_SYNC_SOURCE_UNSAFE "canonical managed path is not a regular file: $source_path"
  relative="${source_path#"$source_root/"}"
  if [[ "$mode" == peer-* ]]; then
    # Planner publication atomically installs this hard-linked binary and its
    # provenance receipt in both provider trees. Peer runtime sync must not
    # replace either artifact: maintain-planner remains the sole publication
    # authority.
    case "$relative" in
      hooks/lib/eci-command-plan-go/eci-command-plan|hooks/lib/eci-command-plan-go/"$PLANNER_RECEIPT_NAME")
        continue
        ;;
    esac
  fi
  manifest+=("$relative")
done < <(find "$source_root/hooks" "$source_root/bin" \
  \( -path "$source_root/hooks/tests" -o -path "$source_root/hooks/tests/*" \
     -o -type d -name '.eci-command-plan.txn.*' \
     -o -name '.eci-go-build.*' -o -name '.eci-go-build.lock' \
     -o -name '.eci-command-plan.lock' -o -name '.eci-command-plan.publish.lock' \
     -o -name '__pycache__' -o -name '*.pyc' -o -name '*_test.go' -o -name '*.bak*' \) -prune \
  -o -type f -print0 2>/dev/null | sort -z)
[ "${#manifest[@]}" -gt 3 ] || fail ECI_RUNTIME_SYNC_SOURCE_MISSING 'canonical hooks/bin surface is empty'

if [[ "$mode" == peer-* ]] && [ -L "$target_root/$PEER_RECEIPT_NAME" ]; then
  # The receipt is a managed target too. Do not replace a link whose resolved
  # destination is outside the declared provider home.
  fail ECI_RUNTIME_SYNC_TARGET_UNSAFE "peer receipt is a symlink: $target_root/$PEER_RECEIPT_NAME"
fi

path_parent_is_safe() {
  local path="$1" parent
  parent="${path%/*}"
  while [ "$parent" != "$target_root" ] && [ "$parent" != "/" ]; do
    [ ! -L "$parent" ] || return 1
    parent="${parent%/*}"
  done
  [ "$parent" = "$target_root" ]
}

drift=0
declare -A needs_sync=()
for relative in "${manifest[@]}"; do
  source_path="$source_root/$relative"
  target_path="$target_root/$relative"
  path_parent_is_safe "$target_path" ||
    fail ECI_RUNTIME_SYNC_TARGET_UNSAFE "managed target parent contains a symlink: $target_path"
  if [ -L "$target_path" ]; then
    # A managed leaf link is an ambiguous target even when `mv` would usually
    # replace it. Reject it before staging so publication cannot follow an
    # accidental link into another directory.
    fail ECI_RUNTIME_SYNC_TARGET_UNSAFE "managed target is a symlink: $target_path"
  fi
  if [ -e "$target_path" ]; then
    [ -f "$target_path" ] ||
      fail ECI_RUNTIME_SYNC_TARGET_UNSAFE "managed target is not a replaceable file: $target_path"
    source_hash="$(hash_file "$source_path")" || fail ECI_RUNTIME_SYNC_HASH "cannot hash source: $source_path"
    target_hash="$(hash_file "$target_path")" || fail ECI_RUNTIME_SYNC_HASH "cannot hash target: $target_path"
    source_mode="$(mode_of "$source_path")"
    target_mode="$(mode_of "$target_path")"
    if [ "$source_hash" = "$target_hash" ] && [ "$source_mode" = "$target_mode" ]; then
      printf 'OK\t%s\t%s\n' "$relative" "$source_hash"
      continue
    fi
    drift=1
    needs_sync["$relative"]=1
    printf 'DRIFT\t%s\tsource=%s\ttarget=%s\tmode=%s/%s\n' \
      "$relative" "$source_hash" "$target_hash" "$source_mode" "$target_mode"
  else
    drift=1
    needs_sync["$relative"]=1
    printf 'MISSING\t%s\n' "$relative"
  fi
done

case "$mode" in
  check|peer-check) exit "$drift" ;;
esac

lock_name="$provider"
if [[ "$mode" == peer-* ]]; then
  lock_name='codex-kimi-peer'
fi
lock_dir="$(mktemp -d "${HOME:?HOME must be set}/tmp/eci-runtime-sync-$lock_name.XXXXXX")" ||
  fail ECI_RUNTIME_SYNC_BUSY "could not create a temporary $lock_name synchronization workspace"
trap 'rmdir -- "$lock_dir" 2>/dev/null || true' EXIT HUP INT TERM

for relative in "${manifest[@]}"; do
  [ "${needs_sync[$relative]:-0}" = 1 ] || continue
  source_path="$source_root/$relative"
  target_path="$target_root/$relative"
  path_parent_is_safe "$target_path" ||
    fail ECI_RUNTIME_SYNC_TARGET_UNSAFE "managed target parent changed to a symlink: $target_path"
  [ ! -L "$target_path" ] ||
    fail ECI_RUNTIME_SYNC_TARGET_UNSAFE "managed target is a symlink: $target_path"
  target_parent="${target_path%/*}"
  mkdir -p -- "$target_parent"
  [ ! -L "$target_parent" ] || fail ECI_RUNTIME_SYNC_TARGET_UNSAFE "target parent is a symlink: $target_parent"
  target_tmp="$(mktemp -- "$target_path.eci-runtime-sync.XXXXXX")" ||
    fail ECI_RUNTIME_SYNC_WRITE "unable to stage a temporary target for $relative"
  cp -- "$source_path" "$target_tmp" || fail ECI_RUNTIME_SYNC_WRITE "unable to stage $relative"
  chmod -- "$(mode_of "$source_path")" "$target_tmp" || fail ECI_RUNTIME_SYNC_WRITE "unable to preserve mode for $relative"
  mv -- "$target_tmp" "$target_path" || fail ECI_RUNTIME_SYNC_WRITE "unable to publish $relative"
  source_hash="$(hash_file "$source_path")" || fail ECI_RUNTIME_SYNC_HASH "cannot hash published source: $source_path"
  target_hash="$(hash_file "$target_path")" || fail ECI_RUNTIME_SYNC_HASH "cannot hash published target: $target_path"
  [ "$source_hash" = "$target_hash" ] || fail ECI_RUNTIME_SYNC_VERIFY "published digest differs for $relative"
  printf 'SYNCED\t%s\t%s\n' "$relative" "$target_hash"
done

if [ "$mode" = peer-apply ]; then
  write_peer_receipt "$source_root" "$target_root"
fi

exit 0
