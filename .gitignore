# Ignore everything unless it is explicitly configuration/instruction/tooling.
*
!*/

# Tracked Codex configuration.
!.gitignore
!CODEX.md
!config.toml
!sol-high.config.toml
!hooks.json
!bin/**
!hooks/**
!proofs/**
!skills/**
!tools/**

# Sensitive or machine/session-local material.
worktrees/
auth.json
history.jsonl
installation_id
version.json
models_cache.json
memories/
*.env
*.key
*.pem
*.crt
*.p12
*.pfx
id_rsa
id_ed25519
*token*
*secret*
*credential*

# Volatile runtime state.
*.log
*.sqlite
*.sqlite-*
.eci-command-plan.publish.lock
log/
logs/
sessions/
shell_snapshots/
cache/
tmp/
.tmp/
state_*.sqlite*
logs_*.sqlite*

# Generated Python bytecode and Go runtime build outputs stay local.
__pycache__/
*.py[cod]
/bin/eci-command-gate-mode
eci-command-plan
eci-safe-import
/hooks/lib/eci-command-gate-mode-go/eci-command-gate-mode
/tools/forecast-target-trend-go/forecast-target-trend
*.test
.eci-go-build.*
.eci-go-build.lock
.eci-command-plan.provenance
.eci-command-plan.txn.*/
