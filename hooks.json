{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec \"${CODEX_HOME:-$HOME/.codex}/hooks/session-snapshot.sh\"'",
            "statusMessage": "Loading Codex session rules"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec \"${CODEX_HOME:-$HOME/.codex}/hooks/eci-post-compact-refresh.sh\"'",
            "statusMessage": "Refreshing ECI rules after compaction"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec \"${CODEX_HOME:-$HOME/.codex}/hooks/prompt-task-reminder.sh\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_HOME:-$HOME/.codex}/hooks/validate-bash.sh\"",
            "timeout": 75,
            "statusMessage": "Checking shell command"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_HOME:-$HOME/.codex}/hooks/pretooluse-edit-dispatch.sh\"",
            "statusMessage": "Checking edit gates"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_HOME:-$HOME/.codex}/hooks/pretooluse-edit-dispatch.sh\"",
            "statusMessage": "Checking edit gates"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec \"${CODEX_HOME:-$HOME/.codex}/hooks/stop-gate.sh\"'",
            "timeout": 300,
            "statusMessage": "Checking stop criteria"
          }
        ]
      }
    ]
  }
}
